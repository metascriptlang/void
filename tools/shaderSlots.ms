// Prints the C side of a Void-emitted GLSL file: each uniform block as the struct sokol-shdc's
// `-f sokol` header declared (`<block>_t`, members in order, std140 offsets), and the UB_, VIEW_
// and SMP_ slot constants under the names shdc gave them, so a C consumer needs no sokol_gfx.h.
// Usage: msc run tools/shaderSlots.ms -- <emitted.glsl> <include guard>

import { readFile } from "std/fs";
import { argv, exit } from "std/process";

function fail(message: string): never {
	console.error("shaderSlots: " + message);
	exit(1);
}

// shdc's block member types (src/shader/CLAUDE.md): the C spelling, the std140 alignment, the
// size, and the array stride when it may be an array.
struct MemberType { c: string; columns: int32; align: int32; size: int32; stride: int32; }

function memberType(glslType: string): MemberType {
	if (glslType == "float") { return { c: "float", columns: 1, align: 4, size: 4, stride: 0 }; }
	if (glslType == "vec2") { return { c: "float", columns: 2, align: 8, size: 8, stride: 0 }; }
	if (glslType == "vec3") { return { c: "float", columns: 3, align: 16, size: 12, stride: 0 }; }
	if (glslType == "vec4") { return { c: "float", columns: 4, align: 16, size: 16, stride: 16 }; }
	if (glslType == "int") { return { c: "int32_t", columns: 1, align: 4, size: 4, stride: 0 }; }
	if (glslType == "ivec2") { return { c: "int32_t", columns: 2, align: 8, size: 8, stride: 0 }; }
	if (glslType == "ivec3") { return { c: "int32_t", columns: 3, align: 16, size: 12, stride: 0 }; }
	if (glslType == "ivec4") { return { c: "int32_t", columns: 4, align: 16, size: 16, stride: 16 }; }
	if (glslType == "mat4") { return { c: "float", columns: 16, align: 16, size: 64, stride: 64 }; }
	fail("uniform block member type '" + glslType + "' is not one sokol-shdc takes");
}

function bindingOf(line: string): string {
	const open = line.indexOf("binding=");
	const close = line.indexOf(")", open);
	if (open < 0 || close < 0) { fail("no binding in '" + line + "'"); }
	return line.slice(open + 8, close);
}

function lastWord(text: string): string {
	const words = text.trim().replaceAll(";", "").replaceAll("{", "").trim().split(" ");
	return words[words.length - 1];
}

function main(): void {
	if (argv.length < 3) { fail("usage: shaderSlots <emitted.glsl> <include guard>"); }
	const text = readFile(argv[argv.length - 2]);
	if (!text.ok) { fail("cannot read " + argv[argv.length - 2]); }
	const guard = argv[argv.length - 1];
	const lines = text.value.replaceAll("\r", "").split("\n");
	const slots: Map<string, string> = new Map();
	const structs: string[] = [];
	for (let i = 0; i < lines.length; i++) {
		const line = lines[i].trim();
		if (!line.startsWith("layout(binding=") || line.indexOf(" uniform ") < 0) { continue; }
		const binding = bindingOf(line);
		if (line.indexOf(" uniform texture") >= 0) { slots.set("VIEW_" + lastWord(line), binding); continue; }
		if (line.indexOf(" uniform sampler") >= 0) { slots.set("SMP_" + lastWord(line), binding); continue; }
		if (!line.endsWith("{")) { fail("uniform declaration '" + line + "' is not a block, a texture or a sampler"); }
		const block = lastWord(line);
		let body = "#pragma pack(push,1)\ntypedef struct __attribute__((aligned(16))) " + block + "_t {\n";
		let offset = 0;
		i++;
		while (i < lines.length && lines[i].trim() != "};") {
			const member = lines[i].trim().replaceAll(";", "").split(" ");
			if (member.length != 2) { fail("block " + block + " member '" + lines[i].trim() + "' is not '<type> <name>'"); }
			const kind = memberType(member[0]);
			let name = member[1];
			let count = 0;
			const bracket = name.indexOf("[");
			if (bracket >= 0) {
				count = Number(name.slice(bracket + 1, name.length - 1)) as int32;
				name = name.slice(0, bracket);
				if (kind.stride == 0) { fail("block " + block + " member " + name + ": sokol-shdc takes arrays of vec4, ivec4 and mat4 only"); }
			}
			if (offset % kind.align != 0) {
				fail("block " + block + " member " + name + " sits at byte " + String(offset) +
					", which std140 pads to a multiple of " + String(kind.align) + "; reorder the block");
			}
			body += "    " + kind.c + " " + name + (count > 0 ? "[" + String(count) + "]" : "") +
				(kind.columns > 1 ? "[" + String(kind.columns) + "]" : "") + ";\n";
			offset += count > 0 ? count * kind.stride : kind.size;
			i++;
		}
		if (i >= lines.length) { fail("block " + block + " has no closing '};'"); }
		if (offset % 16 != 0) { body += "    uint8_t _pad_" + String(offset) + "[" + String(16 - offset % 16) + "];\n"; }
		body += "} " + block + "_t;\n#pragma pack(pop)\n";
		structs.push(body);
		slots.set("UB_" + block, binding);
	}
	if (structs.length == 0) { fail("no uniform block in " + argv[argv.length - 2]); }
	let out = "// Generated by tools/shaderSlots.ms from " + argv[argv.length - 2] + "; do not edit.\n" +
		"#ifndef " + guard + "\n#define " + guard + "\n\n#include <stdint.h>\n\n";
	for (const [name, binding] of slots) { out += "#define " + name + " (" + binding + ")\n"; }
	out += "\n" + structs.join("\n") + "\n#endif";
	console.log(out);
}

main();
