extern class Js {
	extern createVertexArray(): Js;
	extern bindVertexArray(vertexArray: Js): void;
	extern deleteVertexArray(vertexArray: Js): void;
	extern createBuffer(): Js;
	extern bindBuffer(target: number, buffer: Js): void;
	extern bufferData(target: number, size: number, usage: number): void;
	extern deleteBuffer(buffer: Js): void;
	extern copyBufferSubData(readTarget: number, writeTarget: number, readOffset: number, writeOffset: number, size: number): void;
	extern createTexture(): Js;
	extern activeTexture(unit: number): void;
	extern bindTexture(target: number, texture: Js): void;
	extern texStorage2D(target: number, levels: number, internalFormat: number, width: number, height: number): void;
	extern texStorage3D(target: number, levels: number, internalFormat: number, width: number, height: number, depth: number): void;
	extern texParameteri(target: number, name: number, value: number): void;
	extern deleteTexture(texture: Js): void;
	extern createRenderbuffer(): Js;
	extern bindRenderbuffer(target: number, renderbuffer: Js): void;
	extern renderbufferStorageMultisample(target: number, samples: number, internalFormat: number, width: number, height: number): void;
	extern deleteRenderbuffer(renderbuffer: Js): void;
	extern framebufferRenderbuffer(target: number, attachment: number, renderbufferTarget: number, renderbuffer: Js): void;
	extern texSubImage2D(target: number, level: number, x: number, y: number, width: number, height: number, format: number, type: number, offset: number): void;
	extern texSubImage3D(target: number, level: number, x: number, y: number, z: number, width: number, height: number, depth: number, format: number, type: number, offset: number): void;
	extern createSampler(): Js;
	extern samplerParameteri(sampler: Js, name: number, value: number): void;
	extern samplerParameterf(sampler: Js, name: number, value: number): void;
	extern bindSampler(unit: number, sampler: Js): void;
	extern deleteSampler(sampler: Js): void;
	extern createShader(stage: number): Js;
	extern shaderSource(shader: Js, source: string): void;
	extern compileShader(shader: Js): void;
	extern getShaderParameter(shader: Js, name: number): boolean;
	extern getShaderInfoLog(shader: Js): string;
	extern deleteShader(shader: Js): void;
	extern createProgram(): Js;
	extern attachShader(program: Js, shader: Js): void;
	extern linkProgram(program: Js): void;
	extern getProgramParameter(program: Js, name: number): boolean;
	extern getProgramInfoLog(program: Js): string;
	extern deleteProgram(program: Js): void;
	extern useProgram(program: Js): void;
	extern getUniformLocation(program: Js, name: string): Js;
	extern getAttribLocation(program: Js, name: string): int32;
	extern uniform1i(location: Js, value: number): void;
	extern depthFunc(compare: number): void;
	extern depthMask(write: boolean): void;
	extern depthRange(near: number, far: number): void;
	extern stencilMask(mask: number): void;
	extern stencilFunc(compare: number, reference: number, mask: number): void;
	extern stencilOp(fail: number, depthFail: number, pass: number): void;
	extern stencilFuncSeparate(face: number, compare: number, reference: number, mask: number): void;
	extern stencilOpSeparate(face: number, fail: number, depthFail: number, pass: number): void;
	extern blendFuncSeparate(sourceColor: number, destinationColor: number, sourceAlpha: number, destinationAlpha: number): void;
	extern blendEquationSeparate(color: number, alpha: number): void;
	extern blendColor(r: number, g: number, b: number, a: number): void;
	extern colorMask(r: boolean, g: boolean, b: boolean, a: boolean): void;
	extern polygonOffset(factor: number, units: number): void;
	extern cullFace(face: number): void;
	extern frontFace(winding: number): void;
	extern viewport(x: number, y: number, width: number, height: number): void;
	extern scissor(x: number, y: number, width: number, height: number): void;
	extern createFramebuffer(): Js;
	extern bindFramebuffer(target: number, framebuffer: Js): void;
	extern deleteFramebuffer(framebuffer: Js): void;
	extern framebufferTexture2D(target: number, attachment: number, textureTarget: number, texture: Js, level: number): void;
	extern framebufferTextureLayer(target: number, attachment: number, texture: Js, level: number, layer: number): void;
	extern checkFramebufferStatus(target: number): int32;
	extern drawBuffers(buffers: Js): void;
	extern readBuffer(attachment: number): void;
	extern blitFramebuffer(srcX0: number, srcY0: number, srcX1: number, srcY1: number, dstX0: number, dstY0: number, dstX1: number, dstY1: number, mask: number, filter: number): void;
	extern clearBufferfv(buffer: number, drawBuffer: number, value: Js): void;
	extern clearBufferiv(buffer: number, drawBuffer: number, value: Js): void;
	extern clearBufferfi(buffer: number, drawBuffer: number, depth: number, stencil: number): void;
	extern vertexAttribPointer(index: number, size: number, type: number, normalized: boolean, stride: number, offset: number): void;
	extern vertexAttribIPointer(index: number, size: number, type: number, stride: number, offset: number): void;
	extern vertexAttribDivisor(index: number, divisor: number): void;
	extern enableVertexAttribArray(index: number): void;
	extern disableVertexAttribArray(index: number): void;
	extern drawArrays(mode: number, first: number, count: number): void;
	extern drawArraysInstanced(mode: number, first: number, count: number, instances: number): void;
	extern drawElements(mode: number, count: number, type: number, offset: number): void;
	extern drawElementsInstanced(mode: number, count: number, type: number, offset: number, instances: number): void;
	extern createQuery(): Js;
	extern deleteQuery(query: Js): void;
	extern beginQuery(target: number, query: Js): void;
	extern endQuery(target: number): void;
	extern getQueryParameter(query: Js, name: number): Js;
	extern getError(): int32;
	extern enable(capability: number): void;
	extern disable(capability: number): void;
	extern pixelStorei(name: number, value: number): void;
	extern getExtension(name: string): Js;
	extern readPixels(x: number, y: number, width: number, height: number, format: number, type: number, offset: number): void;
	extern copyTexSubImage2D(target: number, level: number, xOffset: number, yOffset: number, x: number, y: number, width: number, height: number): void;
	extern copyTexSubImage3D(target: number, level: number, xOffset: number, yOffset: number, zOffset: number, x: number, y: number, width: number, height: number): void;
}

extern function canvasOf(selector: string): Js from "document.querySelector(#)";
extern function contextOf(canvas: Js, antialias: boolean): Js from "#.getContext('webgl2',{alpha:true,depth:true,stencil:false,antialias:#,premultipliedAlpha:true,preserveDrawingBuffer:false})";
extern function watchContext(canvas: Js, onRestored: () => void): void from "((c,h)=>{c.addEventListener('webglcontextlost',(e)=>e.preventDefault());c.addEventListener('webglcontextrestored',()=>h());})(#,#)";
extern function enableExtensions(context: Js): void from "((g)=>{for(const n of ['EXT_color_buffer_float','EXT_color_buffer_half_float','EXT_float_blend','EXT_texture_norm16','OES_texture_float_linear','EXT_texture_filter_anisotropic','EXT_texture_compression_bptc','EXT_texture_compression_rgtc','WEBGL_compressed_texture_astc','WEBGL_compressed_texture_etc','WEBGL_compressed_texture_etc1','WEBGL_compressed_texture_s3tc','WEBGL_compressed_texture_s3tc_srgb'])g.getExtension(n);})(#)";
extern function isNone(value: Js): boolean from "(# == null)";
extern function jsNull(): Js from "(null)";
extern function jsList(): Js from "([])";
extern function emptyTable(): Js from "([null])";
extern function register(table: Js, object: Js): uint32 from "((t,o)=>{t.push(o);return t.length-1;})(#,#)";
extern function lookup(table: Js, id: int32): Js from "#[#]";
extern function release(table: Js, id: uint32): void from "((t,i)=>{t[i]=null;})(#,#)";
extern function idOf(table: Js, object: Js): int32 from "#.indexOf(#)";
extern function floats(a: float64, b: float64, c: float64, d: float64): Js from "new Float32Array([#,#,#,#])";
extern function integers(a: int32): Js from "new Int32Array([#])";
extern function drawTargets(count: int32, colorMask: int32): Js from "((n,m)=>{const a=[];for(let i=0;i<n;i++)a.push((m&(1<<i))?0x8CE0+i:0);return a;})(#,#)";
extern function parameter(context: Js, name: int32): int32 from "((g,n)=>{if(n===0x821B)return 3;if(n===0x821C)return 0;const v=g.getParameter(n);return typeof v==='number'?v|0:0;})(#,#)";
extern function parameterBig(context: Js, name: int32): int64 from "BigInt(Math.trunc(#.getParameter(#)))";
extern function boundObject(context: Js, table: Js, name: int32): int32 from "#.indexOf(#.getParameter(#))";
extern function parameterObject(context: Js, name: int32): Js from "#.getParameter(#)";
extern function queryNumber(value: Js): uint64 from "BigInt(#)";
extern function num(value: int64): number from "Number(#)";
extern function queryFlag(value: Js): boolean from "(#===true)";
extern function nativeHandle(handle: Js): Ptr<void> from "#";

const GL_NONE = 0;
const GL_TEXTURE0 = 0x84C0;
const GL_TEXTURE_2D = 0x0DE1;
const GL_TEXTURE_3D = 0x806F;
const GL_TEXTURE_2D_ARRAY = 0x8C1A;
const GL_TEXTURE_CUBE_MAP = 0x8513;
const GL_TEXTURE_CUBE_MAP_POSITIVE_X = 0x8515;
const GL_RENDERBUFFER = 0x8D41;
const GL_FRAMEBUFFER = 0x8D40;
const GL_READ_FRAMEBUFFER = 0x8CA8;
const GL_READ_FRAMEBUFFER_BINDING = 0x8CAA;
const GL_FRAMEBUFFER_COMPLETE = 0x8CD5;
const GL_COLOR_ATTACHMENT0 = 0x8CE0;
const GL_DEPTH_ATTACHMENT = 0x8D00;
const GL_COLOR = 0x1800;
const GL_DEPTH = 0x1801;
const GL_STENCIL = 0x1802;
const GL_DEPTH_STENCIL = 0x84F9;
const GL_DEPTH_COMPONENT = 0x1902;
const GL_COLOR_BUFFER_BIT = 0x4000;
const GL_NEAREST = 0x2600;
const GL_BACK = 0x0405;
const GL_COPY_READ_BUFFER = 0x8F36;
const GL_COPY_WRITE_BUFFER = 0x8F37;
const GL_PIXEL_PACK_BUFFER = 0x88EB;
const GL_PIXEL_UNPACK_BUFFER = 0x88EC;
const GL_PACK_ROW_LENGTH = 0x0D02;
const GL_PACK_ALIGNMENT = 0x0D05;
const GL_COMPILE_STATUS = 0x8B81;
const GL_LINK_STATUS = 0x8B82;
const GL_QUERY_RESULT = 0x8866;
const GL_QUERY_RESULT_AVAILABLE = 0x8867;
const GL_CURRENT_PROGRAM = 0x8B8D;
const GL_NO_ERROR = 0;

const NONE: Js = jsNull();

let context: Js = NONE;
let objects: Js = emptyTable();
let locations: Js = jsList();
let log = "";

function stop(message: string): never { throw new Error(`webgpu gl js: ${message}`); }

function unavailable(what: string): never {
	return stop(`${what} is not built into this GL target; the backend checks oglCapabilities before it calls`);
}

function parked(what: string): never {
	return stop(`${what} takes the address of an array element as a pointer, which --target=js cannot pass (~/metascript/.inbox/compiler/2026-10-27-js-element-address-as-pointer-argument.md)`);
}

function handle(id: uint32): Js { return lookup(objects, id as int32); }

export function acquireContext(canvasSelector: string, sampleCount: int32, onLost: () => void): void {
	const canvas = canvasOf(canvasSelector);
	if (isNone(canvas)) { stop(`the selector '${canvasSelector}' matches no canvas`); }
	const opened = contextOf(canvas, sampleCount > 1);
	if (isNone(opened)) { stop("canvas.getContext('webgl2') gave no context: this browser has no WebGL2"); }
	context = opened;
	objects = emptyTable();
	enableExtensions(opened);
	watchContext(canvas, (): void => {
		objects = emptyTable();
		enableExtensions(opened);
		onLost();
	});
}

export function oglLoad(): int32 { return isNone(context) ? 0 : 1; }
export function oglLoadMissing(): string { return "the WebGL2 context that acquireContext opens"; }
export function oglUnload(): void {}
export function oglCapabilities(): int32 { return 0; }

export function oglGetInteger(name: int32): int32 {
	if (name == GL_CURRENT_PROGRAM) { return boundObject(context, objects, name); }
	return parameter(context, name);
}

export function oglGetInteger64(name: int32): int64 { return parameterBig(context, name); }
export function oglGetIntegeri(name: int32, index: int32): int32 { return unavailable("glGetIntegeri_v"); }
export function oglGetError(): int32 { return context.getError(); }
export function oglEnable(capability: int32): void { context.enable(capability); }
export function oglDisable(capability: int32): void { context.disable(capability); }
export function oglPixelStore(name: int32, value: int32): void { context.pixelStorei(name, value); }
export function oglHasExtension(name: string): int32 { return isNone(context.getExtension(name)) ? 0 : 1; }
export function oglTextureNative(texture: uint32): Ptr<void> { return nativeHandle(handle(texture)); }

export function oglConstantsDisagreement(values: Borrow<int32>, count: int32): string { return parked("oglConstantsDisagreement"); }
export function oglCopyBytes<D, S>(destination: Borrow<D>, destinationOffset: int64, source: Borrow<S>, bytes: int64): void { parked("oglCopyBytes"); }
export function oglBufferSubData<T>(target: int32, offset: int64, data: Borrow<T>, bytes: int64): void { parked("oglBufferSubData"); }
export function oglGetBufferDataUncached<T>(buffer: uint32, offset: int64, destination: Borrow<T>, bytes: int64): int32 { return parked("oglGetBufferDataUncached"); }
export function oglUniform4fv<T>(location: int32, count: int32, data: Borrow<T>, offset: int64): void { parked("oglUniform4fv"); }
export function oglTexSubImage<T>(
	target: int32,
	level: int32,
	x: int32,
	y: int32,
	z: int32,
	width: int32,
	height: int32,
	depth: int32,
	format: int32,
	type: int32,
	data: Borrow<T>,
	offset: int64,
): void { parked("oglTexSubImage"); }

export function oglCreateVertexArray(): uint32 { return register(objects, context.createVertexArray()); }
export function oglBindVertexArray(vertexArray: uint32): void { context.bindVertexArray(handle(vertexArray)); }

export function oglDeleteVertexArray(vertexArray: uint32): void {
	if (vertexArray == 0) { return; }
	context.deleteVertexArray(handle(vertexArray));
	release(objects, vertexArray);
}

export function oglCreateBuffer(): uint32 { return register(objects, context.createBuffer()); }
export function oglBindBuffer(target: int32, buffer: uint32): void { context.bindBuffer(target, handle(buffer)); }
export function oglBufferData(target: int32, bytes: int64, usage: int32): void { context.bufferData(target, num(bytes), usage); }

export function oglDeleteBuffer(buffer: uint32): void {
	if (buffer == 0) { return; }
	context.deleteBuffer(handle(buffer));
	release(objects, buffer);
}

export function oglCopyBufferDataUncached(source: uint32, sourceOffset: int64, destination: uint32, destinationOffset: int64, bytes: int64): void {
	context.bindBuffer(GL_COPY_READ_BUFFER, handle(source));
	context.bindBuffer(GL_COPY_WRITE_BUFFER, handle(destination));
	context.copyBufferSubData(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, num(sourceOffset), num(destinationOffset), num(bytes));
	context.bindBuffer(GL_COPY_READ_BUFFER, NONE);
	context.bindBuffer(GL_COPY_WRITE_BUFFER, NONE);
}

export function oglCreateTexture(): uint32 { return register(objects, context.createTexture()); }
export function oglActiveTexture(unit: int32): void { context.activeTexture(GL_TEXTURE0 + unit); }
export function oglBindTexture(target: int32, texture: uint32): void { context.bindTexture(target, handle(texture)); }

export function oglTexStorage(target: int32, levels: int32, internalFormat: int32, width: int32, height: int32, depth: int32): void {
	if (target == GL_TEXTURE_3D || target == GL_TEXTURE_2D_ARRAY) {
		context.texStorage3D(target, levels, internalFormat, width, height, depth);
	} else {
		context.texStorage2D(target, levels, internalFormat, width, height);
	}
}

export function oglTexParameteri(target: int32, name: int32, value: int32): void { context.texParameteri(target, name, value); }

export function oglDeleteTexture(texture: uint32): void {
	if (texture == 0) { return; }
	context.deleteTexture(handle(texture));
	release(objects, texture);
}

export function oglCreateRenderbufferUncached(samples: int32, internalFormat: int32, width: int32, height: int32): uint32 {
	const renderbuffer = context.createRenderbuffer();
	context.bindRenderbuffer(GL_RENDERBUFFER, renderbuffer);
	context.renderbufferStorageMultisample(GL_RENDERBUFFER, samples, internalFormat, width, height);
	context.bindRenderbuffer(GL_RENDERBUFFER, NONE);
	return register(objects, renderbuffer);
}

export function oglDeleteRenderbuffer(renderbuffer: uint32): void {
	if (renderbuffer == 0) { return; }
	context.deleteRenderbuffer(handle(renderbuffer));
	release(objects, renderbuffer);
}

export function oglFramebufferRenderbuffer(attachment: int32, renderbuffer: uint32): void {
	context.framebufferRenderbuffer(GL_FRAMEBUFFER, attachment, GL_RENDERBUFFER, handle(renderbuffer));
}

function texSubImageAt(target: int32, level: int32, x: int32, y: int32, z: int32, width: int32, height: int32, depth: int32, format: int32, type: int32, offset: int64): void {
	if (target == GL_TEXTURE_3D || target == GL_TEXTURE_2D_ARRAY) {
		context.texSubImage3D(target, level, x, y, z, width, height, depth, format, type, num(offset));
	} else {
		context.texSubImage2D(target, level, x, y, width, height, format, type, num(offset));
	}
}

export function oglTexSubImageFromBufferUncached(
	target: int32,
	level: int32,
	x: int32,
	y: int32,
	z: int32,
	width: int32,
	height: int32,
	depth: int32,
	format: int32,
	type: int32,
	buffer: uint32,
	offset: int64,
): void {
	context.bindBuffer(GL_PIXEL_UNPACK_BUFFER, handle(buffer));
	texSubImageAt(target, level, x, y, z, width, height, depth, format, type, offset);
	context.bindBuffer(GL_PIXEL_UNPACK_BUFFER, NONE);
}

export function oglCreateSampler(): uint32 { return register(objects, context.createSampler()); }
export function oglSamplerParameteri(sampler: uint32, name: int32, value: int32): void { context.samplerParameteri(handle(sampler), name, value); }
export function oglSamplerParameterf(sampler: uint32, name: int32, value: float64): void { context.samplerParameterf(handle(sampler), name, value); }
export function oglBindSampler(unit: int32, sampler: uint32): void { context.bindSampler(unit, handle(sampler)); }

export function oglDeleteSampler(sampler: uint32): void {
	if (sampler == 0) { return; }
	context.deleteSampler(handle(sampler));
	release(objects, sampler);
}

export function oglCompileShader(stage: int32, source: string): uint32 {
	log = "";
	const shader = context.createShader(stage);
	context.shaderSource(shader, source);
	context.compileShader(shader);
	if (!context.getShaderParameter(shader, GL_COMPILE_STATUS)) {
		log = context.getShaderInfoLog(shader);
		context.deleteShader(shader);
		return 0;
	}
	return register(objects, shader);
}

export function oglLinkProgram(vertexShader: uint32, fragmentShader: uint32): uint32 {
	log = "";
	const program = context.createProgram();
	context.attachShader(program, handle(vertexShader));
	context.attachShader(program, handle(fragmentShader));
	context.linkProgram(program);
	context.deleteShader(handle(vertexShader));
	context.deleteShader(handle(fragmentShader));
	release(objects, vertexShader);
	release(objects, fragmentShader);
	if (!context.getProgramParameter(program, GL_LINK_STATUS)) {
		log = context.getProgramInfoLog(program);
		context.deleteProgram(program);
		return 0;
	}
	return register(objects, program);
}

export function oglLinkComputeProgram(computeShader: uint32): uint32 { return unavailable("compute shaders"); }
export function oglLog(): string { return log; }

export function oglDeleteProgram(program: uint32): void {
	if (program == 0) { return; }
	context.deleteProgram(handle(program));
	release(objects, program);
}

export function oglUseProgram(program: uint32): void { context.useProgram(handle(program)); }

export function oglUniformLocation(program: uint32, name: string): int32 {
	const location = context.getUniformLocation(handle(program), name);
	return isNone(location) ? -1 : (register(locations, location) as int32);
}

export function oglAttribLocation(program: uint32, name: string): int32 { return context.getAttribLocation(handle(program), name); }
export function oglUniform1i(location: int32, value: int32): void { context.uniform1i(lookup(locations, location), value); }

export function oglDepthFunc(compare: int32): void { context.depthFunc(compare); }
export function oglDepthMask(write: int32): void { context.depthMask(write != 0); }
export function oglStencilMask(mask: int32): void { context.stencilMask(mask); }
export function oglStencilFunc(compare: int32, reference: int32, mask: int32): void { context.stencilFunc(compare, reference, mask); }
export function oglStencilOp(fail: int32, depthFail: int32, pass: int32): void { context.stencilOp(fail, depthFail, pass); }

export function oglStencilFuncSeparate(face: int32, compare: int32, reference: int32, mask: int32): void {
	context.stencilFuncSeparate(face, compare, reference, mask);
}

export function oglStencilOpSeparate(face: int32, fail: int32, depthFail: int32, pass: int32): void {
	context.stencilOpSeparate(face, fail, depthFail, pass);
}

export function oglDepthRange(nearDepth: float64, farDepth: float64): void { context.depthRange(nearDepth, farDepth); }

export function oglBlendFuncSeparate(sourceColor: int32, destinationColor: int32, sourceAlpha: int32, destinationAlpha: int32): void {
	context.blendFuncSeparate(sourceColor, destinationColor, sourceAlpha, destinationAlpha);
}

export function oglBlendEquationSeparate(color: int32, alpha: int32): void { context.blendEquationSeparate(color, alpha); }
export function oglBlendColor(r: float64, g: float64, b: float64, a: float64): void { context.blendColor(r, g, b, a); }

export function oglColorMask(mask: int32): void {
	context.colorMask((mask & 1) != 0, (mask & 2) != 0, (mask & 4) != 0, (mask & 8) != 0);
}

export function oglPolygonOffset(factor: float64, units: float64): void { context.polygonOffset(factor, units); }
export function oglCullFace(face: int32): void { context.cullFace(face); }
export function oglFrontFace(winding: int32): void { context.frontFace(winding); }
export function oglViewport(x: int32, y: int32, width: int32, height: int32): void { context.viewport(x, y, width, height); }
export function oglScissor(x: int32, y: int32, width: int32, height: int32): void { context.scissor(x, y, width, height); }

export function oglCreateFramebuffer(): uint32 { return register(objects, context.createFramebuffer()); }
export function oglBindFramebuffer(target: int32, framebuffer: uint32): void { context.bindFramebuffer(target, handle(framebuffer)); }

export function oglDeleteFramebuffer(framebuffer: uint32): void {
	if (framebuffer == 0) { return; }
	context.deleteFramebuffer(handle(framebuffer));
	release(objects, framebuffer);
}

export function oglFramebufferTexture2D(attachment: int32, textureTarget: int32, texture: uint32, level: int32): void {
	context.framebufferTexture2D(GL_FRAMEBUFFER, attachment, textureTarget, handle(texture), level);
}

export function oglFramebufferTextureLayer(attachment: int32, texture: uint32, level: int32, layer: int32): void {
	context.framebufferTextureLayer(GL_FRAMEBUFFER, attachment, handle(texture), level, layer);
}

export function oglFramebufferDetach(attachment: int32): void {
	context.framebufferRenderbuffer(GL_FRAMEBUFFER, attachment, GL_RENDERBUFFER, NONE);
	context.framebufferTexture2D(GL_FRAMEBUFFER, attachment, GL_TEXTURE_2D, NONE, 0);
}

export function oglCheckFramebufferStatus(): int32 { return context.checkFramebufferStatus(GL_FRAMEBUFFER); }
export function oglDrawBuffers(count: int32, colorMask: int32): void { context.drawBuffers(drawTargets(count > 8 ? 8 : count, colorMask)); }
export function oglReadBuffer(attachment: int32): void { context.readBuffer(attachment); }

function attachTexel(texture: uint32, target: int32, level: int32, layer: int32, attachment: int32): void {
	if (target == GL_TEXTURE_2D) {
		context.framebufferTexture2D(GL_READ_FRAMEBUFFER, attachment, GL_TEXTURE_2D, handle(texture), level);
	} else if (target == GL_TEXTURE_CUBE_MAP) {
		context.framebufferTexture2D(GL_READ_FRAMEBUFFER, attachment, GL_TEXTURE_CUBE_MAP_POSITIVE_X + layer, handle(texture), level);
	} else {
		context.framebufferTextureLayer(GL_READ_FRAMEBUFFER, attachment, handle(texture), level, layer);
	}
}

function beginTexelRead(readFramebuffer: uint32, texture: uint32, target: int32, level: int32, layer: int32, attachment: int32): Js {
	const previous = parameterObject(context, GL_READ_FRAMEBUFFER_BINDING);
	context.bindFramebuffer(GL_READ_FRAMEBUFFER, handle(readFramebuffer));
	attachTexel(texture, target, level, layer, attachment);
	context.readBuffer(attachment == GL_COLOR_ATTACHMENT0 ? GL_COLOR_ATTACHMENT0 : GL_NONE);
	return previous;
}

function endTexelRead(attachment: int32, previous: Js): void {
	context.framebufferTexture2D(GL_READ_FRAMEBUFFER, attachment, GL_TEXTURE_2D, NONE, 0);
	context.bindFramebuffer(GL_READ_FRAMEBUFFER, previous);
}

function clearErrors(): void {
	while (context.getError() != GL_NO_ERROR) {}
}

export function oglReadTexelsToBufferUncached(
	readFramebuffer: uint32,
	texture: uint32,
	target: int32,
	level: int32,
	layer: int32,
	x: int32,
	y: int32,
	width: int32,
	height: int32,
	format: int32,
	type: int32,
	rowLength: int32,
	buffer: uint32,
	offset: int64,
): int32 {
	const attachment = format == GL_DEPTH_COMPONENT ? GL_DEPTH_ATTACHMENT : GL_COLOR_ATTACHMENT0;
	const previous = beginTexelRead(readFramebuffer, texture, target, level, layer, attachment);
	let result = 1;
	if (context.checkFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
		result = 0;
	} else {
		context.pixelStorei(GL_PACK_ALIGNMENT, 1);
		context.pixelStorei(GL_PACK_ROW_LENGTH, rowLength);
		context.bindBuffer(GL_PIXEL_PACK_BUFFER, handle(buffer));
		clearErrors();
		context.readPixels(x, y, width, height, format, type, num(offset));
		if (context.getError() != GL_NO_ERROR) { result = -1; }
		context.bindBuffer(GL_PIXEL_PACK_BUFFER, NONE);
		context.pixelStorei(GL_PACK_ROW_LENGTH, 0);
		context.pixelStorei(GL_PACK_ALIGNMENT, 4);
	}
	endTexelRead(attachment, previous);
	return result;
}

export function oglReadScreenRectUncached(x: int32, y: int32, width: int32, height: int32, format: int32, type: int32, rowLength: int32, buffer: uint32, offset: int64): int32 {
	const previous = parameterObject(context, GL_READ_FRAMEBUFFER_BINDING);
	context.bindFramebuffer(GL_READ_FRAMEBUFFER, NONE);
	context.readBuffer(GL_BACK);
	context.pixelStorei(GL_PACK_ALIGNMENT, 1);
	context.pixelStorei(GL_PACK_ROW_LENGTH, rowLength);
	context.bindBuffer(GL_PIXEL_PACK_BUFFER, handle(buffer));
	clearErrors();
	context.readPixels(x, y, width, height, format, type, num(offset));
	const result = context.getError() == GL_NO_ERROR ? 1 : 0;
	context.bindBuffer(GL_PIXEL_PACK_BUFFER, NONE);
	context.pixelStorei(GL_PACK_ROW_LENGTH, 0);
	context.pixelStorei(GL_PACK_ALIGNMENT, 4);
	context.bindFramebuffer(GL_READ_FRAMEBUFFER, previous);
	return result;
}

export function oglCopyTexels(
	readFramebuffer: uint32,
	source: uint32,
	sourceTarget: int32,
	sourceLevel: int32,
	sourceLayer: int32,
	sourceX: int32,
	sourceY: int32,
	destinationTarget: int32,
	destinationLevel: int32,
	destinationX: int32,
	destinationY: int32,
	destinationLayer: int32,
	width: int32,
	height: int32,
	count: int32,
): int32 {
	const previous = beginTexelRead(readFramebuffer, source, sourceTarget, sourceLevel, sourceLayer, GL_COLOR_ATTACHMENT0);
	let result = 1;
	if (context.checkFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
		result = 0;
	} else {
		clearErrors();
		for (let i = 0; i < count && result == 1; i++) {
			if (i > 0) { attachTexel(source, sourceTarget, sourceLevel, sourceLayer + i, GL_COLOR_ATTACHMENT0); }
			if (destinationTarget == GL_TEXTURE_2D) {
				context.copyTexSubImage2D(GL_TEXTURE_2D, destinationLevel, destinationX, destinationY, sourceX, sourceY, width, height);
			} else if (destinationTarget == GL_TEXTURE_CUBE_MAP) {
				context.copyTexSubImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_X + destinationLayer + i, destinationLevel, destinationX, destinationY, sourceX, sourceY, width, height);
			} else {
				context.copyTexSubImage3D(destinationTarget, destinationLevel, destinationX, destinationY, destinationLayer + i, sourceX, sourceY, width, height);
			}
			if (context.getError() != GL_NO_ERROR) { result = -1; }
		}
	}
	endTexelRead(GL_COLOR_ATTACHMENT0, previous);
	return result;
}

export function oglBlitColor(width: int32, height: int32): void {
	context.blitFramebuffer(0, 0, width, height, 0, 0, width, height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
}

export function oglClearColor(attachment: int32, r: float64, g: float64, b: float64, a: float64): void {
	context.clearBufferfv(GL_COLOR, attachment, floats(r, g, b, a));
}

export function oglClearDepth(depth: float64): void { context.clearBufferfv(GL_DEPTH, 0, floats(depth, 0, 0, 0)); }
export function oglClearDepthStencil(depth: float64, stencil: int32): void { context.clearBufferfi(GL_DEPTH_STENCIL, 0, depth, stencil); }
export function oglClearStencil(stencil: int32): void { context.clearBufferiv(GL_STENCIL, 0, integers(stencil)); }

export function oglVertexAttribPointer(index: int32, size: int32, type: int32, normalized: int32, stride: int32, offset: int64): void {
	context.vertexAttribPointer(index, size, type, normalized != 0, stride, num(offset));
}

export function oglVertexAttribIPointer(index: int32, size: int32, type: int32, stride: int32, offset: int64): void {
	context.vertexAttribIPointer(index, size, type, stride, num(offset));
}

export function oglVertexAttribDivisor(index: int32, divisor: int32): void { context.vertexAttribDivisor(index, divisor); }
export function oglEnableVertexAttribArray(index: int32): void { context.enableVertexAttribArray(index); }
export function oglDisableVertexAttribArray(index: int32): void { context.disableVertexAttribArray(index); }

export function oglDrawArrays(mode: int32, first: int32, count: int32): void { context.drawArrays(mode, first, count); }

export function oglDrawArraysInstanced(mode: int32, first: int32, count: int32, instances: int32): void {
	context.drawArraysInstanced(mode, first, count, instances);
}

export function oglDrawElements(mode: int32, count: int32, type: int32, offset: int64): void {
	context.drawElements(mode, count, type, num(offset));
}

export function oglDrawElementsInstanced(mode: int32, count: int32, type: int32, offset: int64, instances: int32): void {
	context.drawElementsInstanced(mode, count, type, num(offset), instances);
}

export function oglDispatchCompute(x: int32, y: int32, z: int32): void { unavailable("glDispatchCompute"); }
export function oglDispatchComputeIndirectUncached(buffer: uint32, offset: int64): void { unavailable("glDispatchComputeIndirect"); }
export function oglMemoryBarrier(barriers: int32): void { unavailable("glMemoryBarrier"); }
export function oglBindBufferRange(target: int32, index: uint32, buffer: uint32, offset: int64, bytes: int64): void { unavailable("glBindBufferRange"); }

export function oglBindImageTexture(unit: int32, texture: uint32, level: int32, layered: int32, layer: int32, access: int32, format: int32): void {
	unavailable("glBindImageTexture");
}

export function oglCreateQuery(): uint32 { return register(objects, context.createQuery()); }

export function oglDeleteQuery(query: uint32): void {
	if (query == 0) { return; }
	context.deleteQuery(handle(query));
	release(objects, query);
}

export function oglBeginQuery(target: int32, query: uint32): void { context.beginQuery(target, handle(query)); }
export function oglEndQuery(target: int32): void { context.endQuery(target); }
export function oglQueryAvailable(query: uint32): int32 { return queryFlag(context.getQueryParameter(handle(query), GL_QUERY_RESULT_AVAILABLE)) ? 1 : 0; }
export function oglQueryResult(query: uint32): uint64 { return queryNumber(context.getQueryParameter(handle(query), GL_QUERY_RESULT)); }
export function oglQueryCounter(query: uint32): void { unavailable("glQueryCounter"); }
export function oglQueryCounterBits(): int32 { return unavailable("glGetQueryiv(GL_TIMESTAMP)"); }

export function oglPushDebugGroup(label: string): void { unavailable("glPushDebugGroup"); }
export function oglPopDebugGroup(): void { unavailable("glPopDebugGroup"); }
export function oglDebugMarker(label: string): void { unavailable("glDebugMessageInsert"); }
export function oglObjectLabel(identifier: int32, name: uint32, label: string): void { unavailable("glObjectLabel"); }
