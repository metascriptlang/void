			fragmentCode: "diagnostic(off, derivative_uniformity);\n\nstruct PbrMaterialParams {\n  material : vec4f,\n  pbr : vec4f,\n  uvMatrix : vec4f,\n  uvMotion : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  pointLight : array<vec4f, 4>,\n  pointColor : array<vec4f, 4>,\n  shapeA : array<vec4f, 4>,\n  shapeB : array<vec4f, 4>,\n  shapeC : array<vec4f, 4>,\n  shapeD : array<vec4f, 4>,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nstruct ShadowParams {\n  shadowMatrix : mat4x4f,\n  shadow : vec4f,\n  spotMatrix : mat4x4f,\n  spotShadow : vec4f,\n}\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> pbrMaterialParams : PbrMaterialParams;\n\n@binding(5) @group(0) var<uniform> shadowParams : ShadowParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(4) @group(1) var shadowMap : texture_2d<f32>;\n\n@binding(5) @group(1) var normalTexture : texture_2d<f32>;\n\n@binding(6) @group(1) var spotShadowMap : texture_2d<f32>;\n\n@binding(7) @group(1) var envDiffuse : texture_cube<f32>;\n\n@binding(8) @group(1) var envSpecular : texture_cube<f32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\n@binding(36) @group(1) var envSampler : sampler;\n\nvar<private> worldTangent : vec4f;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> color : vec4f;\n\nfn materialOf() -> vec4f {\n  return pbrMaterialParams.material;\n}\n\nfn movedUv(uv : vec2f, matrix : vec4f, motion : vec4f, time : f32) -> vec2f {\n  return (((mat2x2f(matrix.xy, matrix.zw) * uv) + motion.xy) + (motion.zw * time));\n}\n\nfn uvMatrixOf() -> vec4f {\n  return pbrMaterialParams.uvMatrix;\n}\n\nfn uvMotionOf() -> vec4f {\n  return pbrMaterialParams.uvMotion;\n}\n\nfn facingNormal(normal : vec3f, doubleSided : f32, frontFacing_1 : bool) -> vec3f {\n  return select(normal, (-normal), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn faceOf(doubleSided : f32, frontFacing_1 : bool) -> f32 {\n  return select(1f, (-1f), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn mappedNormal(normal : vec3f, tangent : vec4f, face : f32, texel : vec3f) -> vec3f {\n  var t : vec3f = normalize(tangent.xyz);\n  var sign_1 : f32 = select(1f, (-1f), (tangent.w < 0f));\n  var bitangent : vec3f = (normalize(cross(normal, t)) * sign_1);\n  var mapped : vec3f = ((texel * 2f) - 1f);\n  return (normalize((((mapped.x * t) + (mapped.y * bitangent)) + (mapped.z * normal))) * face);\n}\n\nfn pbrOf() -> vec4f {\n  return pbrMaterialParams.pbr;\n}\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (srgb.x <= 0.04045f)), select(high.y, low.y, (srgb.y <= 0.04045f)), select(high.z, low.z, (srgb.z <= 0.04045f)));\n}\n\nfn saturated(rgb : vec3f, amount : f32) -> vec3f {\n  if ((amount == 0f)) {\n    return rgb;\n  }\n  var luma : f32 = dot(rgb, vec3f(0.212671f, 0.71516f, 0.072169f));\n  var keep : f32 = (amount + 1f);\n  return ((rgb * keep) + vec3f((luma * (1f - keep))));\n}\n\nfn mapCoord(position : vec3f, matrix : mat4x4f) -> vec4f {\n  var q : vec4f = (matrix * vec4f(position, 1f));\n  if ((q.w <= 0f)) {\n    return vec4f(0f, 0f, 0f, 0f);\n  }\n  var p : vec3f = (q.xyz / q.w);\n  if (((((p.x <= 0f) || (p.x >= 1f)) || (p.y <= 0f)) || (p.y >= 1f))) {\n    return vec4f(0f, 0f, 0f, 0f);\n  }\n  return vec4f(p, 1f);\n}\n\nfn mapLit(z : f32, depth : f32, bias : f32, opacity : f32) -> f32 {\n  var lit : f32 = select(1f, 0f, ((clamp(z, 0f, 1f) - bias) > depth));\n  return mix(1f, lit, opacity);\n}\n\nfn dirShadowAt(position : vec3f) -> f32 {\n  var p : vec4f = mapCoord(position, shadowParams.shadowMatrix);\n  if ((p.w < 0.5f)) {\n    return 1f;\n  }\n  var size : vec2i = vec2i(textureDimensions(shadowMap, 0i));\n  var texel : vec2i = clamp(vec2i((p.xy * vec2f(size))), vec2i(0i, 0i), (size - vec2i(1i, 1i)));\n  var depth : f32 = textureLoad(shadowMap, texel, 0i).x;\n  return mapLit(p.z, depth, shadowParams.shadow.x, shadowParams.shadow.y);\n}\n\nfn envTurned(d : vec3f, turn : vec4f) -> vec3f {\n  return vec3f(((d.x * turn.z) - (d.z * turn.w)), d.y, ((d.x * turn.w) + (d.z * turn.z)));\n}\n\nfn splitSum(roughness : f32, nv : f32) -> vec2f {\n  var rx : f32 = (1f - roughness);\n  var ry : f32 = (0.0425f - (0.0275f * roughness));\n  var a004 : f32 = ((min((rx * rx), exp2(((-9.28f) * nv))) * rx) + ry);\n  return max(vec2f(((((-1.04f) * a004) + 1.04f) - (0.572f * roughness)), (((1.04f * a004) - 0.04f) + (0.022f * roughness))), vec2f(0.00005f));\n}\n\nfn pbrEnvironmentLight(albedo : vec3f, metalness : f32, roughness : f32, normal : vec3f, view : vec3f, occlusion : f32) -> vec3f {\n  var n : vec3f = normalize(normal);\n  var v : vec3f = normalize(view);\n  var nv : f32 = max(dot(n, v), 0f);\n  var f0 : vec3f = mix(vec3f(0.04f), albedo, metalness);\n  var fresnel : vec3f = (f0 + ((max(vec3f((1f - roughness)), f0) - f0) * exp2(((((-5.55473f) * nv) - 6.98316f) * nv))));\n  var turn : vec4f = frameParams.envParams;\n  var irradiance : vec3f = textureSampleLevel(envDiffuse, envSampler, envTurned(n, turn), 0f).xyz;\n  var radiance : vec3f = textureSampleLevel(envSpecular, envSampler, envTurned(reflect((-v), n), turn), (roughness * turn.y)).xyz;\n  var lut : vec2f = splitSum(roughness, nv);\n  var specular : vec3f = (radiance * ((fresnel * lut.x) + lut.y));\n  return (((((irradiance * albedo) * (1f - metalness)) * (1f - fresnel)) + specular) * (turn.x * occlusion));\n}\n\nfn pbrAmbient(albedo : vec3f, metalness : f32, roughness : f32, normal : vec3f, view : vec3f, ambient : vec3f, occlusion : f32) -> vec3f {\n  var nv : f32 = max(dot(normalize(normal), normalize(view)), 0f);\n  var f0 : vec3f = mix(vec3f(0.04f), albedo, metalness);\n  var fresnel : vec3f = (f0 + ((max(vec3f((1f - roughness)), f0) - f0) * exp2(((((-5.55473f) * nv) - 6.98316f) * nv))));\n  return ((((ambient * albedo) * (1f - metalness)) * (1f - fresnel)) * occlusion);\n}\n\nfn pbrDirectSpecular(albedo : vec3f, metalness : f32, roughness : f32, normal : vec3f, view : vec3f, light : vec3f, specularLight : vec3f, radiance : vec3f, shadow : f32, occlusionFactor : f32, occlusion : f32) -> vec3f {\n  if ((dot(radiance, radiance) <= 0.0001f)) {\n    return vec3f(0f);\n  }\n  var n : vec3f = normalize(normal);\n  var v : vec3f = normalize(view);\n  var l : vec3f = normalize(light);\n  var nl : f32 = clamp(dot(n, l), 0f, 1f);\n  if ((nl <= 0f)) {\n    return vec3f(0f);\n  }\n  var h : vec3f = normalize((normalize(specularLight) + v));\n  var nh : f32 = clamp(dot(n, h), 0f, 1f);\n  var vh : f32 = clamp(dot(v, h), 0f, 1f);\n  var nv : f32 = clamp(dot(n, v), 0f, 1f);\n  var alpha : f32 = (roughness * roughness);\n  var alpha2 : f32 = (alpha * alpha);\n  var denominator : f32 = (((nh * nh) * (alpha2 - 1f)) + 1f);\n  var distribution : f32 = (alpha2 / ((3.14159265358979f * denominator) * denominator));\n  var remapped : f32 = (roughness + 1f);\n  var k : f32 = ((remapped * remapped) * 0.125f);\n  var visibility : f32 = (((1f / ((nv * (1f - k)) + k)) * (1f / ((nl * (1f - k)) + k))) * 0.25f);\n  var f0 : vec3f = mix(vec3f(0.04f), albedo, metalness);\n  var fresnel : vec3f = (f0 + ((1f - f0) * exp2(((((-5.55473f) * vh) - 6.98316f) * vh))));\n  var specular : vec3f = max((fresnel * (distribution * visibility)), vec3f(0f));\n  var diffuse : vec3f = (((albedo * (1f / 3.14159265358979f)) * (1f - metalness)) * (1f - fresnel));\n  var reach : f32 = ((nl * shadow) * mix(1f, occlusion, occlusionFactor));\n  return (((diffuse + specular) * radiance) * reach);\n}\n\nfn pbrDirect(albedo : vec3f, metalness : f32, roughness : f32, normal : vec3f, view : vec3f, light : vec3f, radiance : vec3f, shadow : f32, occlusionFactor : f32, occlusion : f32) -> vec3f {\n  return pbrDirectSpecular(albedo, metalness, roughness, normal, view, light, light, radiance, shadow, occlusionFactor, occlusion);\n}\n\nfn lightWindow(distance_1 : f32, range : f32) -> f32 {\n  var window : f32 = clamp((1f - (distance_1 / range)), 0f, 1f);\n  return (window * window);\n}\n\nfn capsuleSample(position : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f) -> vec4f {\n  var start : vec3f = (at.xyz - (a.xyz * b.x));\n  var segment : vec3f = (a.xyz * (2f * b.x));\n  var along : f32 = clamp((dot((position - start), segment) / dot(segment, segment)), 0f, 1f);\n  var delta : vec3f = ((start + (segment * along)) - position);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  return vec4f((delta / distance_1), lightWindow(distance_1, tint.w));\n}\n\nfn rectanglePoint(position : vec3f, ray : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  var along : f32 = (dot(a.xyz, (at.xyz - position)) / dot(a.xyz, ray));\n  var offset : vec3f = ((position + (ray * along)) - at.xyz);\n  return ((at.xyz + (b.xyz * clamp(dot(offset, b.xyz), (-b.w), b.w))) + (c.xyz * clamp(dot(offset, c.xyz), (-c.w), c.w)));\n}\n\nfn rectangleAxisCone(delta : vec3f, forward : vec3f, excluded : vec3f, outer : f32, inner : f32) -> f32 {\n  var projectedDelta : vec3f = (delta - (excluded * dot(delta, excluded)));\n  var projectedLight : vec3f = ((-forward) - (excluded * dot((-forward), excluded)));\n  var deltaLength : f32 = length(projectedDelta);\n  var lightLength : f32 = length(projectedLight);\n  if (((deltaLength < 0.0001f) || (lightLength < 0.0001f))) {\n    return 0f;\n  }\n  var theta : f32 = (dot(projectedDelta, projectedLight) / (deltaLength * lightLength));\n  return clamp(((theta - outer) / ((inner - outer) + 0.00001f)), 0f, 1f);\n}\n\nfn rectangleSample(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec4f {\n  if ((abs(dot(a.xyz, normal)) < 0.000001f)) {\n    return vec4f(0f);\n  }\n  var delta : vec3f = (rectanglePoint(position, normal, at, a, b, c) - position);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  var cone : f32 = (rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w));\n  return vec4f((delta / distance_1), (lightWindow(distance_1, tint.w) * cone));\n}\n\nfn spotSample(position : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f) -> vec4f {\n  var delta : vec3f = (at.xyz - position);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  var toLight : vec3f = (delta / distance_1);\n  var cone : f32 = clamp(((dot(toLight, (-a.xyz)) - b.x) / (b.y - b.x)), 0f, 1f);\n  return vec4f(toLight, (lightWindow(distance_1, tint.w) * cone));\n}\n\nfn shapedSample(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec4f {\n  if ((a.w > 2.5f)) {\n    return capsuleSample(position, at, tint, a, b);\n  }\n  if ((a.w > 1.5f)) {\n    return rectangleSample(position, normal, at, tint, a, b, c, d);\n  }\n  return spotSample(position, at, tint, a, b);\n}\n\nfn capsuleSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f) -> vec3f {\n  var l0 : vec3f = ((at.xyz - (a.xyz * b.x)) - position);\n  var l01 : vec3f = (a.xyz * (2f * b.x));\n  var squared : f32 = dot(l01, l01);\n  var alongRay : f32 = dot(reflected, l01);\n  var denominator : f32 = (squared - (alongRay * alongRay));\n  if ((denominator <= 0.000001f)) {\n    return diffuse;\n  }\n  var closest : vec3f = (l0 + (l01 * clamp((dot(l0, ((reflected * alongRay) - l01)) / denominator), 0f, 1f)));\n  var centerToRay : vec3f = ((reflected * dot(closest, reflected)) - closest);\n  var offset : f32 = length(centerToRay);\n  if ((offset < 0.000001f)) {\n    return normalize(closest);\n  }\n  return normalize((closest + (centerToRay * clamp((b.y / offset), 0f, 1f))));\n}\n\nfn rectangleSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  if ((abs(dot(a.xyz, reflected)) < 0.000001f)) {\n    return diffuse;\n  }\n  return normalize((rectanglePoint(position, reflected, at, a, b, c) - position));\n}\n\nfn shapedSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  if ((a.w > 2.5f)) {\n    return capsuleSpecularDir(position, reflected, diffuse, at, a, b);\n  }\n  if ((a.w > 1.5f)) {\n    return rectangleSpecularDir(position, reflected, diffuse, at, a, b, c);\n  }\n  return diffuse;\n}\n\nfn spotShadowAt(position : vec3f) -> f32 {\n  var p : vec4f = mapCoord(position, shadowParams.spotMatrix);\n  if ((p.w < 0.5f)) {\n    return 1f;\n  }\n  var size : vec2i = vec2i(textureDimensions(spotShadowMap, 0i));\n  var texel : vec2i = clamp(vec2i((p.xy * vec2f(size))), vec2i(0i, 0i), (size - vec2i(1i, 1i)));\n  var depth : f32 = textureLoad(spotShadowMap, texel, 0i).x;\n  return mapLit(p.z, depth, shadowParams.spotShadow.x, shadowParams.spotShadow.y);\n}\n\nfn slotShadowAt(position : vec3f, slot : i32) -> f32 {\n  var a : vec4f = lightParams.shapeA[slot];\n  if ((((a.w < 0.5f) || (a.w > 1.5f)) || (lightParams.shapeB[slot].z < 0.5f))) {\n    return 1f;\n  }\n  return spotShadowAt(position);\n}\n\nfn linearToSrgb(rgb : vec3f) -> vec3f {\n  var low : vec3f = (rgb * 12.92f);\n  var high : vec3f = ((vec3f(1.055f) * pow(max(rgb, vec3f(0f)), vec3f(0.41666f))) - vec3f(0.055f));\n  return vec3f(select(high.x, low.x, (rgb.x <= 0.0031308f)), select(high.y, low.y, (rgb.y <= 0.0031308f)), select(high.z, low.z, (rgb.z <= 0.0031308f)));\n}\n\nfn pbrShade(n : vec3f, position : vec3f, surfaceColor : vec4f, values : vec3f) -> vec4f {\n  var albedo : vec3f = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n  var view : vec3f = (frameParams.cameraPosition.xyz - position);\n  var dir : vec4f = lightParams.dirLight;\n  var shadow : f32 = 1f;\n  shadow = dirShadowAt(position);\n  var sun : vec3f = (srgbToLinear(lightParams.dirColor.xyz) * dir.w);\n  var light : vec3f = vec3f(0f);\n  if ((frameParams.envParams.x > 0f)) {\n    light = pbrEnvironmentLight(albedo, values.x, values.y, n, view, values.z);\n  } else {\n    {\n      light = pbrAmbient(albedo, values.x, values.y, n, view, srgbToLinear(lightParams.ambient.xyz), values.z);\n    }\n  }\n  light = (light + pbrDirect(albedo, values.x, values.y, n, view, dir.xyz, sun, shadow, 0f, values.z));\n  var eye : vec3f = normalize(view);\n  var reflected : vec3f = ((-eye) - (n * (2f * dot((-eye), n))));\n  for (var i : i32 = 0i; (i < i32((lightParams.ambient.w + 0.5f))); i++) {\n    var at : vec4f = lightParams.pointLight[i];\n    var tint : vec4f = lightParams.pointColor[i];\n    var a : vec4f = lightParams.shapeA[i];\n    if ((a.w < 0.5f)) {\n      var toLight : vec3f = (at.xyz - position);\n      var falloff : f32 = clamp((1f - (length(toLight) / tint.w)), 0f, 1f);\n      var radiance : vec3f = (srgbToLinear(tint.xyz) * ((falloff * falloff) * at.w));\n      light = (light + pbrDirect(albedo, values.x, values.y, n, view, toLight, radiance, 1f, 0f, values.z));\n    } else {\n      {\n        var bb : vec4f = lightParams.shapeB[i];\n        var cc : vec4f = lightParams.shapeC[i];\n        var sample : vec4f = shapedSample(position, n, at, tint, a, bb, cc, lightParams.shapeD[i]);\n        var radiance_1 : vec3f = (srgbToLinear(tint.xyz) * (sample.w * at.w));\n        var specular : vec3f = shapedSpecularDir(position, reflected, sample.xyz, at, a, bb, cc);\n        light = (light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample.xyz, specular, radiance_1, slotShadowAt(position, i), 0f, values.z));\n      }\n    }\n  }\n  return vec4f(linearToSrgb(light), surfaceColor.w);\n}\n\nfn toneCurved(exposed : vec3f, mode : f32) -> vec3f {\n  if ((mode == 1f)) {\n    return (exposed / (exposed + vec3f(1f)));\n  }\n  if ((mode == 2f)) {\n    var a : vec3f = (exposed * ((2.51f * exposed) + 0.03f));\n    var b : vec3f = ((exposed * ((2.43f * exposed) + 0.59f)) + 0.14f);\n    return clamp((a / b), vec3f(0f), vec3f(1f));\n  }\n  if ((mode == 3f)) {\n    var startCompression : f32 = 0.76f;\n    var desaturation : f32 = 0.15f;\n    var x : f32 = min(exposed.x, min(exposed.y, exposed.z));\n    var offset : f32 = select(0.04f, (x - ((6.25f * x) * x)), (x < 0.08f));\n    var color_1 : vec3f = (exposed - offset);\n    var peak : f32 = max(color_1.x, max(color_1.y, color_1.z));\n    if ((peak >= startCompression)) {\n      var d : f32 = (1f - startCompression);\n      var newPeak : f32 = (1f - ((d * d) / ((peak + d) - startCompression)));\n      color_1 = (color_1 * (newPeak / peak));\n      var g : f32 = (1f - (1f / ((desaturation * (peak - newPeak)) + 1f)));\n      color_1 = mix(color_1, vec3f(newPeak), g);\n    }\n    return color_1;\n  }\n  return clamp(exposed, vec3f(0f), vec3f(1f));\n}\n\nfn toneMapped(rgb : vec3f, tone : vec4f) -> vec3f {\n  if ((tone.z == 1f)) {\n    return srgbToLinear(rgb);\n  }\n  if (((tone.y == 1f) && (tone.w == 0f))) {\n    return rgb;\n  }\n  return linearToSrgb(toneCurved((srgbToLinear(rgb) * tone.y), tone.w));\n}\n\nfn litTexturedFs() {\n  var params : vec4f = materialOf();\n  var uv : vec2f = surfaceUv;\n  var time : f32 = frameParams.frame.x;\n  uv = movedUv(surfaceUv, uvMatrixOf(), uvMotionOf(), time);\n  var texel : vec4f = textureSample(baseTexture, baseSampler, uv);\n  var noise : f32 = 0f;\n  var n : vec3f = facingNormal(normalize(worldNormal), params.z, frontFacing);\n  var normalTexel : vec3f = textureSample(normalTexture, baseSampler, uv).xyz;\n  var face : f32 = faceOf(params.z, frontFacing);\n  n = mappedNormal(normalize(worldNormal), worldTangent, face, normalTexel);\n  var surfaceColor : vec4f = vec4f(