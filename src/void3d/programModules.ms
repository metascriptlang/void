	const TEXT_8dd747579050c128be047209e2c547a8fc9b9d373237f7512e01a36433ee79f0 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform highp vec4 materialParams[1];\nuniform highp vec4 lightParams[27];\nuniform highp vec4 frameParams[3];\n\nin highp vec3 worldPosition;\nin highp vec3 worldNormal;\nin highp vec4 baseColor;\nin highp float depth01;\nlayout(location = 0) out highp vec4 color;\nlayout(location = 1) out highp vec4 normal;\n\nhighp vec4 materialOf()\n{\n    return materialParams[0];\n}\n\nhighp vec3 facingNormal(highp vec3 normal_1, highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal_1) : normal_1;\n}\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp vec3 toonPointLightAt(highp vec3 position, highp vec3 normal_1, highp vec4 at, highp vec4 tint, highp float normalWeight, highp float levels)\n{\n    highp vec3 toLight = at.xyz - position;\n    highp float distance_1 = length(toLight);\n    highp float falloff = clamp(1.0 - (distance_1 / tint.w), 0.0, 1.0);\n    highp float facing = mix(1.0, max(dot(normal_1, toLight / max(distance_1, 0.0001)), 0.0), normalWeight);\n    highp float energy = ((falloff * falloff) * facing) * at.w;\n    highp float level = floor((energy * levels) + 0.35) / levels;\n    return srgbToLinear(tint.xyz) * level;\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 toonShade(highp vec3 n, highp vec3 position, highp vec4 surfaceColor)\n{\n    highp vec4 params = materialOf();\n    highp vec4 dir = lightParams[1];\n    highp float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n    highp vec3 light = srgbToLinear(lightParams[0].xyz) + (srgbToLinear(lightParams[2].xyz) * lambert);\n    for (highp int i = 0; i < int(lightParams[0].w + 0.5); i++)\n    {\n        highp vec4 at = lightParams[3 + i];\n        light = light + toonPointLightAt(position, n, at, lightParams[7 + i], 1.0, params.x);\n    }\n    highp vec3 surface = srgbToLinear(saturated(surfaceColor.xyz, params.y));\n    return vec4(linearToSrgb(surface * light), surfaceColor.w);\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n        highp float desaturation = 0.15;\n        highp float x = min(exposed.x, min(exposed.y, exposed.z));\n        highp float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        highp vec3 color_1 = exposed - offset;\n        highp float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            highp float d = 1.0 - startCompression;\n            highp float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            highp float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 params = materialOf();\n    highp vec3 n = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    highp vec4 shaded = toonShade(n, worldPosition, baseColor);\n    color = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    normal = vec4((n * 0.5) + 0.5, depth01);\n    return;\n}\n";
