light = (light + pbrDirect(albedo, values.x, values.y, n, view, dir.xyz, sun, shadow, 0f, values.z));\n  var eye : vec3f = normalize(view);\n  var reflected : vec3f = ((-eye) - (n * (2f * dot((-eye), n))));\n  var cluster : vec4i = litClusterOf(frag, position);\n  for (var k : i32 = 0i; (k < (cluster.y + cluster.z)); k++) {\n    var i : i32 = litLightOf(cluster, k);\n    var at : vec4f = litTexelOf(i, 0i);\n    var tint : vec4f = litTexelOf(i, 1i);\n    var a : vec4f = litTexelOf(i, 2i);\n    var bb : vec4f = litTexelOf(i, 3i);\n    if ((a.w < 0.5f)) {\n      var toLight : vec3f = (at.xyz - position);\n      var falloff : f32 = clamp((1f - (length(toLight) / tint.w)), 0f, 1f);\n      var radiance : vec3f = (srgbToLinear(tint.xyz) * ((falloff * falloff) * at.w));\n      light = (light + pbrDirect(albedo, values.x, values.y, n, view, toLight, radiance, recordShadowAt(position, surfaceNormal, i), 0f, values.z));\n    } else {\n      {\n        var cc : vec4f = litTexelOf(i, 4i);\n        var sample : vec4f = shapedSample(position, n, at, tint, a, bb, cc, litTexelOf(i, 5i));\n        var radiance_1 : vec3f = (srgbToLinear(tint.xyz) * (sample.w * at.w));\n        var specular : vec3f = shapedSpecularDir(position, reflected, sample.xyz, at, a, bb, cc);\n        light = (light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample.xyz, specular, radiance_1, recordShadowAt(position, surfaceNormal, i), 0f, values.z));\n      }\n    }\n  }\n  return vec4f(linearToSrgb(light), surfaceColor.w);\n}\n\nfn emittedOver(color_1 : vec4f, texel : vec3f, emissive : vec4f) -> vec4f {\n  var emitted : vec3f = ((srgbToLinear(emissive.xyz) * srgbToLinear(texel)) * emissive.w);\n  return vec4f(linearToSrgb((srgbToLinear(color_1.xyz) + emitted)), color_1.w);\n}\n\nfn emissiveOf() -> vec4f {\n  return pbrEmissiveMaterialParams.emissive;\n}\n\nfn toneCurved(exposed : vec3f, mode : f32) -> vec3f {\n  if ((mode == 1f)) {\n    return (exposed / (exposed + vec3f(1f)));\n  }\n  if ((mode =