	const TEXT_97797b2864e1e69e1694e241e972253817e74814334d53efd96e6d7ab22146cf = "diagnostic(off, derivative_uniformity);\n\nstruct MovingEmissiveMaterialParams {\n  material : vec4f,\n  uvMatrix : vec4f,\n  uvMotion : vec4f,\n  backUvMatrix : vec4f,\n  backUvOffset : vec4f,\n  dissolve : vec4f,\n  dissolveEdge : vec4f,\n  emissive : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  pointLight : array<vec4f, 4>,\n  pointColor : array<vec4f, 4>,\n  shapeA : array<vec4f, 4>,\n  shapeB : array<vec4f, 4>,\n  shapeC : array<vec4f, 4>,\n  shapeD : array<vec4f, 4>,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nstruct ShadowParams {\n  shadowMatrix : mat4x4f,\n  shadow : vec4f,\n  spotMatrix : mat4x4f,\n  spotShadow : vec4f,\n}\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> movingEmissiveMaterialParams : MovingEmissiveMaterialParams;\n\n@binding(5) @group(0) var<uniform> shadowParams : ShadowParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(2) @group(1) var dissolveTexture : texture_2d<f32>;\n\n@binding(3) @group(1) var emissiveTexture : texture_2d<f32>;\n\n@binding(4) @group(1) var shadowMap : texture_2d<f32>;\n\n@binding(6) @group(1) var spotShadowMap : texture_2d<f32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\n@binding(33) @group(1) var dissolveSampler : sampler;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> color : vec4f;\n\nfn materialOf() -> vec4f {\n  return movingEmissiveMaterialParams.material;\n}\n\nfn dissolveOf() -> vec4f {\n  return movingEmissiveMaterialParams.dissolve;\n}\n\nfn facingNormal(normal : vec3f, doubleSided : f32, frontFacing_1 : bool) ->