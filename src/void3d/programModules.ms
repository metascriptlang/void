), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nvec3 saturated(vec3 rgb, float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nvec4 mapCoord(vec3 position, mat4 matrix)\n{\n    vec4 q = matrix * vec4(position, 1.0);\n    if (q.w <= 0.0)\n    {\n        return vec4(0.0, 0.0, 0.0, 0.0);\n    }\n    vec3 p = q.xyz / q.w;\n    if ((((p.x <= 0.0) || (p.x >= 1.0)) || (p.y <= 0.0)) || (p.y >= 1.0))\n    {\n        return vec4(0.0, 0.0, 0.0, 0.0);\n    }\n    return vec4(p, 1.0);\n}\n\nfloat mapLit(float z, float depth, float bias, float opacity)\n{\n    float lit = ((clamp(z, 0.0, 1.0) - bias) > depth) ? 0.0 : 1.0;\n    return mix(1.0, lit, opacity);\n}\n\nfloat dirShadowAt(vec3 position)\n{\n    vec4 p = mapCoord(position, mat4(shadowParams[0], shadowParams[1], shadowParams[2], shadowParams[3]));\n    if (p.w < 0.5)\n    {\n        return 1.0;\n    }\n    ivec2 size = textureSize(shadowMap_SPIRV_Cross_DummySampler, 0);\n    ivec2 texel = clamp(ivec2(p.xy * vec2(size)), ivec2(0, 0), size - ivec2(1, 1));\n    float depth = texelFetch(shadowMap_SPIRV_Cross_DummySampler, texel, 0).x;\n    return mapLit(p.z, depth, shadowParams[4].x, shadowParams[4].y);\n}\n\nvec3 envTurned(vec3 d, vec4 turn)\n{\n    return vec3((d.x * turn.z) - (d.z * turn.w), d.y, (d.x * turn.w) + (d.z * turn.z));\n}\n\nvec2 splitSum(float roughness, float nv)\n{\n    float rx = 1.0 - roughness;\n    float ry = 0.0425 - (0.0275 * roughness);\n    float a004 = (min(rx * rx, exp2((-9.28) * nv)) * rx) + ry;\n    return max(vec2((((-1.04) * a004) + 1.04) - (0.572 * roughness), ((1.04 * a004) - 0.04) + (0.022 * roughness)), vec2(0.00005));\n}\n\nvec3 pbrEnvironmentLight(vec3 albedo, float metalness, float roughness, vec3 normal, vec3 view, float occlusion)\n{\n    vec3 n = normalize(normal);\n    vec3 v = normalize(view);\n    float nv = max(dot(n, v), 0.0);\n    vec3 f0 = mix(vec3(0.04), albedo, metalness);\n    vec3 fresnel = f0 + ((max(vec3(1.0 - roughness), f0) - f0) * exp2((((-5.55473) * nv) - 6.98316) * nv));\n    vec4 turn = frameParams[2];\n    vec3 irradiance = textureLod(envDiffuse_envSampler, envTurned(n, turn), 0.0).xyz;\n    vec3 radiance = textureLod(envSpecular_envSampler, envTurned(reflect(-v, n), turn), roughness * turn.y).xyz;\n    vec2 lut = splitSum(roughness, nv);\n    vec3 specular = radiance * ((fresnel * lut.x) + lut.y);\n    return ((((irradiance * albedo) * (1.0 - metalness)) * (1.0 - fresnel)) + specular) * (turn.x * occlusion);\n}\n\nvec3 pbrAmbient(vec3 albedo, float metalness, float roughness, vec3 normal, vec3 view, vec3 ambient, float occlusion)\n{\n    float nv = max(dot(normalize(normal), normalize(view)), 0.0);\n    vec3 f0 = mix(vec3(0.04), albedo, metalness);\n    vec3 fresnel = f0 + ((max(vec3(1.0 - roughness), f0) - f0) * exp2((((-5.55473) * nv) - 6.98316) * nv));\n    return (((ambient * albedo) * (1.0 - metalness)) * (1.0 - fresnel)) * occlusion;\n}\n\nvec3 pbrDirectSpecular(vec3 albedo, float metalness, float roughness, vec3 normal, vec3 view, vec3 light, vec3 specularLight, vec3 radiance, float shadow, float occlusionFactor, float occlusion)\n{\n    if (dot(radiance, radiance) <= 0.0001)\n    {\n        return vec3(0.0);\n    }\n    vec3 n = normalize(normal);\n    vec3 v = normalize(view);\n    vec3 l = normalize(light);\n    float nl = clamp(dot(n, l), 0.0, 1.0);\n    if (nl <= 0.0)\n    {\n        return vec3(0.0);\n    }\n    vec3 h = normalize(normalize(specularLight) + v);\n    float nh = clamp(dot(n, h), 0.0, 1.0);\n    float vh = clamp(dot(v, h), 0.0, 1.0);\n    float nv = clamp(dot(n, v), 0.0, 1.0);\n    float alpha = roughness * roughness;\n    float alpha2 = alpha * alpha;\n    float denominator = ((nh * nh) * (alpha2 - 1.0)) + 1.0;