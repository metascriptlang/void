	const TEXT_2d00754d7dd4e6c376ba50a7b161fa7cd79a999e2b48d183a65f2a13629e0b22 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nconst highp uint DATA_ROW = 256u;\nconst highp int RECORD_TEXELS = 6;\n\nuniform highp vec4 billboardParams[2];\nuniform highp vec4 lightParams[12];\nuniform highp vec4 frameParams[3];\nuniform highp sampler2D billboardTexture_billboardSampler;\nuniform highp sampler2D lightRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterIndices_SPIRV_Cross_DummySampler;\n\nin highp vec3 worldPosition;\nin highp vec3 towardCamera;\nin highp vec2 uv;\nin highp vec4 instanceColor;\nlayout(location = 0) out highp vec4 fragColor;\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp int cellOf(highp float position, highp int cells)\n{\n    if (!(position > 0.0))\n    {\n        return 0;\n    }\n    if (position >= float(cells))\n    {\n        return cells - 1;\n    }\n    return int(position);\n}\n\nhighp int clusterSliceOf(highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    highp int slices = int(grid.z + 0.5);\n    if (grid.w > 0.5)\n    {\n        return cellOf(floor((depth - factors.z) * factors.w), slices);\n    }\n    return cellOf(((log(depth) * factors.z) - factors.w) + 1.0, slices);\n}\n\nhighp int clusterAtCell(highp vec2 cell, highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    highp int columns = int(grid.x + 0.5);\n    highp int x = cellOf(cell.x, columns);\n    highp int y = cellOf(cell.y, int(grid.y + 0.5));\n    return (((y * columns) + x) * int(grid.z + 0.5)) + clusterSliceOf(depth, grid, factors);\n}\n\nhighp int clusterIndexOf(highp vec2 frag