			fragmentCode: "#version 300 es\nprecision mediump float;\nprecision highp int;\n\nuniform highp vec4 pbrEmissiveMaterialParams[5];\nuniform highp vec4 frameParams[3];\nuniform highp vec4 lightParams[27];\nuniform highp vec4 shadowParams[10];\nuniform highp sampler2D baseTexture_baseSampler;\nuniform highp sampler2D metalRoughTexture_baseSampler;\nuniform highp sampler2D occlusionTexture_baseSampler;\nuniform highp sampler2D emissiveTexture_baseSampler;\nuniform highp sampler2D shadowMap_SPIRV_Cross_DummySampler;\nuniform highp sampler2D spotShadowMap_SPIRV_Cross_DummySampler;\nuniform highp samplerCube envDiffuse_envSampler;\nuniform highp samplerCube envSpecular_envSampler;\n\nin highp vec3 worldPosition;\nin highp vec3 worldNormal;\nin highp vec2 surfaceUv;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\n\nhighp vec4 materialOf()\n{\n    return pbrEmissiveMaterialParams[0];\n}\n\nhighp vec2 movedUv(highp vec2 uv, highp vec4 matrix, highp vec4 motion, highp float time)\n{\n    return ((mat2(matrix.xy, matrix.zw) * uv) + motion.xy) + (motion.zw * time);\n}\n\nhighp vec4 uvMatrixOf()\n{\n    return pbrEmissiveMaterialParams[2];\n}\n\nhighp vec4 uvMotionOf()\n{\n    return pbrEmissiveMaterialParams[3];\n}\n\nhighp vec3 facingNormal(highp vec3 normal, highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal) : normal;\n}\n\nhighp vec4 pbrOf()\n{\n    return pbrEmissiveMaterialParams[1];\n}\n\nhighp vec3 pbrMapped(highp vec2 uv)\n{\n    highp vec4 metalRoughTexel = texture(metalRoughTexture_baseSampler, uv);\n    highp float occluded = texture(occlusionTexture_baseSampler, uv).x;\n    highp vec4 values = pbrOf();\n    return vec3(values.x * metalRoughTexel.z, max(values.y * metalRoughTexel.y, 0.089), values.z * (1.0 + (values.w * (occluded - 1.0))));\n}\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986)