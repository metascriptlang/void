tion, n, at, tint, a, bb, cc, lightParams[23 + i]);\n                vec3 radiance_1 = srgbToLinear(tint.xyz) * (sample_1.w * at.w);\n                vec3 specular = shapedSpecularDir(position, reflected, sample_1.xyz, at, a, bb, cc);\n                light = light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample_1.xyz, specular, radiance_1, slotShadowAt(position, i), 0.0, values.z);\n            }\n        }\n    }\n    return vec4(linearToSrgb(light), surfaceColor.w);\n}\n\nvec4 emittedOver(vec4 color_1, vec3 texel, vec4 emissive)\n{\n    vec3 emitted = (srgbToLinear(emissive.xyz) * srgbToLinear(texel)) * emissive.w;\n    return vec4(linearToSrgb(srgbToLinear(color_1.xyz) + emitted), color_1.w);\n}\n\nvec4 emissiveOf()\n{\n    return pbrEmissiveMaterialParams[4];\n}\n\nvec3 toneCurved(vec3 exposed, float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        float startCompression = 0.76;\n        float desaturation = 0.15;\n        float x = min(exposed.x, min(exposed.y, exposed.z));\n        float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        vec3 color_1 = exposed - offset;\n        float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            float d = 1.0 - startCompression;\n            float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nvec3 toneMapped(vec3 rgb, vec4 tone)\n{\n    if (tone.z == 1.0