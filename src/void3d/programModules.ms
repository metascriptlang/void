	const TEXT_636ff92dccd4e0b6ae24fd9764d6756bb46685127e0ee114df1bb88490e952cf = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform highp vec4 materialParams[1];\nuniform highp vec4 lightParams[27];\nuniform highp vec4 frameParams[3];\nuniform highp sampler2D baseTexture_baseSampler;\n\nin highp vec3 worldPosition;\nin highp vec3 worldNormal;\nin highp vec2 surfaceUv;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\n\nhighp vec4 materialOf()\n{\n    return materialParams[0];\n}\n\nhighp vec3 facingNormal(highp vec3 normal, highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal) : normal;\n}\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp vec3 pointLightAt(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint)\n{\n    highp vec3 toLight = at.xyz - position;\n    highp float distance_1 = length(toLight);\n    highp float falloff = clamp(1.0 - (distance_1 / tint.w), 0.0, 1.0);\n    highp float facing = max(dot(normal, toLight / max(distance_1, 0.0001)), 0.0);\n    return srgbToLinear(tint.xyz) * (((falloff * falloff) * facing) * at.w);\n}\n\nhighp float lightWindow(highp float distance_1, highp float range)\n{\n    highp float window = clamp(1.0 - (distance_1 / range), 0.0, 1.0);\n    return window * window;\n}\n\nhighp vec4 capsuleSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 start = at.xyz - (a.xyz * b.x);\n    highp vec3 segment = a.xyz * (2.0 * b.x);\n    highp float along = clamp(dot(position - start, segment) / dot(segment, segment), 0.0, 1.0);\n    highp vec3 delta = (start + (segment * along)) - position;\n   