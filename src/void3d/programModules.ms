urn clamp((theta - outer) / ((inner - outer) + 0.00001), 0.0, 1.0);\n}\n\nhighp vec4 rectangleSample(highp vec3 position, highp vec3 normal_1, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (abs(dot(a.xyz, normal_1)) < 0.000001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 delta = rectanglePoint(position, normal_1, at, a, b, c) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp float cone = rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w);\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 spotSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 delta = at.xyz - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 toLight = delta / distance_1;\n    highp float cone = clamp((dot(toLight, -a.xyz) - b.x) / (b.y - b.x), 0.0, 1.0);\n    return vec4(toLight, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 shapedSample(highp vec3 position, highp vec3 normal_1, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSample(position, at, tint, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSample(position, normal_1, at, tint, a, b, c, d);\n    }\n    return spotSample(position, at, tint, a, b);\n}\n\nhighp vec3 lightAt(highp vec3 position, highp vec3 normal_1, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    highp vec3 lit = vec3(0.0);\n    if (a.w < 0.5)\n    {\n        lit = pointLightAt(position, normal_1, at, tint);\n    }\n    else\n    {\n        {\n            highp vec4 sample_1 = shapedSample(position, normal_1, at, tint, a, 