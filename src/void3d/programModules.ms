	const TEXT_89c5144b658597eae44752df9bd18655877ad694ca8bd938f933ce2c2b8aceba = "struct VertexParams {\n  viewProj : mat4x4f,\n  cameraRight : vec4f,\n  cameraUp : vec4f,\n  cameraPosition : vec4f,\n}\n\nstruct LineParams {\n  lineShape : vec4f,\n  lineDepth : vec4f,\n  lineColor : vec4f,\n}\n\n@binding(0) @group(0) var<uniform> vertexParams : VertexParams;\n\n@binding(3) @group(0) var<uniform> lineParams : LineParams;\n\nvar<private> position : vec3f;\n\nvar<private> normal : vec3f;\n\nvar<private> uv : vec2f;\n\nvar<private> color : vec4f;\n\nvar<private> instanceRow0 : vec4f;\n\nvar<private> instanceRow1 : vec4f;\n\nvar<private> instanceRow2 : vec4f;\n\nvar<private> instanceColor : vec4f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> clip : vec4f;\n\nfn upperLeft3x3(m : mat4x4f) -> mat3x3f {\n  return mat3x3f(m[0].xyz, m[1].xyz, m[2].xyz);\n}\n\nfn instanceWorld(row0 : vec4f, row1 : vec4f, row2 : vec4f) -> mat4x4f {\n  return transpose(mat4x4f(row0, row1, row2, vec4f(0f, 0f, 0f, 1f)));\n}\n\nfn lineScreenDirection(direction : vec3f, right : vec4f, up : vec4f) -> vec2f {\n  var projected : vec2f = vec2f((dot(direction, right.xyz) * right.w), (dot(direction, up.xyz) * up.w));\n  return (projected * (1f / length(projected)));\n}\n\nfn lineViewDepth(depth : f32, zNear : f32, zFar : f32) -> f32 {\n  return (((2f * zNear) * zFar) / ((zFar + zNear) - (((2f * depth) - 1f) * (zFar - zNear))));\n}\n\nfn lineClipOffset(screenDirection : vec2f, side : f32, viewDepth : f32, pixelSize : vec2f, width : f32) -> vec2f {\n  return ((vec2f(screenDirection.y, (-screenDirection.x)) * pixelSize) * (((side - 0.5f) * viewDepth) * width));\n}\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (srgb.x <= 0.04045f)), select(high.y, low.y, (srgb.y <= 0.04045f)), select(high.z, low.z, (srgb.z <= 0.04045f)));\n