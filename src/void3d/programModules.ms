rn clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nvec3 toneMapped(vec3 rgb, vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    vec4 color_1 = particleColor;\n    if (color_1.w < 0.5)\n    {\n        demoted = true;\n    }\n    color_1 = vec4(color_1.xyz, 0.0);\n    color = vec4(toneMapped(color_1.xyz, frameParams[0]), color_1.w);\n    normal = vec4(0.5, 1.0, 0.5, depth01);\n    if (demoted)\n    {\n        discard;\n    }\n    return;\n}\n";
