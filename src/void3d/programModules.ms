  highp float depth = texelFetch(shadowMap_SPIRV_Cross_DummySampler, texel, 0).x;\n    return mapLit(p.z, depth, shadowParams[4].x, shadowParams[4].y);\n}\n\nhighp vec3 envTurned(highp vec3 d, highp vec4 turn)\n{\n    return vec3((d.x * turn.z) - (d.z * turn.w), d.y, (d.x * turn.w) + (d.z * turn.z));\n}\n\nhighp vec2 splitSum(highp float roughness, highp float nv)\n{\n    highp float rx = 1.0 - roughness;\n    highp float ry = 0.0425 - (0.0275 * roughness);\n    highp float a004 = (min(rx * rx, exp2((-9.28) * nv)) * rx) + ry;\n    return max(vec2((((-1.04) * a004) + 1.04) - (0.572 * roughness), ((1.04 * a004) - 0.04) + (0.022 * roughness)), vec2(0.00005));\n}\n\nhighp vec3 pbrEnvironmentLight(highp vec3 albedo, highp float metalness, highp float roughness, highp vec3 normal, highp vec3 view, highp float occlusion)\n{\n    highp vec3 n = normalize(normal);\n    highp vec3 v = normalize(view);\n    highp float nv = max(dot(n, v), 0.0);\n    highp vec3 f0 = mix(vec3(0.04), albedo, metalness);\n    highp vec3 fresnel = f0 + ((max(vec3(1.0 - roughness), f0) - f0) * exp2((((-5.55473) * nv) - 6.98316) * nv));\n    highp vec4 turn = frameParams[2];\n    highp vec3 irradiance = textureLod(envDiffuse_envSampler, envTurned(n, turn), 0.0).xyz;\n    highp vec3 radiance = textureLod(envSpecular_envSampler, envTurned(reflect(-v, n), turn), roughness * turn.y).xyz;\n    highp vec2 lut = splitSum(roughness, nv);\n    highp vec3 specular = radiance * ((fresnel * lut.x) + lut.y);\n    return ((((irradiance * albedo) * (1.0 - metalness)) * (1.0 - fresnel)) + specular) * (turn.x * occlusion);\n}\n\nhighp vec3 pbrAmbient(highp vec3 albedo, highp float metalness, highp float roughness, highp vec3 normal, highp vec3 view, highp vec3 ambient, highp float occlusion)\n{\n    highp float nv = max(dot(normalize(normal), normalize(view)), 0.0);\n    highp vec3 f0 = mix(vec3(0.04), albedo, metalness);\n    highp vec3 fresnel = f0 + ((max(vec3(1.0 - roughness), f0) - f0) * exp2((((-5.55473) * nv) - 6.98316) * nv));\n    return (((ambient * albedo) * (1.0 - metalness)) * (1.0 - fresnel)) * occlusion;\n}\n\nhighp vec3 pbrDirectSpecular(highp vec3 albedo, highp float metalness, highp float roughness, highp vec3 normal, highp vec3 view, highp vec3 light, highp vec3 specularLight, highp vec3 radiance, highp float shadow, highp float occlusionFactor, highp float occlusion)\n{\n    if (dot(radiance, radiance) <= 0.0001)\n    {\n        return vec3(0.0);\n    }\n    highp vec3 n = normalize(normal);\n    highp vec3 v = normalize(view);\n    highp vec3 l = normalize(light);\n    highp float nl = clamp(dot(n, l), 0.0, 1.0);\n    if (nl <= 0.0)\n    {\n        return vec3(0.0);\n    }\n    highp vec3 h = normalize(normalize(specularLight) + v);\n    highp float nh = clamp(dot(n, h), 0.0, 1.0);\n    highp float vh = clamp(dot(v, h), 0.0, 1.0);\n    highp float nv = clamp(dot(n, v), 0.0, 1.0);\n    highp float alpha = roughness * roughness;\n    highp float alpha2 = alpha * alpha;\n    highp float denominator = ((nh * nh) * (alpha2 - 1.0)) + 1.0;\n    highp float distribution = alpha2 / ((3.14159265358979 * denominator) * denominator);\n    highp float remapped = roughness + 1.0;\n    highp float k = (remapped * remapped) * 0.125;\n    highp float visibility = ((1.0 / ((nv * (1.0 - k)) + k)) * (1.0 / ((nl * (1.0 - k)) + k))) * 0.25;\n    highp vec3 f0 = mix(vec3(0.04), albedo, metalness);\n    highp vec3 fresnel = f0 + ((1.0 - f0) * exp2((((-5.55473) * vh) - 6.98316) * vh));\n    highp vec3 specular = max(fresnel * (distribution * visibility), vec3(0.0));\n    highp vec3 diffuse = ((albedo * (1.0 / 3.14159265358979)) * (1.0 - metalness)) * (1.0 - fresnel);\n    highp float reach = (nl * shadow) * mix(1.0, occlusion, occlusionFactor);\n    return ((diffuse + specular) * radiance) * reach;\n}\n\nhighp vec3 pbrDirect(highp vec3 albedo, highp float metalness, highp float roughness, highp vec3 normal, highp vec3 view, highp vec3 light, highp vec3 radiance, highp float shadow, highp float occlusionFactor, highp float occlusion)\n{\n    return pbrDirectSpecular(albedo, metalness, roughness, normal, view, light, light, radiance, shadow, occlusionFactor, occlusion);\n}\n\nhighp float lightWindow(highp float distance_1, highp float range)\n{\n    highp float window = clamp(1.0 - (distance_1 / range), 0.0, 1.0);\n    return window * window;\n}\n\nhighp vec4 capsuleSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 start = at.xyz - (a.xyz * b.x);\n    highp vec3 segment = a.xyz * (2.0 * b.x);\n    highp float along = clamp(dot(position - start, segment) / dot(segment, segment), 0.0, 1.0);\n    highp vec3 delta = (start + (segment * along)) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w));\n}\n\nhighp vec3 rectanglePoint(highp vec3 position, highp vec3 ray, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    highp float along = dot(a.xyz, at.xyz - position) / dot(a.xyz, ray);\n    highp vec3 offset = (position + (ray * along)) - at.xyz;\n    return (at.xyz + (b.xyz * clamp(dot(offset, b.xyz), -b.w, b.w))) + (c.xyz * clamp(dot(offset, c.xyz), -c.w, c.w));\n}\n\nhighp float rectangleAxisCone(highp vec3 delta, highp vec3 forward, highp vec3 excluded, highp float outer, highp float inner)\n{\n    highp vec3 projectedDelta = delta - (excluded * dot(delta, excluded));\n    highp vec3 projectedLight = (-forward) - (excluded * dot(-forward, excluded));\n    highp float deltaLength = length(projectedDelta);\n    highp float lightLength = length(projectedLight);\n    if ((deltaLength < 0.0001) || (lightLength < 0.0001))\n    {\n        return 0.0;\n    }\n    highp float theta = dot(projectedDelta, projectedLight) / (deltaLength * lightLength);\n    return clamp((theta - outer) / ((inner - outer) + 0.00001), 0.0, 1.0);\n}\n\nhighp vec4 rectangleSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (abs(dot(a.xyz, normal)) < 0.000001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 delta = rectanglePoint(position, normal, at, a, b, c) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp float cone = rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w);\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 spotSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 delta = at.xyz - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 toLight = delta / distance_1;\n    highp float cone = clamp((dot(toLight, -a.xyz) - b.x) / (b.y - b.x), 0.0, 1.0);\n    return vec4(toLight, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 shapedSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSample(position, at, tint, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSample(position, normal, at, tint, a, b, c, d);\n    }\n    return spotSample(position, at, tint, a, b);\n}\n\nhighp vec3 capsuleSpecularDir(highp vec3 position, highp vec3 reflected, highp vec3 diffuse, highp vec4 at, highp vec4 a, highp vec4 b)\n{\n    highp vec3 l0 = (at.xyz - (a.xyz * b.x)) - position;\n    highp vec3 l01 = a.xyz * (2.0 * b.x);\n    highp float squared = dot(l01, l01);\n    highp float alongRay = dot(reflected, l01);\n    highp float denominator = squared - (alongRay * alongRay);\n    if (denominator <= 0.000001)\n    {\n        return diffuse;\n    }\n    highp vec3 closest = l0 + (l01 * clamp(dot(l0, (reflected * alongRay) - l01) / denominator, 0.0, 1.0));\n    highp vec3 centerToRay = (reflected * dot(closest, reflected)) - closest;\n    highp float offset = length(centerToRay);\n    if (offset < 0.000001)\n    {\n        return normalize(closest);\n    }\n    return normalize(closest + (centerToRay * clamp(b.y / offset, 0.0, 1.0)));\n}\n\nhighp vec3 rectangleSpecularDir(highp vec3 position, highp vec3 reflected, highp vec3 diffuse, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    if (abs(dot(a.xyz, reflected)) < 0.000001)\n    {\n        return diffuse;\n    }\n    return normalize(rectanglePoint(position, reflected, at, a, b, c) - position);\n}\n\nhighp vec3 shapedSpecularDir(highp vec3 position, highp vec3 reflected, highp vec3 diffuse, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSpecularDir(position, reflected, diffuse, at, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSpecularDir(position, reflected, diffuse, at, a, b, c);\n    }\n    return diffuse;\n}\n\nhighp float spotShadowAt(highp vec3 position)\n{\n    highp vec4 p = mapCoord(position, mat4(shadowParams[5], shadowParams[6], shadowParams[7], shadowParams[8]));\n    if (p.w < 0.5)\n    {\n        return 1.0;\n    }\n    highp ivec2 size = textureSize(spotShadowMap_SPIRV_Cross_DummySampler, 0);\n    highp ivec2 texel = clamp(ivec2(p.xy * vec2(size)), ivec2(0, 0), size - ivec2(1, 1));\n    highp float depth = texelFetch(spotShadowMap_SPIRV_Cross_DummySampler, texel, 0).x;\n    return mapLit(p.z, depth, shadowParams[9].x, shadowParams[9].y);\n}\n\nhighp float slotShadowAt(highp vec3 position, highp int slot)\n{\n    highp vec4 a = lightParams[11 + slot];\n    if (((a.w < 0.5) || (a.w > 1.5)) || (lightParams[15 + slot].z < 0.5))\n    {\n        return 1.0;\n    }\n    return spotShadowAt(position);\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 pbrShade(highp vec3 n, highp vec3 position, highp vec4 surfaceColor, highp vec3 values)\n{\n    highp vec3 albedo = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n    highp vec3 view = frameParams[1].xyz - position;\n    highp vec4 dir = lightParams[1];\n    highp float shadow = 1.0;\n    shadow = dirShadowAt(position);\n    highp vec3 sun = srgbToLinear(lightParams[2].xyz) * dir.w;\n    highp vec3 light = vec3(0.0);\n    if (frameParams[2].x > 0.0)\n    {\n        light = pbrEnvironmentLight(albedo, values.x, values.y, n, view, values.z);\n    }\n    else\n    {\n        {\n            light = pbrAmbient(albedo, values.x, values.y, n, view, srgbToLinear(lightParams[0].xyz), values.z);\n        }\n    }\n    light = light + pbrDirect(albedo, values.x, values.y, n, view, dir.xyz, sun, shadow, 0.0, values.z);\n    highp vec3 eye = normalize(view);\n    highp vec3 reflected = (-eye) - (n * (2.0 * dot(-eye, n)));\n    for (highp int i = 0; i < int(lightParams[0].w + 0.5); i++)\n    {\n        highp vec4 at = lightParams[3 + i];\n        highp vec4 tint = lightParams[7 + i];\n        highp vec4 a = lightParams[11 + i];\n        if (a.w < 0.5)\n        {\n            highp vec3 toLight = at.xyz - position;\n            highp float falloff = clamp(1.0 - (length(toLight) / tint.w), 0.0, 1.0);\n            highp vec3 radiance = srgbToLinear(tint.xyz) * ((falloff * falloff) * at.w);\n            light = light + pbrDirect(albedo, values.x, values.y, n, view, toLight, radiance, 1.0, 0.0, values.z);\n        }\n        else\n        {\n            {\n                highp vec4 bb = lightParams[15 + i];\n                highp vec4 cc = lightParams[19 + i];\n                highp vec4 sample_1 = shapedSample(position, n, at, tint, a, bb, cc, lightParams[23 + i]);\n                highp vec3 radiance_1 = srgbToLinear(tint.xyz) * (sample_1.w * at.w);\n                highp vec3 specular = shapedSpecularDir(position, reflected, sample_1.xyz, at, a, bb, cc);\n                light = light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample_1.xyz, specular, radiance_1, slotShadowAt(position, i), 0.0, values.z);\n            }\n        }\n    }\n    return vec4(linearToSrgb(light), surfaceColor.w);\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n        highp float desaturation = 0.15;\n        highp float x = min(exposed.x, min(exposed.y, exposed.z));\n        highp float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        highp vec3 color_1 = exposed - offset;\n        highp float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            highp float d = 1.0 - startCompression;\n            highp float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            highp float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 params = materialOf();\n    highp vec2 uv = surfaceUv;\n    highp float time = frameParams[0].x;\n    uv = movedUv(surfaceUv, uvMatrixOf(), uvMotionOf(), time);\n    highp vec4 texel = texture(baseTexture_baseSampler, uv);\n    highp float noise = 0.0;\n    highp vec3 n = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    highp vec3 normalTexel = texture(normalTexture_baseSampler, uv).xyz;\n    highp float face = faceOf(params.z, gl_FrontFacing);\n    n = mappedNormal(normalize(worldNormal), worldTangent, face, normalTexel);\n    highp vec4 surfaceColor = vec4(baseColor.xyz * texel.xyz, baseColor.w * texel.w);\n    highp vec4 shaded = vec4(0.0);\n    highp vec3 pbrValues = pbrOf().xyz;\n    pbrValues = pbrMapped(uv);\n    shaded = pbrShade(n, worldPosition, surfaceColor, pbrValues);\n    highp vec4 color_1 = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    color = color_1;\n    return;\n}\n",
