	const TEXT_0025517a03a1b48e89566e354c087edf14104f949f30d285be26b5cbbe9a2cf4 = "diagnostic(off, derivative_uniformity);\n\nstruct EmissiveMaterialParams {\n  material : vec4f,\n  materialColor : vec4f,\n  emissive : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  clusterGrid : vec4f,\n  clusterFactors : vec4f,\n  clusterView : vec4f,\n  clusterScreen : vec4f,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nstruct ShadowParams {\n  cascadeMatrices : array<mat4x4f, 4>,\n  cascadeFar : vec4f,\n  cascadeInfo : vec4f,\n  cascadeView : vec4f,\n  cascadeFilter : vec4f,\n  spotMatrix : mat4x4f,\n  spotShadow : vec4f,\n  spotReceiver : vec4f,\n  cubeMatrices : array<mat4x4f, 6>,\n  cubeShadow : vec4f,\n  cubeLight : vec4f,\n  cubeRange : vec4f,\n}\n\nconst PCF_SAMPLES : i32 = 16i;\n\nconst POISSON_DISK : array<vec2f, 16> = array<vec2f, 16>(vec2f((-0.94201624f), (-0.39906216f)), vec2f(0.94558609f, (-0.76890725f)), vec2f((-0.0941841f), (-0.9293887f)), vec2f(0.34495938f, 0.2938776f), vec2f((-0.91588581f), 0.45771432f), vec2f((-0.81544232f), (-0.87912464f)), vec2f((-0.38277543f), 0.27676845f), vec2f(0.97484398f, 0.75648379f), vec2f(0.44323325f, (-0.97511554f)), vec2f(0.53742981f, (-0.4737342f)), vec2f((-0.26496911f), (-0.41893023f)), vec2f(0.79197514f, 0.19090188f), vec2f((-0.2418884f), 0.99706507f), vec2f((-0.81409955f), 0.9143759f), vec2f(0.19984126f, 0.78641367f), vec2f(0.14383161f, (-0.1410079f)));\n\nconst DATA_ROW : u32 = 256u;\n\nconst RECORD_TEXELS : i32 = 6i;\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> emissiveMaterialParams : EmissiveMaterialParams;\n\n@binding(5) @group(0) var<uniform> shadowParams : ShadowParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(3) @group(1) var emissiveTexture : texture_2d<f32>;\n\n@bindi