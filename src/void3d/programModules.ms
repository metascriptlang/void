			vertexCode: "#version 430\n\nlayout(location = 0) in vec2 position;\n\nvoid main()\n{\n    gl_Position = vec4(position, 0.5, 1.0);\n    return;\n}\n",
			vertexEntryPoint: "main",
			vertexBytecode: [],
			fragmentCode: "#version 430\n\nconst ivec2 OUTLINE_OFFSETS[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));\n\nuniform vec4 postParams[6];\nlayout(binding = 0) uniform sampler2D colorTexture_SPIRV_Cross_DummySampler;\nlayout(binding = 1) uniform sampler2D normalTexture_SPIRV_Cross_DummySampler;\nlayout(binding = 2) uniform sampler2D depthTexture_SPIRV_Cross_DummySampler;\nlayout(binding = 3) uniform sampler2D paletteTexture_SPIRV_Cross_DummySampler;\n\nlayout(location = 0) out vec4 fragColor;\n\nvec4 postNormalAt(ivec2 p, ivec2 size)\n{\n    return texelFetch(normalTexture_SPIRV_Cross_DummySampler, clamp(p, ivec2(0, 0), size - ivec2(1, 1)), 0);\n}\n\nfloat postDepthAt(vec4 normal, ivec2 p, ivec2 size)\n{\n    float depth = normal.w;\n    if (postParams[3].z > 0.5)\n    {\n        ivec2 q = clamp(p, ivec2(0, 0), size - ivec2(1, 1));\n        float stored = texelFetch(depthTexture_SPIRV_Cross_DummySampler, q, 0).x;\n        depth = (stored * postParams[4].x) + postParams[4].y;\n    }\n    return depth;\n}\n\nvec3 saturated(vec3 rgb, float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nvec3 paletteColor(vec3 rgb)\n{\n    int levels = int(postParams[3].w);\n    ivec3 q = ivec3((clamp(rgb, vec3(0.0), vec3(1.0)) * float(levels - 1)) + 0.5);\n    return texelFetch(paletteTexture_SPIRV_Cross_DummySampler, ivec2(q.x + (q.z * levels), q.y), 0).xyz;\n}\n\nvoid main()\n{\n    ivec2 size = textureSize(colorTexture_SPIRV_Cross_DummySampler, 0);\n    ivec2 p = ivec2(gl_FragCoord.xy);\n    vec4 color = texelFetch(colorTexture_SPIRV_Cross_DummySampler, p, 0);\n    vec4 center = postNormalAt(p, size);\n    float centerDepth = postDepthAt(center, p, size);\n    vec4 edge = postParams[0];\n    vec3 rgb = color.xyz;\n    if (postParams[3].x > 0.5)\n    {\n        vec3 n = (center.xyz * 2.0) - 1.0;\n        float depthEdge = 0.0;\n        float normalEdge = 0.0;\n        for (int i = 0; i < 4; i++)\n        {\n            vec4 neighbor = postNormalAt(p + OUTLINE_OFFSETS[i], size);\n            float depthDelta = postDepthAt(neighbor, p + OUTLINE_OFFSETS[i], size) - centerDepth;\n            if (depthDelta > edge.x)\n            {\n                depthEdge = 1.0;\n            }\n            vec3 nq = (neighbor.xyz * 2.0) - 1.0;\n            if (((abs(depthDelta) < edge.x) && (dot(n, nq) < edge.y)) && (n.y > (nq.y + 0.1)))\n            {\n                normalEdge = 1.0;\n            }\n        }\n        rgb = mix(rgb, rgb * edge.z, depthEdge * color.w);\n        rgb = mix(rgb, (rgb * edge.w) + vec3(0.02), (normalEdge * color.w) * (1.0 - depthEdge));\n    }\n    vec4 fog = postParams[1];\n    float haze = smoothstep(fog.x, fog.y, centerDepth) * fog.z;\n    rgb = mix(rgb, postParams[2].xyz, haze);\n    rgb = saturated(rgb, postParams[5].x);\n    if (postParams[3].y > 0.5)\n    {\n        rgb = paletteColor(rgb);\n    }\n    fragColor = vec4(rgb, 1.0);\n    return;\n}\n",
