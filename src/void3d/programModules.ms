{\n    {\n      light = pbrAmbient(albedo, values.x, values.y, n, view, srgbToLinear(lightParams.ambient.xyz), values.z);\n    }\n  }\n  light = (light + pbrDirect(albedo, values.x, values.y, n, view, dir.xyz, sun, shadow, 0f, values.z));\n  var eye : vec3f = normalize(view);\n  var reflected : vec3f = ((-eye) - (n * (2f * dot((-eye), n))));\n  var cluster : vec4i = litClusterOf(frag, position);\n  for (var k : i32 = 0i; (k < (cluster.y + cluster.z)); k++) {\n    var i : i32 = litLightOf(cluster, k);\n    var at : vec4f = litTexelOf(i, 0i);\n    var tint : vec4f = litTexelOf(i, 1i);\n    var a : vec4f = litTexelOf(i, 2i);\n    var bb : vec4f = litTexelOf(i, 3i);\n    var cookie : vec4f = recordCookieAt(position, i);\n    if ((cookie.w > 0.5f)) {\n      var sample : vec4f = cookieSpotSample(position, at, tint);\n      var radiance : vec3f = ((srgbToLinear(tint.xyz) * cookie.xyz) * (sample.w * at.w));\n      light = (light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample.xyz, sample.xyz, radiance, recordShadowAt(position, surfaceNormal, i), 0f, values.z));\n    } else {\n      if ((a.w < 0.5f)) {\n        var toLight : vec3f = (at.xyz - position);\n        var falloff : f32 = clamp((1f - (length(toLight) / tint.w)), 0f, 1f);\n        var radiance_1 : vec3f = (srgbToLinear(tint.xyz) * ((falloff * falloff) * at.w));\n        light = (light + pbrDirect(albedo, values.x, values.y, n, view, toLight, radiance_1, recordShadowAt(position, surfaceNormal, i), 0f, values.z));\n      } else {\n        {\n          var cc : vec4f = litTexelOf(i, 4i);\n          var sample_1 : vec4f = shapedSample(position, n, at, tint, a, bb, cc, litTexelOf(i, 5i));\n          var radiance_2 : vec3f = (srgbToLinear(tint.xyz) * (sample_1.w * at.w));\n          var specular : vec3f = shapedSpecularDir(position, reflected, sample_1.xyz, at, a, bb, cc);\n          light = (light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample_1.xyz, specular, radiance_2, recordShadowAt(position, surfaceNormal, i), 0f, values.z));\n        }\n      }\n    }\n  }\n  return vec4f(linearToSrgb(light), surfaceColor.w);\n}\n\nfn toneCurved(exposed : vec3f, mode : f32) -> vec3f {\n  if ((mode == 1f)) {\n    return (exposed / (exposed + vec3f(1f)));\n  }\n  if ((mode == 2f)) {\n    var a : vec3f = (exposed * ((2.51f * exposed) + 0.03f));\n    var b : vec3f = ((exposed * ((2.43f * exposed) + 0.59f)) + 0.14f);\n    return clamp((a / b), vec3f(0f), vec3f(1f));\n  }\n  if ((mode == 3f)) {\n    var startCompression : f32 = 0.76f;\n    var desaturation : f32 = 0.15f;\n    var x : f32 = min(exposed.x, min(exposed.y, exposed.z));\n    var offset : f32 = select(0.04f, (x - ((6.25f * x) * x)), (x < 0.08f));\n    var color_1 : vec3f = (exposed - offset);\n    var peak : f32 = max(color_1.x, max(color_1.y, color_1.z));\n    if ((peak >= startCompression)) {\n      var d : f32 = (1f - startCompression);\n      var newPeak : f32 = (1f - ((d * d) / ((peak + d) - startCompression)));\n      color_1 = (color_1 * (newPeak / peak));\n      var g : f32 = (1f - (1f / ((desaturation * (peak - newPeak)) + 1f)));\n      color_1 = mix(color_1, vec3f(newPeak), g);\n    }\n    return color_1;\n  }\n  return clamp(exposed, vec3f(0f), vec3f(1f));\n}\n\nfn toneMapped(rgb : vec3f, tone : vec4f) -> vec3f {\n  if ((tone.z == 1f)) {\n    return srgbToLinear(rgb);\n  }\n  if (((tone.y == 1f) && (tone.w == 0f))) {\n    return rgb;\n  }\n  return linearToSrgb(toneCurved((srgbToLinear(rgb) * tone.y), tone.w));\n}\n\nfn litFs() {\n  var params : vec4f = materialOf();\n  var n : vec3f = facingNormal(normalize(worldNormal), params.z, frontFacing);\n  var surfaceNormal : vec3f = n;\n  var surfaceColor : vec4f = tintedSurface(baseColor);\n  var shaded : vec4f = vec4f(0f);\n  var pbrValues : vec3f = pbrOf().xyz;\n  shaded = pbrShade(n, surfaceNormal, worldPosition, fragCoord.xy, surfaceColor, pbrValues);\n  if ((shaded.w < params.w)) {\n    discard;\n  }\n  color = vec4f(toneMapped(shaded.xyz, frame