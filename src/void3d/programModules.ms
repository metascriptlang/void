	const TEXT_c3fb19eb02fcc74dfbdb7ec7c2cf69134a189cc474678fce65072c9d041c0217 = "struct PostParams {\n  edge : vec4f,\n  fog : vec4f,\n  fogColor : vec4f,\n  features : vec4f,\n  depthUnpack : vec4f,\n  colorAdjust : vec4f,\n}\n\nconst OUTLINE_OFFSETS : array<vec2i, 4> = array<vec2i, 4>(vec2i(1i, 0i), vec2i((-1i), 0i), vec2i(0i, 1i), vec2i(0i, (-1i)));\n\n@binding(0) @group(0) var<uniform> postParams : PostParams;\n\n@binding(0) @group(1) var colorTexture : texture_2d<f32>;\n\n@binding(1) @group(1) var normalTexture : texture_2d<f32>;\n\n@binding(2) @group(1) var depthTexture : texture_2d<f32>;\n\n@binding(3) @group(1) var paletteTexture : texture_2d<f32>;\n\nvar<private> position : vec4f;\n\nvar<private> fragColor : vec4f;\n\nfn postNormalAt(p : vec2i, size : vec2i) -> vec4f {\n  return textureLoad(normalTexture, clamp(p, vec2i(0i, 0i), (size - vec2i(1i, 1i))), 0i);\n}\n\nfn postDepthAt(normal : vec4f, p : vec2i, size : vec2i) -> f32 {\n  var depth : f32 = normal.w;\n  if ((postParams.features.z > 0.5f)) {\n    var q : vec2i = clamp(p, vec2i(0i, 0i), (size - vec2i(1i, 1i)));\n    var stored : f32 = textureLoad(depthTexture, q, 0i).x;\n    depth = ((stored * postParams.depthUnpack.x) + postParams.depthUnpack.y);\n  }\n  return depth;\n}\n\nfn saturated(rgb : vec3f, amount : f32) -> vec3f {\n  if ((amount == 0f)) {\n    return rgb;\n  }\n  var luma : f32 = dot(rgb, vec3f(0.212671f, 0.71516f, 0.072169f));\n  var keep : f32 = (amount + 1f);\n  return ((rgb * keep) + vec3f((luma * (1f - keep))));\n}\n\nfn paletteColor(rgb : vec3f) -> vec3f {\n  var levels : i32 = i32(postParams.features.w);\n  var q : vec3i = vec3i(((clamp(rgb, vec3f(0f), vec3f(1f)) * f32((levels - 1i))) + 0.5f));\n  return textureLoad(paletteTexture, vec2i((q.x + (q.z * levels)), q.y), 0i).xyz;\n}\n\nfn postFs() {\n  var size : vec2i = vec2i(textureDimensions(colorTexture, 0i));\n  var p : vec2i = vec2i(position.xy);\n  var color : vec4f = textureLoad(colorTexture, p, 0i);\n  var center : vec4f = postNo