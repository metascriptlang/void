	const TEXT_b1d3e5ac4463a4cebea5b81b797485c7b23bee4b25d7f27ed85944b6fc48f806 = "diagnostic(off, derivative_uniformity);\n\nstruct MovingUnlitMaterialParams {\n  material : vec4f,\n  materialColor : vec4f,\n  uvMatrix : vec4f,\n  uvMotion : vec4f,\n  backUvMatrix : vec4f,\n  backUvOffset : vec4f,\n  dissolve : vec4f,\n  dissolveEdge : vec4f,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\n@binding(3) @group(0) var<uniform> movingUnlitMaterialParams : MovingUnlitMaterialParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(2) @group(1) var dissolveTexture : texture_2d<f32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\n@binding(33) @group(1) var dissolveSampler : sampler;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> color : vec4f;\n\nvar<private> normal : vec4f;\n\nfn materialOf() -> vec4f {\n  return movingUnlitMaterialParams.material;\n}\n\nfn straightTexel(texel : vec4f) -> vec4f {\n  return select(vec4f(0f), vec4f((texel.xyz / texel.w), texel.w), (texel.w > 0f));\n}\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (srgb.x <= 0.04045f)), select(high.y, low.y, (srgb.y <= 0.04045f)), select(high.z, low.z, (srgb.z <= 0.04045f)));\n}\n\nfn linearToSrgb(rgb : vec3f) -> vec3f {\n  var low : vec3f = (rgb * 12.92f);\n  var high : vec3f = ((vec3f(1.055f) * pow(max(rgb, vec3f(0f)), vec3f(0.41666f))) - vec3f(0.055f));\n  return vec3f(select(high.x, low.x, (rgb.x <= 0.0031308f)), select(high.y, low.y, (rgb.y <= 0.0031308f)), select(high.z, low.z, (rgb.z <= 0.0031308f)));\n}\n\nfn unlitShade(texel : vec4f, baseColor_1 : vec4f, materialC