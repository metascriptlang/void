	const TEXT_469561efb7fc87515143fc128d44dcf5900ff57e20d249f70a615640fb4579f5 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform highp vec4 pbrMaterialParams[4];\nuniform highp vec4 frameParams[3];\nuniform highp vec4 lightParams[27];\nuniform highp samplerCube envDiffuse_envSampler;\nuniform highp samplerCube envSpecular_envSampler;\n\nin highp vec3 worldPosition;\nin highp vec3 worldNormal;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\n\nhighp vec4 materialOf()\n{\n    return pbrMaterialParams[0];\n}\n\nhighp vec3 facingNormal(highp vec3 normal, highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal) : normal;\n}\n\nhighp vec4 pbrOf()\n{\n    return pbrMaterialParams[1];\n}\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 envTurned(highp vec3 d, highp vec4 turn)\n{\n    return vec3((d.x * turn.z) - (d.z * turn.w), d.y, (d.x * turn.w) + (d.z * turn.z));\n}\n\nhighp vec2 splitSum(highp float roughness, highp float nv)\n{\n    highp float rx = 1.0 - roughness;\n    highp float ry = 0.0425 - (0.0275 * roughness);\n    highp float a004 = (min(rx * rx, exp2((-9.28) * nv)) * rx) + ry;\n    return max(vec2((((-1.04) * a004) + 1.04) - (0.572 * roughness), ((1.04 * a004) - 0.04) + (0.022 * roughness)), vec2(0.00005));\n}\n\nhighp vec3 pbrEnvironmentLight(highp vec3 albedo, highp float metalness, highp float r