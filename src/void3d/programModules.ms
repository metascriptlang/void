.xyz);\n    surface = surface * srgbToLinear(texel.xyz);\n    return vec4(linearToSrgb(surface), (baseColor_1.w * materialColor.w) * texel.w);\n}\n\nvoid main()\n{\n    mat4 matrix = instanceWorld(instanceRow0, instanceRow1, instanceRow2);\n    vec4 shape = lineParams[0];\n    vec4 depthRange = lineParams[1];\n    vec3 direction = mat3(matrix) * normal;\n    vec4 root = matrix * vec4(position, 1.0);\n    vec3 world = root.xyz + (direction * (uv.x * shape.y));\n    vec4 clip = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    vec2 across = lineScreenDirection(direction, vertexParams[4], vertexParams[5]);\n    float depth = lineViewDepth(clip.z / clip.w, depthRange.x, depthRange.y);\n    vec2 offset = lineClipOffset(across, uv.y, depth, shape.zw, shape.x);\n    vec4 color_1 = color * instanceColor;\n    baseColor = unlitShade(vec4(1.0, 1.0, 1.0, 1.0), color_1, lineParams[2]);\n    gl_Position = vec4(clip.xy + offset, clip.z, clip.w);\n    return;\n}\n";
