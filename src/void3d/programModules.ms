postNormalAt(p, size);\n    highp float centerDepth = postDepthAt(center, p, size);\n    highp vec4 edge = postParams[0];\n    highp vec3 rgb = color.xyz;\n    if (postParams[3].x > 0.5)\n    {\n        highp vec3 n = (center.xyz * 2.0) - 1.0;\n        highp float depthEdge = 0.0;\n        highp float normalEdge = 0.0;\n        for (highp int i = 0; i < 4; i++)\n        {\n            highp vec4 neighbor = postNormalAt(p + OUTLINE_OFFSETS[i], size);\n            highp float depthDelta = postDepthAt(neighbor, p + OUTLINE_OFFSETS[i], size) - centerDepth;\n            if (depthDelta > edge.x)\n            {\n                depthEdge = 1.0;\n            }\n            highp vec3 nq = (neighbor.xyz * 2.0) - 1.0;\n            if (((abs(depthDelta) < edge.x) && (dot(n, nq) < edge.y)) && (n.y > (nq.y + 0.1)))\n            {\n                normalEdge = 1.0;\n            }\n        }\n        rgb = mix(rgb, rgb * edge.z, depthEdge * color.w);\n        rgb = mix(rgb, (rgb * edge.w) + vec3(0.02), (normalEdge * color.w) * (1.0 - depthEdge));\n    }\n    highp vec4 fog = postParams[1];\n    highp float haze = smoothstep(fog.x, fog.y, centerDepth) * fog.z;\n    rgb = mix(rgb, postParams[2].xyz, haze);\n    rgb = saturated(rgb, postParams[5].x);\n    if (postParams[3].y > 0.5)\n    {\n        rgb = paletteColor(rgb);\n    }\n    fragColor = vec4(rgb, 1.0);\n    return;\n}\n";
