exposed * ((2.43f * exposed) + 0.59f)) + 0.14f);\n    return clamp((a / b), vec3f(0f), vec3f(1f));\n  }\n  if ((mode == 3f)) {\n    var startCompression : f32 = 0.76f;\n    var desaturation : f32 = 0.15f;\n    var x : f32 = min(exposed.x, min(exposed.y, exposed.z));\n    var offset : f32 = select(0.04f, (x - ((6.25f * x) * x)), (x < 0.08f));\n    var color_1 : vec3f = (exposed - offset);\n    var peak : f32 = max(color_1.x, max(color_1.y, color_1.z));\n    if ((peak >= startCompression)) {\n      var d : f32 = (1f - startCompression);\n      var newPeak : f32 = (1f - ((d * d) / ((peak + d) - startCompression)));\n      color_1 = (color_1 * (newPeak / peak));\n      var g : f32 = (1f - (1f / ((desaturation * (peak - newPeak)) + 1f)));\n      color_1 = mix(color_1, vec3f(newPeak), g);\n    }\n    return color_1;\n  }\n  return clamp(exposed, vec3f(0f), vec3f(1f));\n}\n\nfn toneMapped(rgb : vec3f, tone : vec4f) -> vec3f {\n  if ((tone.z == 1f)) {\n    return srgbToLinear(rgb);\n  }\n  if (((tone.y == 1f) && (tone.w == 0f))) {\n    return rgb;\n  }\n  return linearToSrgb(toneCurved((srgbToLinear(rgb) * tone.y), tone.w));\n}\n\nfn litFs() {\n  var params : vec4f = materialOf();\n  var n : vec3f = facingNormal(normalize(worldNormal), params.z, frontFacing);\n  var shaded : vec4f = litShade(n, worldPosition, baseColor);\n  color = vec4f(toneMapped(shaded.xyz, frameParams.frame), shaded.w);\n  return;\n}\n\nstruct main_out {\n  @location(0) color : vec4f,\n}\n\n@fragment\nfn main(@location(0) worldPosition_param : vec3f, @location(1) worldNormal_param : vec3f, @location(2) baseColor_param : vec4f, @builtin(front_facing) frontFacing_param : bool) -> main_out {\n  worldPosition = worldPosition_param;\n  worldNormal = worldNormal_param;\n  baseColor = baseColor_param;\n  frontFacing = frontFacing_param;\n  litFs();\n  return main_out(color);\n}\n",
