	const TEXT_e0cf3af68a2e25a9178de741d8b3c25b0154a865bf0e1be64bdb2535a169f9e2 = "diagnostic(off, derivative_uniformity);\n\nstruct MaterialParams {\n  material : vec4f,\n  materialColor : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  clusterGrid : vec4f,\n  clusterFactors : vec4f,\n  clusterView : vec4f,\n  clusterScreen : vec4f,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nconst DATA_ROW : u32 = 256u;\n\nconst RECORD_TEXELS : i32 = 6i;\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> materialParams : MaterialParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(9) @group(1) var lightRecords : texture_2d<f32>;\n\n@binding(10) @group(1) var clusterRecords : texture_2d<u32>;\n\n@binding(11) @group(1) var clusterIndices : texture_2d<u32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> fragCoord : vec4f;\n\nvar<private> color : vec4f;\n\nfn materialOf() -> vec4f {\n  return materialParams.material;\n}\n\nfn facingNormal(normal : vec3f, doubleSided : f32, frontFacing_1 : bool) -> vec3f {\n  return select(normal, (-normal), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn materialColorOf() -> vec4f {\n  return materialParams.materialColor;\n}\n\nfn tintedSurface(color_1 : vec4f) -> vec4f {\n  return (color_1 * materialColorOf());\n}\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (srgb.x <= 0.04045f)), select(high.y, low.y, (srgb.y <= 0.04