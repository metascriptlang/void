	const TEXT_7ee1ddf29adb07a44924f6a8063a54599538e0385806ecaa251fbc2453d2395e = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nconst highp uint DATA_ROW = 256u;\nconst highp int RECORD_TEXELS = 6;\n\nuniform highp vec4 movingMaterialParams[8];\nuniform highp vec4 lightParams[12];\nuniform highp vec4 frameParams[3];\nuniform highp sampler2D baseTexture_baseSampler;\nuniform highp sampler2D backTexture_baseSampler;\nuniform highp sampler2D lightRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterIndices_SPIRV_Cross_DummySampler;\nuniform highp sampler2D cookieTexture_cookieSampler;\n\nin highp vec3 worldPosition;\nin highp vec3 worldNormal;\nin highp vec2 surfaceUv;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\nlayout(location = 1) out highp vec4 normal;\n\nhighp vec4 materialOf()\n{\n    return movingMaterialParams[0];\n}\n\nhighp vec2 backUv(highp vec2 uv, highp vec4 matrix, highp vec4 offset)\n{\n    return (mat2(matrix.xy, matrix.zw) * uv) + offset.xy;\n}\n\nhighp vec4 backUvMatrixOf()\n{\n    return movingMaterialParams[4];\n}\n\nhighp vec4 backUvOffsetOf()\n{\n    return movingMaterialParams[5];\n}\n\nhighp vec3 facingNormal(highp vec3 normal_1, highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal_1) : normal_1;\n}\n\nhighp vec4 materialColorOf()\n{\n    return movingMaterialParams[1];\n}\n\nhighp vec4 tintedSurface(highp vec4 color_1)\n{\n    return color_1 * materialColorOf();\n}\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp int cellOf(highp float position, highp int cells)\n{\n    if (!(position > 0.