posed.z));\n    var offset : f32 = select(0.04f, (x - ((6.25f * x) * x)), (x < 0.08f));\n    var color : vec3f = (exposed - offset);\n    var peak : f32 = max(color.x, max(color.y, color.z));\n    if ((peak >= startCompression)) {\n      var d : f32 = (1f - startCompression);\n      var newPeak : f32 = (1f - ((d * d) / ((peak + d) - startCompression)));\n      color = (color * (newPeak / peak));\n      var g : f32 = (1f - (1f / ((desaturation * (peak - newPeak)) + 1f)));\n      color = mix(color, vec3f(newPeak), g);\n    }\n    return color;\n  }\n  return clamp(exposed, vec3f(0f), vec3f(1f));\n}\n\nfn toneMapped(rgb : vec3f, tone : vec4f) -> vec3f {\n  if ((tone.z == 1f)) {\n    return srgbToLinear(rgb);\n  }\n  if (((tone.y == 1f) && (tone.w == 0f))) {\n    return rgb;\n  }\n  return linearToSrgb(toneCurved((srgbToLinear(rgb) * tone.y), tone.w));\n}\n\nfn decalFs() {\n  var ndc : vec2f = (screen.xy / screen.w);\n  var ndcDx : vec2f = dpdx(ndc);\n  var ndcDy : vec2f = dpdy(ndc);\n  var pixel : vec2i = vec2i(fragCoord.xy);\n  var toLocal : mat4x4f = mat4x4f(screenToLocal0, screenToLocal1, screenToLocal2, screenToLocal3);\n  var local : vec3f = decalLocalAtPixel(pixel, ndc, toLocal);\n  if (outsideDecal(local)) {\n    discard;\n  }\n  var fade : vec4f = decalParams.decalFade;\n  var mode : vec4f = decalParams.decalMode;\n  var faded : f32 = decalFade(local.z, fade.x, fade.y, fade.z);\n  var normalFade : vec4f = decalParams.decalNormalFade;\n  if ((normalFade.z == 1f)) {\n    var world : mat4x4f = mat4x4f(boxWorld0, boxWorld1, boxWorld2, boxWorld3);\n    var last : vec2i = (vec2i(textureDimensions(sceneDepth, 0i)) - vec2i(1i, 1i));\n    var right : vec2i = clamp((pixel + vec2i(1i, 0i)), vec2i(0i, 0i), last);\n    var below : vec2i = clamp((pixel + vec2i(0i, 1i)), vec2i(0i, 0i), last);\n    var alongX : vec3f = decalLocalAtPixel(right, (ndc + ndcDx), toLocal);\n    var alongY : vec3f = decalLocalAtPixel(below, (ndc + ndcDy), toLocal);\n    var normal : vec3f = decalSur