(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 params = materialOf();\n    highp vec2 uv = surfaceUv;\n    highp vec4 texel = texture(baseTexture_baseSampler, uv);\n    highp float noise = 0.0;\n    highp vec3 n = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    highp vec4 surfaceColor = vec4(baseColor.xyz * texel.xyz, baseColor.w * texel.w);\n    highp vec4 shaded = vec4(0.0);\n    shaded = litShade(n, worldPosition, surfaceColor);\n    highp vec4 color_1 = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    color = color_1;\n    return;\n}\n";
