uration * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 color_1 = particleColor;\n    color = vec4(toneMapped(color_1.xyz, frameParams[0]), color_1.w);\n    normal = vec4(0.5, 1.0, 0.5, depth01);\n    return;\n}\n";
	const TEXT_b7cb514e6d48021a39554f207516ddee54cb220251d330df48798874461dde7b = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform highp vec4 frameParams[3];\n\nin highp vec4 particleColor;\nin highp float depth01;\nlayout(location = 0) out highp vec4 color;\nlayout(location = 1) out highp vec4 normal;\n\nbool demoted = false;\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n        highp float desaturation = 0.15;\n        highp float x = min(exposed.x, min(exposed.y, exposed.z));\n        highp float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        highp vec3 color_1 = exposed - offset;\n        highp float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            highp float d = 1.0 - startCompression;\n            highp float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            highp float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 color_1 = particleColor;\n    if (color_1.w < 0.5)\n    {\n        demoted = true;\n    }\n    color_1 = vec4(color_1.xyz, 0.0);\n    color = vec4(toneMapped(color_1.xyz, frameParams[0]), color_1.w);\n    normal = vec4(0.5, 1.0, 0.5, depth01);\n    if (demoted)\n    {\n        discard;\n    }\n    return;\n}\n";
	const TEXT_e11d396b17fba69e724a51714e497261ae0a2d0f42e6fe927a5159aa1d24ca80 = "#version 300 es\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec2 size;\nlayout(location = 2) in vec2 anchor;\nlayout(location = 3) in vec4 tile;\nlayout(location = 4) in vec4 color;\nout vec2 uv;\nout vec3 rootPosition;\nout vec4 instanceColor;\nout float depth01;\n\nvec3 billboardPoint(vec3 position_1, vec2 size_1, vec2 anchor_1, vec2 corner, vec3 right, vec3 up)\n{\n    vec2 offset = corner - anchor_1;\n    return (position_1 + (right * (offset.x * size_1.x))) + (up * (offset.y * size_1.y));\n}\n\nvoid main()\n{\n    vec2 corner = PARTICLE_CORNERS[uint(gl_VertexID) % 6u];\n    vec3 world = billboardPoint(position, size, anchor, corner, vertexParams[4].xyz, vertexParams[5].xyz);\n    vec4 clip = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    uv = vec2((corner.x > 0.0) ? tile.z : tile.x, (corner.y > 0.0) ? tile.y : tile.w);\n    rootPosition = position;\n    instanceColor = color;\n    depth01 = clip.z;\n    gl_Position = clip;\n    return;\n}\n";
