cular(albedo, metalness, roughness, normal, view, light, light, radiance, shadow, occlusionFactor, occlusion);\n}\n\nfn lightWindow(distance_1 : f32, range : f32) -> f32 {\n  var window : f32 = clamp((1f - (distance_1 / range)), 0f, 1f);\n  return (window * window);\n}\n\nfn capsuleSample(position : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f) -> vec4f {\n  var start : vec3f = (at.xyz - (a.xyz * b.x));\n  var segment : vec3f = (a.xyz * (2f * b.x));\n  var along : f32 = clamp((dot((position - start), segment) / dot(segment, segment)), 0f, 1f);\n  var delta : vec3f = ((start + (segment * along)) - position);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  return vec4f((delta / distance_1), lightWindow(distance_1, tint.w));\n}\n\nfn rectanglePoint(position : vec3f, ray : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  var along : f32 = (dot(a.xyz, (at.xyz - position)) / dot(a.xyz, ray));\n  var offset : vec3f = ((position + (ray * along)) - at.xyz);\n  return ((at.xyz + (b.xyz * clamp(dot(offset, b.xyz), (-b.w), b.w))) + (c.xyz * clamp(dot(offset, c.xyz), (-c.w), c.w)));\n}\n\nfn rectangleAxisCone(delta : vec3f, forward : vec3f, excluded : vec3f, outer : f32, inner : f32) -> f32 {\n  var projectedDelta : vec3f = (delta - (excluded * dot(delta, excluded)));\n  var projectedLight : vec3f = ((-forward) - (excluded * dot((-forward), excluded)));\n  var deltaLength : f32 = length(projectedDelta);\n  var lightLength : f32 = length(projectedLight);\n  if (((deltaLength < 0.0001f) || (lightLength < 0.0001f))) {\n    return 0f;\n  }\n  var theta : f32 = (dot(projectedDelta, projectedLight) / (deltaLength * lightLength));\n  return clamp(((theta - outer) / ((inner - outer) + 0.00001f)), 0f, 1f);\n}\n\nfn rectangleSample(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec4f {\n  if ((abs(dot(a.xyz, normal)) < 0.000001f)) {\n    return vec