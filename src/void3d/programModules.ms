	const TEXT_75bd4375da7c0866e73044750fdbdcc6d9fa314198e326d9588b50c4d7584725 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nconst highp uint DATA_ROW = 256u;\nconst highp int RECORD_TEXELS = 6;\n\nuniform highp vec4 pbrMaterialParams[5];\nuniform highp vec4 frameParams[3];\nuniform highp vec4 lightParams[7];\nuniform highp sampler2D baseTexture_baseSampler;\nuniform highp sampler2D normalTexture_baseSampler;\nuniform highp samplerCube envDiffuse_envSampler;\nuniform highp samplerCube envSpecular_envSampler;\nuniform highp sampler2D lightRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterIndices_SPIRV_Cross_DummySampler;\n\nin highp vec4 worldTangent;\nin highp vec3 worldPosition;\nin highp vec3 worldNormal;\nin highp vec2 surfaceUv;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\n\nhighp vec4 materialOf()\n{\n    return pbrMaterialParams[0];\n}\n\nhighp vec2 movedUv(highp vec2 uv, highp vec4 matrix, highp vec4 motion, highp float time)\n{\n    return ((mat2(matrix.xy, matrix.zw) * uv) + motion.xy) + (motion.zw * time);\n}\n\nhighp vec4 uvMatrixOf()\n{\n    return pbrMaterialParams[3];\n}\n\nhighp vec4 uvMotionOf()\n{\n    return pbrMaterialParams[4];\n}\n\nhighp vec3 facingNormal(highp vec3 normal, highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal) : normal;\n}\n\nhighp float faceOf(highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-1.0) : 1.0;\n}\n\nhighp vec3 mappedNormal(highp vec3 normal, highp vec4 tangent, highp float face, highp vec3 texel)\n{\n    highp vec3 t = normalize(tangent.xyz);\n    highp float sign_1 = (tangent.w < 0.0) ? (-1.0) : 1.0;\n    highp vec3 bitangent = normalize(cross(normal, t)) * sign_1;\n    highp vec3 mapped = (texel * 2.0) - 1.0;\n    return normalize(((mapped.x * t) + (mapped.y * bitangent)) + (mappe