	const TEXT_c3fb19eb02fcc74dfbdb7ec7c2cf69134a189cc474678fce65072c9d041c0217 = "struct PostParams {\n  edge : vec4f,\n  fog : vec4f,\n  fogColor : vec4f,\n  features : vec4f,\n  depthUnpack : vec4f,\n  colorAdjust : vec4f,\n}\n\nconst OUTLINE_OFFSETS : array<vec2i, 4> = array<vec2i, 4>(vec2i(1i, 0i), vec2i((-1i), 0i), vec2i(0i, 1i), vec2i(0i, (-1i)));\n\n@binding(0) @group(0) var<uniform> postParams : PostParams;\n\n@binding(0) @group(1) var colorTexture : texture_2d<f32>;\n\n@binding(1) @group(1) var normalTexture : texture_2d<f32>;\n\n@binding(2) @group(1) var depthTexture : texture_2d<f32>;\n\n@binding(3) @group(1) var paletteTexture : texture_2d<f32>;\n\nvar<private> position : vec4f;\n\nvar<private> fragColor : vec4f;\n\nfn postNormalAt(p : vec2i, size : vec2i) -> vec4f {\n  return textureLoad(normalTexture, clamp(p, vec2i(0i, 0i), (size - vec2i(1i, 1i))), 0i);\n}\n\nfn postDepthAt(normal : vec4f, p : vec2i, size : vec2i) -> f32 {\n  var depth : f32 = normal.w;\n  if ((postParams.features.z > 0.5f)) {\n    var q : vec2i = clamp(p, vec2i(0i, 0i), (size - vec2i(1i, 1i)));\n    var stored : f32 = textureLoad(depthTexture, q, 0i).x;\n    depth = ((stored * postParams.depthUnpack.x) + postParams.depthUnpack.y);\n  }\n  return depth;\n}\n\nfn saturated(rgb : vec3f, amount : f32) -> vec3f {\n  if ((amount == 0f)) {\n    return rgb;\n  }\n  var luma : f32 = dot(rgb, vec3f(0.212671f, 0.71516f, 0.072169f));\n  var keep : f32 = (amount + 1f);\n  return ((rgb * keep) + vec3f((luma * (1f - keep))));\n}\n\nfn paletteColor(rgb : vec3f) -> vec3f {\n  var levels : i32 = i32(postParams.features.w);\n  var q : vec3i = vec3i(((clamp(rgb, vec3f(0f), vec3f(1f)) * f32((levels - 1i))) + 0.5f));\n  return textureLoad(paletteTexture, vec2i((q.x + (q.z * levels)), q.y), 0i).xyz;\n}\n\nfn postFs() {\n  var size : vec2i = vec2i(textureDimensions(colorTexture, 0i));\n  var p : vec2i = vec2i(position.xy);\n  var color : vec4f = textureLoad(colorTexture, p, 0i);\n  var center : vec4f = postNormalAt(p, size);\n  var centerDepth : f32 = postDepthAt(center, p, size);\n  var edge : vec4f = postParams.edge;\n  var rgb : vec3f = color.xyz;\n  if ((postParams.features.x > 0.5f)) {\n    var n : vec3f = ((center.xyz * 2f) - 1f);\n    var depthEdge : f32 = 0f;\n    var normalEdge : f32 = 0f;\n    for (var i : i32 = 0i; (i < 4i); i++) {\n      var neighbor : vec4f = postNormalAt((p + OUTLINE_OFFSETS[i]), size);\n      var depthDelta : f32 = (postDepthAt(neighbor, (p + OUTLINE_OFFSETS[i]), size) - centerDepth);\n      if ((depthDelta > edge.x)) {\n        depthEdge = 1f;\n      }\n      var nq : vec3f = ((neighbor.xyz * 2f) - 1f);\n      if ((((abs(depthDelta) < edge.x) && (dot(n, nq) < edge.y)) && (n.y > (nq.y + 0.1f)))) {\n        normalEdge = 1f;\n      }\n    }\n    rgb = mix(rgb, (rgb * edge.z), (depthEdge * color.w));\n    rgb = mix(rgb, ((rgb * edge.w) + vec3f(0.02f)), ((normalEdge * color.w) * (1f - depthEdge)));\n  }\n  var fog : vec4f = postParams.fog;\n  var haze : f32 = (smoothstep(fog.x, fog.y, centerDepth) * fog.z);\n  rgb = mix(rgb, postParams.fogColor.xyz, haze);\n  rgb = saturated(rgb, postParams.colorAdjust.x);\n  if ((postParams.features.y > 0.5f)) {\n    rgb = paletteColor(rgb);\n  }\n  fragColor = vec4f(rgb, 1f);\n  return;\n}\n\nstruct main_out {\n  @location(0) fragColor : vec4f,\n}\n\n@fragment\nfn main(@builtin(position) position_param : vec4f) -> main_out {\n  position = position_param;\n  postFs();\n  return main_out(fragColor);\n}\n";
	const TEXT_1df6a35a81dac29497a692a06afce7b714345b3759debcee76322a008b7487a5 = "struct BlitParams {\n  pixel : vec4f,\n}\n\n@binding(0) @group(0) var<uniform> blitParams : BlitParams;\n\n@binding(0) @group(1) var sceneTexture : texture_2d<f32>;\n\nvar<private> position : vec4f;\n\nvar<private> fragColor : vec4f;\n\nfn blitFs() {\n  var size : vec2i = vec2i(textureDimensions(sceneTexture, 0i));\n  var p : vec2i = vec2i(floor(((position.xy + blitParams.pixel.zw) / blitParams.pixel.x)));\n  var texel : vec4f = textureLoad(sceneTexture, clamp(p, vec2i(0i, 0i), (size - vec2i(1i, 1i))), 0i);\n  fragColor = vec4f(texel.xyz, 1f);\n  return;\n}\n\nstruct main_out {\n  @location(0) fragColor : vec4f,\n}\n\n@fragment\nfn main(@builtin(position) position_param : vec4f) -> main_out {\n  position = position_param;\n  blitFs();\n  return main_out(fragColor);\n}\n";
	const TEXT_af269d50aac44a395892ffba1a45aef8609bd09332e8e0712b0b1bb2e5f76b7a = "struct VertexParams {\n  viewProj : mat4x4f,\n  cameraRight : vec4f,\n  cameraUp : vec4f,\n  cameraPosition : vec4f,\n}\n\n@binding(0) @group(0) var<uniform> vertexParams : VertexParams;\n\nvar<private> position : vec3f;\n\nvar<private> normal : vec3f;\n\nvar<private> uv : vec2f;\n\nvar<private> color : vec4f;\n\nvar<private> instanceRow0 : vec4f;\n\nvar<private> instanceRow1 : vec4f;\n\nvar<private> instanceRow2 : vec4f;\n\nvar<private> instanceColor : vec4f;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> clip : vec4f;\n\nfn upperLeft3x3(m : mat4x4f) -> mat3x3f {\n  return mat3x3f(m[0].xyz, m[1].xyz, m[2].xyz);\n}\n\nfn skinNormal(world : mat4x4f, normal_1 : vec3f) -> vec3f {\n  var linear : mat3x3f = upperLeft3x3(world);\n  var a : vec3f = cross(linear[1i], linear[2i]);\n  var b : vec3f = cross(linear[2i], linear[0i]);\n  var c : vec3f = cross(linear[0i], linear[1i]);\n  var direction : f32 = select(1f, (-1f), (dot(linear[0i], a) < 0f));\n  return ((((a * normal_1.x) + (b * normal_1.y)) + (c * normal_1.z)) * direction);\n}\n\nfn instanceWorld(row0 : vec4f, row1 : vec4f, row2 : vec4f) -> mat4x4f {\n  return transpose(mat4x4f(row0, row1, row2, vec4f(0f, 0f, 0f, 1f)));\n}\n\nfn litTexturedVs() {\n  var matrix_1 : mat4x4f = instanceWorld(instanceRow0, instanceRow1, instanceRow2);\n  var world_1 : vec4f = (matrix_1 * vec4f(position, 1f));\n  worldPosition = world_1.xyz;\n  worldNormal = skinNormal(matrix_1, normal);\n  surfaceUv = uv;\n  baseColor = (color * instanceColor);\n  clip = (vertexParams.viewProj * world_1);\n  return;\n}\n\nstruct main_out {\n  @location(0) worldPosition : vec3f,\n  @location(1) worldNormal : vec3f,\n  @location(2) surfaceUv : vec2f,\n  @location(3) baseColor : vec4f,\n  @builtin(position) clip : vec4f,\n}\n\n@vertex\nfn main(@location(0) position_pa