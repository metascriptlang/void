	const TEXT_e11d396b17fba69e724a51714e497261ae0a2d0f42e6fe927a5159aa1d24ca80 = "#version 300 es\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec2 size;\nlayout(location = 2) in vec2 anchor;\nlayout(location = 3) in vec4 tile;\nlayout(location = 4) in vec4 color;\nout vec2 uv;\nout vec3 rootPosition;\nout vec4 instanceColor;\nout float depth01;\n\nvec3 billboardPoint(vec3 position_1, vec2 size_1, vec2 anchor_1, vec2 corner, vec3 right, vec3 up)\n{\n    vec2 offset = corner - anchor_1;\n    return (position_1 + (right * (offset.x * size_1.x))) + (up * (offset.y * size_1.y));\n}\n\nvoid main()\n{\n    vec2 corner = PARTICLE_CORNERS[uint(gl_VertexID) % 6u];\n    vec3 world = billboardPoint(position, size, anchor, corner, vertexParams[4].xyz, vertexParams[5].xyz);\n    vec4 clip = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    uv = vec2((corner.x > 0.0) ? tile.z : tile.x, (corner.y > 0.0) ? tile.y : tile.w);\n    rootPosition = position;\n    instanceColor = color;\n    depth01 = clip.z;\n    gl_Position = clip;\n    return;\n}\n";
	const TEXT_2ffcaf2142d9a767b70f06ba9243fcf45f6841ca485fe945c722d3b1351b8995 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nconst highp ivec2 OUTLINE_OFFSETS[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));\n\nuniform highp vec4 postParams[6];\nuniform highp sampler2D colorTexture_SPIRV_Cross_DummySampler;\nuniform highp sampler2D normalTexture_SPIRV_Cross_DummySampler;\nuniform highp sampler2D depthTexture_SPIRV_Cross_DummySampler;\nuniform highp sampler2D paletteTexture_SPIRV_Cross_DummySampler;\n\nlayout(location = 0) out highp vec4 fragColor;\n\nhighp vec4 postNormalAt(highp ivec2 p, highp ivec2 size)\n{\n    return texelFetch(normalTexture_SPIRV_Cross_DummySampler, clamp(p, ivec2(0, 0), size - ivec2(1, 1)), 0);\n}\n\nhighp float postDepthAt(highp vec4 normal, highp ivec2 p, highp ivec2 size)\n{\n    highp float depth = normal.w;\n    if (postParams[3].z > 0.5)\n    {\n        highp ivec2 q = clamp(p, ivec2(0, 0), size - ivec2(1, 1));\n        highp float stored = texelFetch(depthTexture_SPIRV_Cross_DummySampler, q, 0).x;\n        depth = (stored * postParams[4].x) + postParams[4].y;\n    }\n    return depth;\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 paletteColor(highp vec3 rgb)\n{\n    highp int levels = int(postParams[3].w);\n    highp ivec3 q = ivec3((clamp(rgb, vec3(0.0), vec3(1.0)) * float(levels - 1)) + 0.5);\n    return texelFetch(paletteTexture_SPIRV_Cross_DummySampler, ivec2(q.x + (q.z * levels), q.y), 0).xyz;\n}\n\nvoid main()\n{\n    highp ivec2 size = textureSize(colorTexture_SPIRV_Cross_DummySampler, 0);\n    highp ivec2 p = ivec2(gl_FragCoord.xy);\n    highp vec4 color = texelFetch(colorTexture_SPIRV_Cross_DummySampler, p, 0);\n    highp vec4 center = postNormalAt(p, size);\n    highp float centerDepth = postDepthAt(center, p, size);\n    highp vec4 edge = postParams[0];\n    highp vec3 rgb = color.xyz;\n    if (postParams[3].x > 0.5)\n    {\n        highp vec3 n = (center.xyz * 2.0) - 1.0;\n        highp float depthEdge = 0.0;\n        highp float normalEdge = 0.0;\n        for (highp int i = 0; i < 4; i++)\n        {\n            highp vec4 neighbor = postNormalAt(p + OUTLINE_OFFSETS[i], size);\n            highp float depthDelta = postDepthAt(neighbor, p + OUTLINE_OFFSETS[i], size) - centerDepth;\n            if (depthDelta > edge.x)\n            {\n                depthEdge = 1.0;\n            }\n            highp vec3 nq = (neighbor.xyz * 2.0) - 1.0;\n            if (((abs(depthDelta) < edge.x) && (dot(n, nq) < edge.y)) && (n.y > (nq.y + 0.1)))\n            {\n                normalEdge = 1.0;\n            }\n        }\n        rgb = mix(rgb, rgb * edge.z, depthEdge * color.w);\n        rgb = mix(rgb, (rgb * edge.w) + vec3(0.02), (normalEdge * color.w) * (1.0 - depthEdge));\n    }\n    highp vec4 fog = postParams[1];\n    highp float haze = smoothstep(fog.x, fog.y, centerDepth) * fog.z;\n    rgb = mix(rgb, postParams[2].xyz, haze);\n    rgb = saturated(rgb, postParams[5].x);\n    if (postParams[3].y > 0.5)\n    {\n        rgb = paletteColor(rgb);\n    }\n    fragColor = vec4(rgb, 1.0);\n    return;\n}\n";
