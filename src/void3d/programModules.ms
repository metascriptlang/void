          light = light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample_1.xyz, specular, radiance_1, recordShadowAt(position, surfaceNormal, i), 0.0, values.z);\n            }\n        }\n    }\n    return vec4(linearToSrgb(light), surfaceColor.w);\n}\n\nhighp vec4 emittedOver(highp vec4 color_1, highp vec3 texel, highp vec4 emissive)\n{\n    highp vec3 emitted = (srgbToLinear(emissive.xyz) * srgbToLinear(texel)) * emissive.w;\n    return vec4(linearToSrgb(srgbToLinear(color_1.xyz) + emitted), color_1.w);\n}\n\nhighp vec4 emissiveOf()\n{\n    return pbrEmissiveMaterialParams[5];\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n        highp float desaturation = 0.15;\n        highp float x = min(exposed.x, min(exposed.y, exposed.z));\n        highp float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        highp vec3 color_1 = exposed - offset;\n        highp float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            highp float d = 1.0 - startCompression;\n            highp float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            highp float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 params = materialOf();\n    highp vec2 uv = surfaceUv;\n    highp float time = frameParams[0].x;\n    uv = movedUv(surfaceUv, uvMatrixOf(), uvMotionOf(), time);\n    highp vec3 view = normalize(frameParams[1].xyz - worldPosition);\n    uv = parallaxUv(uv, view, normalize(worldNormal), worldTangent, materialOf().x);\n    highp vec4 texel = texture(baseTexture_baseSampler, uv);\n    highp float noise = 0.0;\n    highp vec3 surfaceNormal = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    highp vec3 n = surfaceNormal;\n    highp vec3 normalTexel = texture(normalTexture_baseSampler, uv).xyz;\n    highp float face = faceOf(params.z, gl_FrontFacing);\n    n = mappedNormal(normalize(worldNormal), worldTangent, face, normalTexel);\n    highp vec4 surfaceColor = tintedSurface(vec4(baseColor.xyz * texel.xyz, baseColor.w * texel.w));\n    highp vec4 shaded = vec4(0.0);\n    highp vec3 pbrValues = pbrOf().xyz;\n    highp vec2 occlusionUv = uv;\n    occlusionUv = movedUv(surfaceUvB, uvMatrixOf(), uvMotionOf(), frameParams[0].x);\n    pbrValues = pbrMapped(uv, occlusionUv);\n    shaded = pbrShade(n, surfaceNormal, worldPosition, gl_FragCoord.xy, surfaceColor, pbrValues);\n    highp vec3 glow = texture(emissiveTexture_baseSampler, uv).xyz;\n    shaded = emittedOver(shaded, glow, emissiveOf());\n    if (shaded.w < params.w)\n    {\n        demoted = true;\n    }\n    highp vec4 color_1 = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    color = color_1;\n    if (demoted)\n    {\n        discard;\n    }\n    return;\n}\n";

