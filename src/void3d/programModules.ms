llOf(cell.x, columns);\n    highp int y = cellOf(cell.y, int(grid.y + 0.5));\n    return (((y * columns) + x) * int(grid.z + 0.5)) + clusterSliceOf(depth, grid, factors);\n}\n\nhighp int clusterIndexOf(highp vec2 frag, highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    return clusterAtCell(frag * factors.xy, depth, grid, factors);\n}\n\nhighp float clusterDepthOf(highp vec3 position, highp vec4 view)\n{\n    return dot(position, view.xyz) + view.w;\n}\n\nhighp int fragmentClusterOf(highp vec2 frag, highp vec3 position, highp vec4 grid, highp vec4 factors, highp vec4 view, highp vec4 screen)\n{\n    highp float row = (screen.x > 0.5) ? (screen.y - frag.y) : frag.y;\n    return clusterIndexOf(vec2(frag.x, row), clusterDepthOf(position, view), grid, factors);\n}\n\nhighp ivec2 dataTexelOf(highp int i)\n{\n    highp uint at = uvec2(ivec2(i, 0)).x;\n    return ivec2(uvec2(at % DATA_ROW, at / DATA_ROW));\n}\n\nhighp ivec4 litClusterOf(highp vec2 frag, highp vec3 position)\n{\n    highp int cluster = fragmentClusterOf(frag, position, lightParams[3], lightParams[4], lightParams[5], lightParams[6]);\n    return ivec4(texelFetch(clusterRecords_SPIRV_Cross_DummySampler, dataTexelOf(cluster), 0));\n}\n\nhighp int indexOfWord(highp uvec4 texel, highp int j)\n{\n    highp ivec4 words = ivec4(texel);\n    highp uint channel = uvec2(ivec2(j, 0)).x % 4u;\n    if (channel == 0u)\n    {\n        return words.x;\n    }\n    if (channel == 1u)\n    {\n        return words.y;\n    }\n    if (channel == 2u)\n    {\n        return words.z;\n    }\n    return words.w;\n}\n\nhighp ivec2 indexTexelOf(highp int j)\n{\n    return dataTexelOf(ivec2(uvec2(uvec2(ivec2(j, 0)).x / 4u, 0u)).x);\n}\n\nhighp int litLightOf(highp ivec4 cluster, highp int k)\n{\n    highp int j = cluster.x + k;\n    return indexOfWord(texelFetch(clusterIndices_SPIRV_Cross_DummySampler, indexTexelOf(j), 0), j);\n}\n\nhighp ivec2 recordTexelOf(highp int light, highp int texel)\n{\n    return dataTexelOf((light