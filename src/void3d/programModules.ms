	const TEXT_624900ed7d62d4126143de4d5bdcd561170816e73f70859ebc8ab76a65fec94d = "diagnostic(off, derivative_uniformity);\n\nstruct SaoParams {\n  saoInverseViewProj : mat4x4f,\n  saoViewDepth : vec4f,\n  saoRadius : vec4f,\n  saoTaps : vec4f,\n  saoNoise : vec4f,\n  saoEye : vec4f,\n  saoFade : vec4f,\n}\n\n@binding(0) @group(0) var<uniform> saoParams : SaoParams;\n\n@binding(0) @group(1) var saoDepth : texture_2d<f32>;\n\n@binding(1) @group(1) var saoNormal : texture_2d<f32>;\n\n@binding(2) @group(1) var saoNoiseTexture : texture_2d<f32>;\n\n@binding(33) @group(1) var saoNoiseSampler : sampler;\n\nvar<private> ndc : vec4f;\n\nvar<private> position : vec4f;\n\nvar<private> fragColor : vec4f;\n\nfn ndcDepthOf(stored : f32, zeroToOne : f32) -> f32 {\n  return select(((stored * 2f) - 1f), stored, (zeroToOne == 1f));\n}\n\nfn saoPositionAt(pixel : vec2i, ndc_1 : vec2f) -> vec3f {\n  var stored : f32 = textureLoad(saoDepth, pixel, 0i).x;\n  var depth : f32 = ndcDepthOf(stored, saoParams.saoNoise.z);\n  var world : vec4f = (saoParams.saoInverseViewProj * vec4f(ndc_1.x, ndc_1.y, depth, 1f));\n  return (world.xyz / world.w);\n}\n\nfn saoScreenRadius(sampleRadius : f32, fovTan : f32, viewDepth : f32) -> f32 {\n  return ((sampleRadius * fovTan) / viewDepth);\n}\n\nfn saoViewDepthOf(at : vec3f) -> f32 {\n  return dot(saoParams.saoViewDepth, vec4f(at, 1f));\n}\n\nfn saoTapOffset(tap : i32, samples : i32, spiralTurns : i32, rotation : f32) -> vec2f {\n  var alpha : f32 = ((f32(tap) + 0.5f) / f32(samples));\n  var angle : f32 = ((alpha * (f32(spiralTurns) * 6.28f)) + rotation);\n  return (vec2f(cos(angle), sin(angle)) * alpha);\n}\n\nfn saoScalableRadius(sampleRadius : f32, viewDepth : f32) -> f32 {\n  return (sampleRadius * (max(0f, log((1f + viewDepth))) + 1f));\n}\n\nfn saoTap(offset : vec3f, normal : vec3f, radius : f32, bias : f32) -> f32 {\n  var vv : f32 = dot(offset, offset);\n  var vn : f32 = (dot(offset, normal) - (bias * radius));\n  var radius2 : f32 = (radius * radius