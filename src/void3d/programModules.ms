	const TEXT_57ffd515616a054164668bac5c40f805b81d850c1efd4612a0c510ba04e5cf4c = "diagnostic(off, derivative_uniformity);\n\nstruct EmissiveMaterialParams {\n  material : vec4f,\n  emissive : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  pointLight : array<vec4f, 4>,\n  pointColor : array<vec4f, 4>,\n  shapeA : array<vec4f, 4>,\n  shapeB : array<vec4f, 4>,\n  shapeC : array<vec4f, 4>,\n  shapeD : array<vec4f, 4>,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nstruct ShadowParams {\n  shadowMatrix : mat4x4f,\n  shadow : vec4f,\n  spotMatrix : mat4x4f,\n  spotShadow : vec4f,\n}\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> emissiveMaterialParams : EmissiveMaterialParams;\n\n@binding(5) @group(0) var<uniform> shadowParams : ShadowParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(3) @group(1) var emissiveTexture : texture_2d<f32>;\n\n@binding(4) @group(1) var shadowMap : texture_2d<f32>;\n\n@binding(6) @group(1) var spotShadowMap : texture_2d<f32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> color : vec4f;\n\nvar<private> normal : vec4f;\n\nfn materialOf() -> vec4f {\n  return emissiveMaterialParams.material;\n}\n\nfn facingNormal(normal_1 : vec3f, doubleSided : f32, frontFacing_1 : bool) -> vec3f {\n  return select(normal_1, (-normal_1), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (s