);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  var cone : f32 = (rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w));\n  return vec4f((delta / distance_1), (lightWindow(distance_1, tint.w) * cone));\n}\n\nfn spotSample(position : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f) -> vec4f {\n  var delta : vec3f = (at.xyz - position);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  var toLight : vec3f = (delta / distance_1);\n  var cone : f32 = clamp(((dot(toLight, (-a.xyz)) - b.x) / (b.y - b.x)), 0f, 1f);\n  return vec4f(toLight, (lightWindow(distance_1, tint.w) * cone));\n}\n\nfn shapedSample(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec4f {\n  if ((a.w > 2.5f)) {\n    return capsuleSample(position, at, tint, a, b);\n  }\n  if ((a.w > 1.5f)) {\n    return rectangleSample(position, normal, at, tint, a, b, c, d);\n  }\n  return spotSample(position, at, tint, a, b);\n}\n\nfn capsuleSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f) -> vec3f {\n  var l0 : vec3f = ((at.xyz - (a.xyz * b.x)) - position);\n  var l01 : vec3f = (a.xyz * (2f * b.x));\n  var squared : f32 = dot(l01, l01);\n  var alongRay : f32 = dot(reflected, l01);\n  var denominator : f32 = (squared - (alongRay * alongRay));\n  if ((denominator <= 0.000001f)) {\n    return diffuse;\n  }\n  var closest : vec3f = (l0 + (l01 * clamp((dot(l0, ((reflected * alongRay) - l01)) / denominator), 0f, 1f)));\n  var centerToRay : vec3f = ((reflected * dot(closest, reflected)) - closest);\n  var offset : f32 = length(centerToRay);\n  if ((offset < 0.000001f)) {\n    return normalize(closest);\n  }\n  return normalize((closest + (centerToRay * clamp((b.y / offset), 0f, 1f))));\n}\n\nfn rectangleSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  if ((abs(dot(a.xyz, reflected)) < 0.000001f)) {\n    return diffuse;\n  }\n  return normalize((rectanglePoint(position, reflected, at, a, b, c) - position));\n}\n\nfn shapedSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  if ((a.w > 2.5f)) {\n    return capsuleSpecularDir(position, reflected, diffuse, at, a, b);\n  }\n  if ((a.w > 1.5f)) {\n    return rectangleSpecularDir(position, reflected, diffuse, at, a, b, c);\n  }\n  return diffuse;\n}\n\nfn linearToSrgb(rgb : vec3f) -> vec3f {\n  var low : vec3f = (rgb * 12.92f);\n  var high : vec3f = ((vec3f(1.055f) * pow(max(rgb, vec3f(0f)), vec3f(0.41666f))) - vec3f(0.055f));\n  return vec3f(select(high.x, low.x, (rgb.x <= 0.0031308f)), select(high.y, low.y, (rgb.y <= 0.0031308f)), select(high.z, low.z, (rgb.z <= 0.0031308f)));\n}\n\nfn pbrShade(n : vec3f, surfaceNormal : vec3f, position : vec3f, frag : vec2f, surfaceColor : vec4f, values : vec3f) -> vec4f {\n  var albedo : vec3f = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n  var view : vec3f = (frameParams.cameraPosition.xyz - position);\n  var dir : vec4f = lightParams.dirLight;\n  var shadow : f32 = 1f;\n  var sun : vec3f = (srgbToLinear(lightParams.dirColor.xyz) * dir.w);\n  var light : vec3f = vec3f(0f);\n  if ((frameParams.envParams.x > 0f)) {\n    light = pbrEnvironmentLight(albedo, values.x, values.y, n, view, values.z);\n  } else {\n    {\n      light = pbrAmbient(albedo, values.x, values.y, n, view, srgbToLinear(lightParams.ambient.xyz), values.z);\n    }\n  }\n  light = (light + pbrDirect(albedo, values.x, values.y, n, view, dir.xyz, sun, shadow, 0f, values.z));\n  var eye : vec3f = normalize(view);\n  var reflected : vec3f = ((-eye) - (n * (2f * dot((-eye), n))));\n  var cluster : vec4i = litClusterOf(frag, position);\n  for (var k : i32 = 0i; (k < (cluster.y + cluster.z)); k++) {\n    var i : i