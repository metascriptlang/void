	const TEXT_ac98122a4af0769dbfae20e39bf5bd4ee7cee5c51df62120c73fd3a01ea7d3f0 = "#version 300 es\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec3 normal;\nlayout(location = 2) in vec2 uv;\nlayout(location = 3) in vec4 color;\nlayout(location = 4) in vec4 instanceRow0;\nlayout(location = 5) in vec4 instanceRow1;\nlayout(location = 6) in vec4 instanceRow2;\nlayout(location = 7) in vec4 instanceColor;\nout vec3 worldPosition;\nout vec3 worldNormal;\nout vec2 surfaceUv;\nout vec4 baseColor;\n\nmat4 instanceWorld(vec4 row0, vec4 row1, vec4 row2)\n{\n    return transpose(mat4(row0, row1, row2, vec4(0.0, 0.0, 0.0, 1.0)));\n}\n\nvec3 skinNormal(mat4 world, vec3 normal_1)\n{\n    mat3 linear = mat3(world);\n    vec3 a = cross(linear[1], linear[2]);\n    vec3 b = cross(linear[2], linear[0]);\n    vec3 c = cross(linear[0], linear[1]);\n    float direction = (dot(linear[0], a) < 0.0) ? (-1.0) : 1.0;\n    return (((a * normal_1.x) + (b * normal_1.y)) + (c * normal_1.z)) * direction;\n}\n\nvoid main()\n{\n    mat4 matrix_1 = instanceWorld(instanceRow0, instanceRow1, instanceRow2);\n    vec4 world_1 = matrix_1 * vec4(position, 1.0);\n    worldPosition = world_1.xyz;\n    worldNormal = skinNormal(matrix_1, normal);\n    surfaceUv = uv;\n    baseColor = color * instanceColor;\n    gl_Position = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * world_1;\n    return;\n}\n";
	const TEXT_1b7187f24ce485f29b2047d36f89ba241b359f223c13b80853ae835c714342c7 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nconst highp uint DATA_ROW = 256u;\nconst highp int RECORD_TEXELS = 6;\n\nuniform highp vec4 materialParams[2];\nuniform highp vec4 lightParams[12];\nuniform highp vec4 frameParams[3];\nuniform highp sampler2D baseTexture_baseSampler;\nuniform highp sampler2D lightRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterIndices_SPIRV_Cross_DummySampler;\nuniform highp sampler2D cookieTexture_cookieSampler;\n\nin highp vec3 worldPosition;\nin highp vec3 worldNormal;\nin highp vec2 surfaceUv;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\n\nhighp vec4 materialOf()\n{\n    return materialParams[0];\n}\n\nhighp vec3 facingNormal(highp vec3 normal, highp float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal) : normal;\n}\n\nhighp vec4 materialColorOf()\n{\n    return materialParams[1];\n}\n\nhighp vec4 tintedSurface(highp vec4 color_1)\n{\n    return color_1 * materialColorOf();\n}\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp int cellOf(highp float position, highp int cells)\n{\n    if (!(position > 0.0))\n    {\n        return 0;\n    }\n    if (position >= float(cells))\n    {\n        return cells - 1;\n    }\n    return int(position);\n}\n\nhighp int clusterSliceOf(highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    highp int slices = int(grid.z + 0.5);\n    if (grid.w > 0.5)\n    {\n        return cellOf(floor((depth - factors.z) * factors.w), slices);\n    }\n    return cellOf(((log(depth) * factors.z) - factors.w) + 1.0, slices);\n}\n\nhighp int clusterAtCell(highp vec2 cell, highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    highp int columns = int(grid.x + 0.5);\n    highp int x = cellOf(cell.x, columns);\n    highp int y = cellOf(cell.y, int(grid.y + 0.5));\n    return (((y * columns) + x) * int(grid.z + 0.5)) + clusterSliceOf(depth, grid, factors);\n}\n\nhighp int clusterIndexOf(highp vec2 frag, highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    return clusterAtCell(frag * factors.xy, depth, grid, factors);\n}\n\nhighp float clusterDepthOf(highp vec3 position, highp vec4 view)\n{\n    return dot(position, view.xyz) + view.w;\n}\n\nhighp int fragmentClusterOf(highp vec2 frag, highp vec3 position, highp vec4 grid, highp vec4 factors, highp vec4 view, highp vec4 screen)\n{\n    highp float row = (screen.x > 0.5) ? (screen.y - frag.y) : frag.y;\n    return clusterIndexOf(vec2(frag.x, row), clusterDepthOf(position, view), grid, factors);\n}\n\nhighp ivec2 dataTexelOf(highp int i)\n{\n    highp uint at = uvec2(ivec2(i, 0)).x;\n    return ivec2(uvec2(at % DATA_ROW, at / DATA_ROW));\n}\n\nhighp ivec4 litClusterOf(highp vec2 frag, highp vec3 position)\n{\n    highp int cluster = fragmentClusterOf(frag, position, lightParams[3], lightParams[4], lightParams[5], lightParams[6]);\n    return ivec4(texelFetch(clusterRecords_SPIRV_Cross_DummySampler, dataTexelOf(cluster), 0));\n}\n\nhighp int indexOfWord(highp uvec4 texel, highp int j)\n{\n    highp ivec4 words = ivec4(texel);\n    highp uint channel = uvec2(ivec2(j, 0)).x % 4u;\n    if (channel == 0u)\n    {\n        return words.x;\n    }\n    if (channel == 1u)\n    {\n        return words.y;\n    }\n    if (channel == 2u)\n    {\n        return words.z;\n    }\n    return words.w;\n}\n\nhighp ivec2 indexTexelOf(highp int j)\n{\n    return dataTexelOf(ivec2(uvec2(uvec2(ivec2(j, 0)).x / 4u, 0u)).x);\n}\n\nhighp int litLightOf(highp ivec4 cluster, highp int k)\n{\n    highp int j = cluster.x + k;\n    return indexOfWord(texelFetch(clusterIndices_SPIRV_Cross_DummySampler, indexTexelOf(j), 0), j);\n}\n\nhighp ivec2 recordTexelOf(highp int light, highp int texel)\n{\n    return dataTexelOf((light * RECORD_TEXELS) + texel);\n}\n\nhighp vec4 litTexelOf(highp int light, highp int texel)\n{\n    return texelFetch(lightRecords_SPIRV_Cross_DummySampler, recordTexelOf(light, texel), 0);\n}\n\nhighp vec3 cookieAt(highp vec3 position)\n{\n    highp vec4 q = mat4(lightParams[8], lightParams[9], lightParams[10], lightParams[11]) * vec4(position, 1.0);\n    if (q.w <= 0.0)\n    {\n        return vec3(0.0);\n    }\n    highp vec2 uv = q.xy / q.w;\n    if ((((uv.x < 0.0) || (uv.x > 1.0)) || (uv.y < 0.0)) || (uv.y > 1.0))\n    {\n        return vec3(0.0);\n    }\n    highp vec4 texel = textureLod(cookieTexture_cookieSampler, uv, 0.0);\n    return texel.xyz * texel.w;\n}\n\nhighp vec4 recordCookieAt(highp vec3 position, highp int i)\n{\n    highp float named = float(i + 1);\n    if (lightParams[7].x == named)\n    {\n        return vec4(cookieAt(position), 1.0);\n    }\n    return vec4(1.0, 1.0, 1.0, 0.0);\n}\n\nhighp float lightWindow(highp float distance_1, highp float range)\n{\n    highp float window = clamp(1.0 - (distance_1 / range), 0.0, 1.0);\n    return window * window;\n}\n\nhighp vec4 cookieSpotSample(highp vec3 position, highp vec4 at, highp vec4 tint)\n{\n    highp vec3 delta = at.xyz - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w));\n}\n\nhighp vec3 pointLightAt(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint)\n{\n    highp vec3 toLight = at.xyz - position;\n    highp float distance_1 = length(toLight);\n    highp float falloff = clamp(1.0 - (distance_1 / tint.w), 0.0, 1.0);\n    highp float facing = max(dot(normal, toLight / max(distance_1, 0.0001)), 0.0);\n    return srgbToLinear(tint.xyz) * (((falloff * falloff) * facing) * at.w);\n}\n\nhighp vec4 capsuleSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 start = at.xyz - (a.xyz * b.x);\n    highp vec3 segment = a.xyz * (2.0 * b.x);\n    highp float along = clamp(dot(position - start, segment) / dot(segment, segment), 0.0, 1.0);\n    highp vec3 delta = (start + (segment * along)) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w));\n}\n\nhighp vec3 rectanglePoint(highp vec3 position, highp vec3 ray, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    highp float along = dot(a.xyz, at.xyz - position) / dot(a.xyz, ray);\n    highp vec3 offset = (position + (ray * along)) - at.xyz;\n    return (at.xyz + (b.xyz * clamp(dot(offset, b.xyz), -b.w, b.w))) + (c.xyz * clamp(dot(offset, c.xyz), -c.w, c.w));\n}\n\nhighp float rectangleAxisCone(highp vec3 delta, highp vec3 forward, highp vec3 excluded, highp float outer, highp float inner)\n{\n    highp vec3 projectedDelta = delta - (excluded * dot(delta, excluded));\n    highp vec3 projectedLight = (-forward) - (excluded * dot(-forward, excluded));\n    highp float deltaLength = length(projectedDelta);\n    highp float lightLength = length(projectedLight);\n    if ((deltaLength < 0.0001) || (lightLength < 0.0001))\n    {\n        return 0.0;\n    }\n    highp float theta = dot(projectedDelta, projectedLight) / (deltaLength * lightLength);\n    return clamp((theta - outer) / ((inner - outer) + 0.00001), 0.0, 1.0);\n}\n\nhighp vec4 rectangleSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (abs(dot(a.xyz, normal)) < 0.000001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 delta = rectanglePoint(position, normal, at, a, b, c) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp float cone = rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w);\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 spotSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 delta = at.xyz - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 toLight = delta / distance_1;\n    highp float cone = clamp((dot(toLight, -a.xyz) - b.x) / (b.y - b.x), 0.0, 1.0);\n    return vec4(toLight, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 shapedSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSample(position, at, tint, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSample(position, normal, at, tint, a, b, c, d);\n    }\n    return spotSample(position, at, tint, a, b);\n}\n\nhighp vec3 lightAt(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    highp vec3 lit = vec3(0.0);\n    if (a.w < 0.5)\n    {\n        lit = pointLightAt(position, normal, at, tint);\n    }\n    else\n    {\n        {\n            highp vec4 sample_1 = shapedSample(position, normal, at, tint, a, b, c, d);\n            lit = srgbToLinear(tint.xyz) * ((sample_1.w * max(dot(normal, sample_1.xyz), 0.0)) * at.w);\n        }\n    }\n    return lit;\n}\n\nhighp float recordShadowAt(highp vec3 position, highp vec3 normal, highp int i)\n{\n    highp float lit = 1.0;\n    return lit;\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 litShade(highp vec3 n, highp vec3 surfaceNormal, highp vec3 position, highp vec2 frag, highp vec4 surfaceColor)\n{\n    highp vec4 dir = lightParams[1];\n    highp float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n    highp vec3 ambient = srgbToLinear(lightParams[0].xyz);\n    highp vec3 light = ambient + (srgbToLinear(lightParams[2].xyz) * lambert);\n    highp ivec4 cluster = litClusterOf(frag, position);\n    for (highp int k = 0; k < (cluster.y + cluster.z); k++)\n    {\n        highp int i = litLightOf(cluster, k);\n        highp vec4 at = litTexelOf(i, 0);\n        highp vec4 tint = litTexelOf(i, 1);\n        highp vec4 cookie = recordCookieAt(position, i);\n        highp vec3 lit = vec3(0.0);\n        if (cookie.w > 0.5)\n        {\n            highp vec4 sample_1 = cookieSpotSample(position, at, tint);\n            lit = (srgbToLinear(tint.xyz) * cookie.xyz) * ((sample_1.w * max(dot(n, sample_1.xyz), 0.0)) * at.w);\n        }\n        else\n        {\n            {\n                lit = lightAt(position, n, at, tint, litTexelOf(i, 2), litTexelOf(i, 3), litTexelOf(i, 4), litTexelOf(i, 5));\n            }\n        }\n        light = light + (lit * recordShadowAt(position, surfaceNormal, i));\n    }\n    highp vec3 surface = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n    return vec4(linearToSrgb(surface * light), surfaceColor.w);\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed +