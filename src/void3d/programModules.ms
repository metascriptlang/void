export function gpu3dShaderModule(index: int32): GPUShaderModuleDescriptor {
	if (index < 0 || index >= 358) {
		console.error("gpu3dShaderModule: no program at index " + String(index));
		unreachable;
	}
	return match (index) {
		0 => litShaderModule(),
		1 => particleShaderModule(),
		2 => particleCutoutShaderModule(),
		3 => billboardShaderModule(),
		4 => particleVisualShaderModule(),
		5 => particleVisualPremultipliedShaderModule(),
		6 => particleVisualCutoutShaderModule(),
		7 => pixelArtParticleVisualShaderModule(),
		8 => pixelArtParticleVisualPremultipliedShaderModule(),
		9 => pixelArtParticleVisualCutoutShaderModule(),
		10 => copyShaderModule(),
		11 => pixelArtLitShaderModule(),
		12 => pixelArtParticleShaderModule(),
		13 => pixelArtParticleCutoutShaderModule(),
		14 => pixelArtBillboardShaderModule(),
		15 => pixelArtPostShaderModule(),
		16 => pixelArtBlitShaderModule(),
		17 => litTexturedShaderModule(),
		18 => pixelArtLitTexturedShaderModule(),
		19 => unlitTexturedShaderModule(),
		20 => pixelArtUnlitTexturedShaderModule(),
		21 => litTexturedPremultipliedShaderModule(),
		22 => pixelArtLitTexturedPremultipliedShaderModule(),
		23 => unlitTexturedPremultipliedShaderModule(),
		24 => pixelArtUnlitTexturedPremultipliedShaderModule(),
		25 => litCutoutShaderModule(),
