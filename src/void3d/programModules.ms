	const TEXT_db5f8d8995044d778d20a87762a3f970e8838c34313daae4213b25b8369e4845 = "#version 430\n\nuniform vec4 modelParams[8];\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec3 normal;\nlayout(location = 2) in vec4 color;\nlayout(location = 0) out vec3 worldPosition;\nlayout(location = 1) out vec3 worldNormal;\nlayout(location = 2) out vec4 baseColor;\nlayout(location = 3) out float depth01;\n\nvoid main()\n{\n    vec4 world_1 = mat4(modelParams[0], modelParams[1], modelParams[2], modelParams[3]) * vec4(position, 1.0);\n    vec4 clip_1 = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * world_1;\n    worldPosition = world_1.xyz;\n    worldNormal = mat3(mat4(modelParams[4], modelParams[5], modelParams[6], modelParams[7])) * normal;\n    baseColor = color;\n    depth01 = clip_1.z;\n    gl_Position = clip_1;\n    return;\n}\n";
	const TEXT_7f6f733f080ee542eb88ee2c9a03ce37ab9634205337c6d85a5022ac603538e1 = "#version 430\n\nuniform vec4 materialParams[1];\nuniform vec4 lightParams[27];\nuniform vec4 frameParams[3];\n\nlayout(location = 0) in vec3 worldPosition;\nlayout(location = 1) in vec3 worldNormal;\nlayout(location = 2) in vec4 baseColor;\nlayout(location = 3) in float depth01;\nlayout(location = 0) out vec4 color;\nlayout(location = 1) out vec4 normal;\n\nvec4 materialOf()\n{\n    return materialParams[0];\n}\n\nvec3 facingNormal(vec3 normal_1, float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal_1) : normal_1;\n}\n\nvec3 srgbToLinear(vec3 srgb)\n{\n    vec3 low = srgb * 0.0773993808;\n    vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nvec3 toonPointLightAt(vec3 position, vec3 normal_1, vec4 at, vec4 tint, float normalWeight, float levels)\n{\n    vec3 toLight = at.xyz - position;\n    float distance_1 = length(toLight);\n    float falloff = clamp(1.0 - (distance_1 / tint.w), 0.0, 1.0);\n    float facing = mix(1.0, max(dot(normal_1, toLight / max(distance_1, 0.0001)), 0.0), normalWeight);\n    float energy = ((falloff * falloff) * facing) * at.w;\n    float level = floor((energy * levels) + 0.35) / levels;\n    return srgbToLinear(tint.xyz) * level;\n}\n\nvec3 saturated(vec3 rgb, float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nvec3 linearToSrgb(vec3 rgb)\n{\n    vec3 low = rgb * 12.92;\n    vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nvec4 toonShade(vec3 n, vec3 position, vec4 surfaceColor)\n{\n    vec4 params = materialOf();\n    vec4 dir = lightParams[1];\n    float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n    vec3 light = srgbToLinear(lightParams[0].xyz) + (srgbToLinear(lightParams[2].xyz) * lambert);\n    for (int i = 0; i < int(lightParams[0].w + 0.5); i++)\n    {\n        vec4 at = lightParams[3 + i];\n        light = light + toonPointLightAt(position, n, at, lightParams[7 + i], 1.0, params.x);\n    }\n    vec3 surface = srgbToLinear(saturated(surfaceColor.xyz, params.y));\n    return vec4(linearToSrgb(surface * light), surfaceColor.w);\n}\n\nvec3 toneCurved(vec3 exposed, float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        float startCompression = 0.76;\n        float desaturation = 0.15;\n        float x = min(exposed.x, min(exposed.y, exposed.z));\n        float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        vec3 color_1 = exposed - offset;\n        float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            float d = 1.0 - startCompression;\n            float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nvec3 toneMapped(vec3 rgb, vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    vec4 params = materialOf();\n    vec3 n = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    vec4 shaded = toonShade(n, worldPosition, baseColor);\n    color = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    normal = vec4((n * 0.5) + 0.5, depth01);\n    return;\n}\n";
	const TEXT_defcabf4da31d60d03ff326fdf3f4037cdf2a3d4feb91ce6a5bd3ae22e92b1d5 = "#version 430\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec4 root;\nlayout(location = 1) in vec4 color;\nlayout(location = 0) out vec4 particleColor;\nlayout(location = 1) out float depth01;\n\nvoid main()\n{\n    vec2 corner = PARTICLE_CORNERS[uint(gl_VertexID) % 6u];\n    vec3 right = vertexParams[4].xyz;\n    vec3 up = vertexParams[5].xyz;\n    vec3 world = (root.xyz + (right * (corner.x * root.w))) + (up * (corner.y * root.w));\n    vec4 clip = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    particleColor = color;\n    depth01 = clip.z;\n    gl_Position = clip;\n    return;\n}\n";
