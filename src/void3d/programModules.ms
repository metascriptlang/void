0), vec3(1.0));\n}\n\nvec3 toneMapped(vec3 rgb, vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    vec4 color_1 = particleColor;\n    color = vec4(toneMapped(color_1.xyz, frameParams[0]), color_1.w);\n    normal = vec4(0.5, 1.0, 0.5, depth01);\n    return;\n}\n";
	const TEXT_df3c26e3a187bfaf302f68dc111c32d302415701177d5658ef308f27bbf03b9f = "#version 430\n\nuniform vec4 frameParams[3];\n\nlayout(location = 0) in vec4 particleColor;\nlayout(location = 1) in float depth01;\nlayout(location = 0) out vec4 color;\nlayout(location = 1) out vec4 normal;\n\nvec3 srgbToLinear(vec3 srgb)\n{\n    vec3 low = srgb * 0.0773993808;\n    vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nvec3 linearToSrgb(vec3 rgb)\n{\n    vec3 low = rgb * 12.92;\n    vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nvec3 toneCurved(vec3 exposed, float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        float startCompression = 0.76;\n        float desaturation = 0.15;\n        float x = min(exposed.x, min(exposed.y, exposed.z));\n        float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        vec3 color_1 = exposed - offset;\n        float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            float d = 1.0 - startCompression;\n            float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nvec3 toneMapped(vec3 rgb, vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    vec4 color_1 = particleColor;\n    if (color_1.w < 0.5)\n    {\n        discard;\n    }\n    color_1 = vec4(color_1.xyz, 0.0);\n    color = vec4(toneMapped(color_1.xyz, frameParams[0]), color_1.w);\n    normal = vec4(0.5, 1.0, 0.5, depth01);\n    return;\n}\n";
	const TEXT_58caf2f0efb4f4ac2d7a85e8c76519485b290f83328477b63a03a5cbd118a202 = "#version 430\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec2 size;\nlayout(location = 2) in vec2 anchor;\nlayout(location = 3) in vec4 tile;\nlayout(location = 4) in vec4 color;\nlayout(location = 0) out vec2 uv;\nlayout(location = 1) out vec3 rootPosition;\nlayout(location = 2) out vec4 instanceColor;\nlayout(location = 3) out float depth01;\n\nvec3 billboardPoint(vec3 position_1, vec2 size_1, vec2 anchor_1, vec2 corner, vec3 right, vec3 up)\n{\n    vec2 offset = corner - anchor_1;\n    return (position_1 + (right * (offset.x * size_1.x))) + (up * (offset.y * size_1.y));\n}\n\nvoid main()\n{\n    vec2 corner = PARTICLE_CORNERS[uint(gl_VertexID) % 6u];\n    vec3 world = billboardPoint(position, size, anchor, corner, vertexParams[4].xyz, vertexParams[5].xyz);\n    vec4 clip = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    uv = vec2((corner.x > 0.0) ? tile.z : tile.x, (corner.y > 0.0) ? tile.y : tile.w);\n    rootPosition = position;\n    instanceColor = color;\n    depth01 = clip.z;\n    gl_Position = clip;\n    return;\n}\n";
	const TEXT_5a82caa906bbc66eeb30066c4eccd86fedfaf1a17ed105c7f89ecf31175ef3ca = "#version 430\n\nconst ivec2 OUTLINE_OFFSETS[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));\n\nuniform vec4 postParams[6];\nlayout(binding = 0) uniform sampler2D colorTexture_SPIRV_Cross_DummySampler;\nlayout(binding = 1) uniform sampler2D normalTexture_SPIRV_Cross_DummySampler;\nlayout(binding = 2) uniform sampler2D depthTexture_SPIRV_Cross_DummySampler;\nlayout(binding = 3) uniform sampler2D paletteTexture_SPIRV_Cross_DummySampler;\n\nlayout(location = 0) out vec4 fragColor;\n\nvec4 postNormalAt(ivec2 p, ivec2 size)\n{\n    return texelFetch(normalTexture_SPIRV_Cross_DummySampler, clamp(p, ivec2(0, 0), size - ivec2(1, 1)), 0);\n}\n\nfloat postDepthAt(vec4 normal, ivec2 p, ivec2 size)\n{\n    float depth = normal.w;\n    if (postParams[3].z > 0.5)\n    {\n        ivec2 q = clamp(p, ivec2(0, 0), size - ivec2(1, 1));\n        float stored = texelFetch(depthTexture_SPIRV_Cross_DummySampler, q, 0).x;\n        depth = (stored * postParams[4].x) + postParams[4].y;\n    }\n    return depth;\n}\n\nvec3 saturated(vec3 rgb, float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nvec3 paletteColor(vec3 rgb)\n{\n    int levels = int(postParams[3].w);\n    ivec3 q = ivec3((clamp(rgb, vec3(0.0), vec3(1.0)) * float(levels - 1)) + 0.5);\n    return texelFetch(paletteTexture_SPIRV_Cross_DummySampler, ivec2(q.x + (q.z * levels), q.y), 0).xyz;\n}\n\nvoid main()\n{\n    ivec2 size = textureSize(colorTexture_SPIRV_Cross_DummySampler, 0);\n    ivec2 p = ivec2(gl_FragCoord.xy);\n    vec4 color = texelFetch(colorTexture_SPIRV_Cross_DummySampler, p, 0);\n    vec4 center = postNormalAt(p, size);\n    float centerDepth = postDepthAt(center, p, size);\n    vec4 edge = postParams[0];\n    vec3 rgb = color.xyz;\n    if (postParams[3].x > 0.5)\n    {\n        vec3 n = (center.xyz * 2.0) - 1.0;\n        float depthEdge = 0.0;\n        float normalEdge = 0.0;\n        for (int i = 0; i < 4; i++)\n        {\n            vec4 neighbor = postNormalAt(p + OUTLINE_OFFSETS[i], size);\n            float depthDelta = postDepthAt(neighbor, p + OUTLINE_OFFSETS[i], size) - centerDepth;\n            if (depthDelta > edge.x)\n            {\n                depthEdge = 1.0;\n            }\n            vec3 nq = (neighbor.xyz * 2.0) - 1.0;\n            if (((abs(depthDelta) < edge.x) && (dot(n, nq) < edge.y)) && (n.y > (nq.y + 0.1)))\n            {\n                normalEdge = 1.0;\n            }\n        }\n        rgb = mix(rgb, rgb * edge.z, depthEdge * color.w);\n        rgb = mix(rgb, (rgb * edge.w) + vec3(0.02), (normalEdge * color.w) * (1.0 - depthEdge));\n    }\n    vec4 fog = postParams[1];\n    float haze = smoothstep(fog.x, fog.y, centerDepth) * fog.z;\n    rgb = mix(rgb, postParams[2].xyz, haze);\n    rgb = saturated(rgb, postParams[5].x);\n    if (postParams[3].y > 0.5)\n    {\n        rgb = paletteColor(rgb);\n    }\n    fragColor = vec4(rgb, 1.0);\n    return;\n}\n";
	const TEXT_020ffa0030409aad4032a03432af55126b599d732ff1e6a2d35c3b6e0a635dc1 = "#version 430\n\nuniform vec4 blitParams[1];\nlayout(binding = 0) uniform sampler2D sceneTexture_SPIRV_Cross_DummySampler;\n\nlayout(location = 0) out vec4 fragColor;\n\nvoid main()\n{\n    ivec2 size = textureSize(sceneTexture_SPIRV_Cross_DummySampler, 0);\n    ivec2 p = ivec2(floor((gl_FragCoord.xy + blitParams[0].zw) / blitParams[0].x));\n    vec4 texel = texelFetch(sceneTexture_SPIRV_Cross_DummySampler, clamp(p, ivec2(0, 0), size - ivec2(1, 1)), 0);\n    fragColor = vec4(texel.xyz, 1.0);\n    return;\n}\n";
	const TEXT_a2d872cc378b349b2e8f16867bcbe943b4ba68721f9437626b99a8a6eab33faa = "#version 430\n\nuniform vec4 modelParams[8];\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec3 normal;\nlayout(location = 2) in vec2 uv;\nlayout(location = 3) in vec4 color;\nlayout(location = 0) out vec3 worldPosition;\nlayout(location = 1) out vec3 worldNormal;\nlayout(location = 2) out vec2 surfaceUv;\nlayout(location = 3) out vec4 baseColor;\n\nvoid main()\n{\n    vec4 world_2 = mat4(modelParams[0], modelParams[1], modelParams[2], modelParams[3]) * vec4(position, 1.0);\n    worldPosition = world_2.xyz;\n    worldNormal = mat3(mat4(modelParams[4], modelParams[5], modelParams[6], modelParams[7])) * normal;\n    surfaceUv = uv;\n    baseColor = color;\n    gl_Position = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * world_2;\n    return;\n}\n";
	const TEXT_dcf99d0f003e75e733ddab11b27617734ec879cefdfd5c0069d66dd0da37cf9f = "#version 430\n\nuniform vec4 materialParams[1];\nuniform vec4 lightParams[27];\nuniform vec4 frameParams[3];\nlayout(binding = 0) uniform sampler2D baseTexture_baseSampler;\n\nlayout(location = 0) in vec3 worldPosition;\nlayout(location = 1) in vec3 worldNormal;\nlayout(location = 2) in vec2 surfaceUv;\nlayout(location = 3) in vec4 baseColor;\nlayout(location = 0) out vec4 color;\n\nvec4 materialOf()\n{\n    return materialParams[0];\n}\n\nvec3 facingNormal(vec3 normal, float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal) : normal;\n}\n\nvec3 srgbToLinear(vec3 srgb)\n{\n    vec3 low = srgb * 0.0773993808;\n    vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nvec3 pointLightAt(vec3 position, vec3 normal, vec4 at, vec4 tint)\n{\n    vec3 toLight = at.xyz - position;\n    float distance_1 = length(toLight);\n    float falloff = clamp(1.0 - (distance_1 / tint.w), 0.0, 1.0);\n    float facing = max(dot(normal, toLight / max(distance_1, 0.0001)), 0.0);\n    return srgbToLinear(tint.xyz) * (((falloff * falloff) * facing) * at.w);\n}\n\nfloat lightWindow(float distance_1, float range)\n{\n    float window = clamp(1.0 - (distance_1 / range), 0.0, 1.0);\n    return window * window;\n}\n\nvec4 capsuleSample(vec3 position, vec4 at, vec4 tint, vec4 a, vec4 b)\n{\n    vec3 start = at.xyz - (a.xyz * b.x);\n    vec3 segment = a.xyz * (2.0 * b.x);\n    float along = clamp(dot(position - start, segment) / dot(segment, segment), 0.0, 1.0);\n    vec3 delta = (start + (segment * along)) - position;\n    float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w));\n}\n\nvec3 rectanglePoint(vec3 position, vec3 ray, vec4 at, vec4 a, vec4 b, vec4 c)\n{\n    float along = dot(a.xyz, at.xyz - position) / dot(a.xyz, ray);\n    vec3 offset = (position + (ray * along)) - at.xyz;\n    return (at.xyz + (b.xyz * clamp(dot(offset, b.xyz), -b.w, b.w))) + (c.xyz * clamp(dot(offset, c.xyz), -c.w, c.w));\n}\n\nfloat rectangleAxisCone(vec3 delta, vec3 forward, vec3 excluded, float outer, float inner)\n{\n    vec3 projectedDelta = delta - (excluded * dot(delta, excluded));\n    vec3 projectedLight = (-forward) - (excluded * dot(-forward, excluded));\n    float deltaLength = length(projectedDelta);\n    float lightLength = length(projectedLight);\n    if ((deltaLength < 0.0001) || (lightLength < 0.0001))\n    {\n        return 0.0;\n    }\n    float theta = dot(projectedDelta, projectedLight) / (deltaLength * lightLength);\n    return clamp((theta - outer) / ((inner - outer) + 0.00001), 0.0, 1.0);\n}\n\nvec4 rectangleSample(vec3 position, vec3 normal, vec4 at, vec4 tint, vec4 a, vec4 b, vec4 c, vec4 d)\n{\n    if (abs(dot(a.xyz, normal)) < 0.000001)\n    {\n        return vec4(0.0);\n    }\n    vec3 delta = rectanglePoint(position, normal, at, a, b, c) - position;\n    float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    float cone = rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w);\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w) * cone);\n}\n\nvec4 spotSample(vec3 position, vec4 at, vec4 tint, vec4 a, vec4 b)\n{\n    vec3 delta = at.xyz - position;\n    float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    vec3 toLight = delta / distance_1;\n    float cone = clamp((dot(toLight, -a.xyz) - b.x) / (b.y - b.x), 0.0, 1.0);\n    return vec4(toLight, lightWindow(distance_1, tint.w) * cone);\n}\n\nvec4 shapedSample(vec3 position, vec3 normal, vec4 at, vec4 tint, vec4 a, vec4 b,