export function gpu3dShaderModule(index: int32): GPUShaderModuleDescriptor {
	if (index < 0 || index >= 362) {
		console.error("gpu3dShaderModule: no program at index " + String(index));
		unreachable;
	}
	return match (index) {
		0 => litShaderModule(),
		1 => particleShaderModule(),
		2 => particleCutoutShaderModule(),
