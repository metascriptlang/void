    highp vec3 delta = at.xyz - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 toLight = delta / distance_1;\n    highp float cone = clamp((dot(toLight, -a.xyz) - b.x) / (b.y - b.x), 0.0, 1.0);\n    return vec4(toLight, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 shapedSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSample(position, at, tint, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSample(position, normal, at, tint, a, b, c, d);\n    }\n    return spotSample(position, at, tint, a, b);\n}\n\nhighp vec3 lightAt(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    highp vec3 lit = vec3(0.0);\n    if (a.w < 0.5)\n    {\n        lit = pointLightAt(position, normal, at, tint);\n    }\n    else\n    {\n        {\n            highp vec4 sample_1 = shapedSample(position, normal, at, tint, a, b, c, d);\n            lit = srgbToLinear(tint.xyz) * ((sample_1.w * max(dot(normal, sample_1.xyz), 0.0)) * at.w);\n        }\n    }\n    return lit;\n}\n\nhighp float slotShadowAt(highp vec3 position, highp int slot)\n{\n    return 1.0;\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp