 scale));\n        highp float depth_1 = texelFetch(spotShadowMap_SPIRV_Cross_DummySampler, ivec3(at, 0), 0).x;\n        lit = lit + mapLit(p.z, depth_1, shadowParams[24].x, shadowParams[24].y);\n    }\n    return lit / float(PCF_SAMPLES);\n}\n\nhighp int cubeFaceOf(highp vec3 toPosition)\n{\n    highp vec3 axes = abs(toPosition);\n    if ((axes.x >= axes.y) && (axes.x >= axes.z))\n    {\n        return (toPosition.x > 0.0) ? 0 : 1;\n    }\n    if (axes.y >= axes.z)\n    {\n        return (toPosition.y > 0.0) ? 2 : 3;\n    }\n    return (toPosition.z > 0.0) ? 4 : 5;\n}\n\nhighp float cubeTapAt(highp vec3 position)\n{\n    highp vec3 toPosition = position - shadowParams[51].xyz;\n    highp int face = cubeFaceOf(toPosition);\n    highp vec4 p = mapCoord(position, mat4(shadowParams[26 + face * 4], shadowParams[27 + face * 4], shadowParams[28 + face * 4], shadowParams[29 + face * 4]));\n    if (p.w < 0.5)\n    {\n        return 1.0;\n    }\n    highp int size = int(shadowParams[50].z + 0.5);\n    highp float depth = texelFetch(cubeShadowMap_SPIRV_Cross_DummySampler, ivec3(pcfTexelOf(p, size, vec2(0.0)), face), 0).x;\n    highp float near = shadowParams[52].x;\n    highp float far = shadowParams[52].y;\n    highp vec3 axes = abs(toPosition);\n    highp float axis = max(axes.x, max(axes.y, axes.z));\n    highp float distance_1 = length(toPosition);\n    highp float stored = ((near * far) / (far - (depth * (far - near)))) * (distance_1 / axis);\n    return mapLit(distance_1 / far, stored / far, shadowParams[50].x / far, shadowParams[50].y);\n}\n\nhighp float cubeShadowAt(highp vec3 position, highp vec3 normal)\n{\n    highp float scale = shadowParams[50].w / shadowParams[50].z;\n    highp vec3 light = shadowParams[51].xyz;\n    highp vec3 at = position + (normal * (shadowParams[52].z * length(position - light)));\n    highp vec3 toPosition = at - light;\n    highp float distance_1 = length(toPosition);\n    highp float lit = 0.0;\n    if ((!(scale > 0.0)) || (!(distance_1 > 0.0)))\n    {\n        lit = cubeTapAt(at);\n    }\n    else\n    {\n        {\n            highp vec3 direction = toPosition / distance_1;\n            for (highp int tap = 0; tap < CUBE_PCF_SAMPLES; tap++)\n            {\n                highp vec3 turned = normalize(direction + (CUBE_PCF_OFFSETS[tap] * scale));\n                lit = lit + cubeTapAt(light + (turned * distance_1));\n            }\n            lit = lit / float(CUBE_PCF_SAMPLES);\n        }\n    }\n    return lit;\n}\n\nhighp float recordShadowAt(highp vec3 position, highp vec3 normal, highp int i)\n{\n    highp float lit = 1.0;\n    highp float named = float(i + 1);\n    if (lightParams[0].w == named)\n    {\n        lit = spotShadowAt(position, normal);\n    }\n    else\n    {\n        if (lightParams[2].w == named)\n        {\n            lit = cubeShadowAt(position, normal);\n        }\n    }\n    return lit;\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 litShade(highp vec3 n, highp vec3 surfaceNormal, highp vec3 position, highp vec2 frag, highp vec4 surfaceColor)\n{\n    highp vec4 dir = lightParams[1];\n    highp float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n    lambert = lambert * dirShadowAt(position, surfaceNormal);\n    highp vec3 ambient = srgbToLinear(lightParams[0].xyz);\n    highp vec3 light = ambient + (srgbToLinear(lightParams[2].xyz) * lambert);\n    highp ivec4 cluster = litClusterOf(frag, position);\n    for (highp int k = 0; k < (cluster.y + cluster.z); k++)\n    {\n        highp int i = litLightOf(cluster, k);\n        highp vec4 at = litTexelOf(i, 0);\n        highp vec4 tint = litTexelOf(i, 1);\n        highp vec4 cookie = recordCookieAt(position, i);\n        highp vec3 lit = vec3(0.0);\n        if (cookie.w > 0.5)\n        {\n            highp vec4 sample_1 = cookieSpotSample(position, at, tint);\n            lit = (srgbToLinear(tint.xyz) * cookie.xyz) * ((sample_1.w * max(dot(n, sample_1.xyz), 0.0)) * at.w);\n        }\n        else\n        {\n            {\n                lit = lightAt(position, n, at, tint, litTexelOf(i, 2), litTexelOf(i, 3), litTexelOf(i, 4), litTexelOf(i, 5));\n            }\n        }\n        light = light + (lit * recordShadowAt(position, surfaceNormal, i));\n    }\n    highp vec3 surface = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n    return vec4(linearToSrgb(surface * light), surfaceColor.w);\n}\n\nhighp vec4 dissolveEdgeOver(highp vec4 color_1, highp float noise, highp vec4 dissolve, highp vec4 edge)\n{\n    bool onEdge = (dissolve.x > 0.0) && (noise < (dissolve.x + dissolve.y));\n    return onEdge ? vec4(mix(color_1.xyz, edge.xyz, edge.w), color_1.w) : color_1;\n}\n\nhighp vec4 dissolveEdgeOf()\n{\n    return movingMaterialParams[7];\n}\n\nhighp float distanceFade(highp float distance_1, highp vec4 range)\n{\n    highp float near = 1.0;\n    highp float far = 1.0;\n    if (range.y > range.x)\n    {\n        near = clamp((distance_1 - range.x) / (range.y - range.x), 0.0, 1.0);\n    }\n    if (range.w > range.z)\n    {\n        far = 1.0 - clamp((distance_1 - range.z) / (range.w - range.z), 0.0, 1.0);\n    }\n    return min(near, far);\n}\n\nhighp vec4 distanceFadeOf()\n{\n    return movingMaterialParams[10];\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n        highp float desaturation = 0.15;\n        highp float x = min(exposed.x, min(exposed.y, exposed.z));\n        highp float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        highp vec3 color_1 = exposed - offset;\n        highp float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            highp float d = 1.0 - startCompression;\n            highp float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            highp float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 params = materialOf();\n    highp vec2 uv = surfaceUv;\n    highp float time = frameParams[0].x;\n    uv = movedUv(surfaceUv, uvMatrixOf(), uvMotionOf(), time);\n    highp vec2 baseUv = uv;\n    highp vec2 nextUv = uv;\n    highp float blend = 0.0;\n    highp vec4 grid = flipbookGridOf();\n    highp vec4 play = flipbookPlayOf();\n    if (grid.z > 0.0)\n    {\n        highp float time_1 = frameParams[0].x;\n        highp vec4 frames = flipbookUvs(uv, grid, play, time_1);\n        baseUv = frames.xy;\n        nextUv = frames.zw;\n        blend = flipbookBlend(grid, play, time_1);\n    }\n    highp vec4 texel = texture(baseTexture_baseSampler, baseUv);\n    if (blend > 0.0)\n    {\n        texel = mix(texel, texture(baseTexture_baseSampler, nextUv), blend);\n    }\n    highp vec2 backAt = backUv(surfaceUv, backUvMatrixOf(), backUvOffsetOf());\n    highp vec4 backTexel = texture(backTexture_baseSampler, backAt);\n    texel = gl_FrontFacing ? texel : backTexel;\n    if (colorKeyed(texel, colorKeyOf()))\n    {\n        demoted = true;\n    }\n    highp float noise = 0.0;\n    noise = texture(dissolveTexture_dissolveSampler, surfaceUv).x;\n    if (noise < dissolveOf().x)\n    {\n        demoted = true;\n    }\n    highp vec3 surfaceNormal = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    highp vec3 n = surfaceNormal;\n    highp vec4 surfaceColor = tintedSurface(vec4(baseColor.xyz * texel.xyz, baseColor.w * texel.w));\n    highp vec4 shaded = vec4(0.0);\n    shaded = litShade(n, surfaceNormal, worldPosition, gl_FragCoord.xy, surfaceColor);\n    shaded = dissolveEdgeOver(shaded, noise, dissolveOf(), dissolveEdgeOf());\n    highp vec3 eye = frameParams[1].xyz;\n    highp float fade = distanceFade(length(worldPosition - eye), distanceFadeOf());\n    shaded = vec4(shaded.xyz, shaded.w * fade);\n    highp vec4 color_1 = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    color = color_1;\n    if (demoted)\n    {\n        discard;\n    }\n    return;\n}\n";
	const TEXT_b090499e00936304fc58f45b65a3aa780b2143c7974cc3de3bcc919de5d93997 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform highp vec4 movingUnlitMaterialParams[12];\nuniform highp vec4 frameParams[3];\nuniform highp sampler2D baseTexture_baseSampler;\nuniform highp sampler2D backTexture_baseSampler;\nuniform highp sampler2D dissolveTexture_dissolveSampler;\n\nin highp vec3 worldPosition;\nin highp vec2 surfaceUv;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\n\nbool demoted = false;\n\nhighp vec4 materialOf()\n{\n    return movingUnlitMaterialParams[0];\n}\n\nhighp vec2 movedUv(highp vec2 uv, highp vec4 matrix, highp vec4 motion, highp float time)\n{\n    return ((mat2(matrix.xy, matrix.zw) * uv) + motion.xy) + (motion.zw * time);\n}\n\nhighp vec4 flipbookUvs(highp vec2 uv, highp vec4 grid, highp vec4 play, highp float time)\n{\n    highp float frame = floor(((time - play.x) * grid.w) + trunc(play.y));\n    highp float looped = frame - (grid.z * floor(frame / grid.z));\n    highp float nextLooped = (looped + 1.0) - (grid.z * floor((looped + 1.0) / grid.z));\n    highp float at = (play.z == 1.0) ? looped : min(frame, grid.z - 1.0);\n    highp float next = (play.z == 1.0) ? nextLooped : min(frame + 1.0, grid.z - 1.0);\n    highp vec2 cell = uv / grid.xy;\n    highp vec2 atCell = vec2(at - (grid.x * floor(at / grid.x)), trunc(at / grid.x)) / grid.xy;\n    highp vec2 nextCell = vec2(next - (grid.x * floor(next / grid.x)), trunc(next / grid.x)) / grid.xy;\n    return vec4(cell + atCell, cell + nextCell);\n}\n\nhighp float flipbookBlend(highp vec4 grid, highp vec4 play, highp float time)\n{\n    return (play.w == 1.0) ? fract(((time - play.x) * grid.w) + trunc(play.y)) : 0.0;\n}\n\nhighp vec2 backUv(highp vec2 uv, highp vec4 matrix, highp vec4 offset)\n{\n    return (mat2(matrix.xy, matrix.zw) * uv) + offset.xy;\n}\n\nbool colorKeyed(highp vec4 texel, highp vec4 colorKey)\n{\n    highp vec4 difference = texel - colorKe