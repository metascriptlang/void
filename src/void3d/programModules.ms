	const TEXT_d63834a979464fed62e2437803b2c786e9cd11ef247a49f9ff8d221a8fd4e72b = "diagnostic(off, derivative_uniformity);\n\nstruct BillboardParams {\n  billboardColor : vec4f,\n  billboard : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  pointLight : array<vec4f, 4>,\n  pointColor : array<vec4f, 4>,\n  shapeA : array<vec4f, 4>,\n  shapeB : array<vec4f, 4>,\n  shapeC : array<vec4f, 4>,\n  shapeD : array<vec4f, 4>,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(2) @group(0) var<uniform> billboardParams : BillboardParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var billboardTexture : texture_2d<f32>;\n\n@binding(32) @group(1) var billboardSampler : sampler;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> towardCamera : vec3f;\n\nvar<private> uv : vec2f;\n\nvar<private> instanceColor : vec4f;\n\nvar<private> fragColor : vec4f;\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (srgb.x <= 0.04045f)), select(high.y, low.y, (srgb.y <= 0.04045f)), select(high.z, low.z, (srgb.z <= 0.04045f)));\n}\n\nfn pointLightAt(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f) -> vec3f {\n  var toLight : vec3f = (at.xyz - position);\n  var distance_1 : f32 = length(toLight);\n  var falloff : f32 = clamp((1f - (distance_1 / tint.w)), 0f, 1f);\n  var facing : f32 = max(dot(normal, (toLight / max(distance_1, 0.0001f))), 0f);\n  return (srgbToLinear(tint.xyz) * (((falloff * falloff) * facing) * at.w));\n}\n\nfn lightWindow(distance_1 : f32, range : f32) -> f32 {\n  var window : f32 = clamp((1f - (distance_1 / range)), 0f, 1f);\n  return (window * window);\n}\n\nfn capsuleSa