	const TEXT_ffee69839ed3451737596110f1ed34a52f59879c977ddb0fa120664373fdc26b = "diagnostic(off, derivative_uniformity);\n\nstruct EmissiveMaterialParams {\n  material : vec4f,\n  materialColor : vec4f,\n  emissive : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  clusterGrid : vec4f,\n  clusterFactors : vec4f,\n  clusterView : vec4f,\n  clusterScreen : vec4f,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nconst DATA_ROW : u32 = 256u;\n\nconst RECORD_TEXELS : i32 = 6i;\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> emissiveMaterialParams : EmissiveMaterialParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(3) @group(1) var emissiveTexture : texture_2d<f32>;\n\n@binding(5) @group(1) var normalTexture : texture_2d<f32>;\n\n@binding(9) @group(1) var lightRecords : texture_2d<f32>;\n\n@binding(10) @group(1) var clusterRecords : texture_2d<u32>;\n\n@binding(11) @group(1) var clusterIndices : texture_2d<u32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\nvar<private> worldTangent : vec4f;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> fragCoord : vec4f;\n\nvar<private> color : vec4f;\n\nvar<private> normal : vec4f;\n\nfn materialOf() -> vec4f {\n  return emissiveMaterialParams.material;\n}\n\nfn facingNormal(normal_1 : vec3f, doubleSided : f32, frontFacing_1 : bool) -> vec3f {\n  return select(normal_1, (-normal_1), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn faceOf(doubleSided : f32, frontFacing_1 : bool) -> f32 {\n  return select(1f, (-1f), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn mappedNormal(normal_1 : vec3f, tangent : vec4f, face : f32, te