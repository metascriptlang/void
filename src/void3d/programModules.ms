	const TEXT_bea5c23758396f13a8b2028305b74cecbb22355728aacda77cce035cc959af7d = "#version 430\n\nconst uint DATA_ROW = 256u;\nconst int RECORD_TEXELS = 6;\n\nuniform vec4 movingMaterialParams[8];\nuniform vec4 lightParams[12];\nuniform vec4 frameParams[3];\nlayout(binding = 0) uniform sampler2D baseTexture_baseSampler;\nlayout(binding = 1) uniform sampler2D dissolveTexture_dissolveSampler;\nlayout(binding = 2) uniform sampler2D lightRecords_SPIRV_Cross_DummySampler;\nlayout(binding = 3) uniform usampler2D clusterRecords_SPIRV_Cross_DummySampler;\nlayout(binding = 4) uniform usampler2D clusterIndices_SPIRV_Cross_DummySampler;\nlayout(binding = 5) uniform sampler2D cookieTexture_cookieSampler;\n\nlayout(location = 0) in vec3 worldPosition;\nlayout(location = 1) in vec3 worldNormal;\nlayout(location = 2) in vec2 surfaceUv;\nlayout(location = 3) in vec4 baseColor;\nlayout(location = 0) out vec4 color;\nlayout(location = 1) out vec4 normal;\n\nbool demoted = false;\n\nvec4 materialOf()\n{\n    return movingMaterialParams[0];\n}\n\nvec4 dissolveOf()\n{\n    return movingMaterialParams[6];\n}\n\nvec3 facingNormal(vec3 normal_1, float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal_1) : normal_1;\n}\n\nvec4 materialColorOf()\n{\n    return movingMaterialParams[1];\n}\n\nvec4 tintedSurface(vec4 color_1)\n{\n    return color_1 * materialColorOf();\n}\n\nvec3 srgbToLinear(vec3 srgb)\n{\n    vec3 low = srgb * 0.0773993808;\n    vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nint cellOf(float position, int cells)\n{\n    if (!(position > 0.0))\n    {\n        return 0;\n    }\n    if (position >= float(cells))\n    {\n        return cells - 1;\n    }\n    return int(position);\n}\n\nint clusterSliceOf(float depth, vec4 grid, vec4 factors)\n{\n    int slices