	const TEXT_d81c6301e06e1553ad0b3105306692c25e3082fcd76296d050b744f332d537a1 = "#version 300 es\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec3 normal;\nlayout(location = 2) in vec2 uv;\nlayout(location = 3) in vec4 color;\nlayout(location = 4) in vec4 instanceRow0;\nlayout(location = 5) in vec4 instanceRow1;\nlayout(location = 6) in vec4 instanceRow2;\nlayout(location = 7) in vec4 instanceColor;\nout vec3 worldNormal;\nout vec2 surfaceUv;\nout vec4 baseColor;\n\nmat4 instanceWorld(vec4 row0, vec4 row1, vec4 row2)\n{\n    return transpose(mat4(row0, row1, row2, vec4(0.0, 0.0, 0.0, 1.0)));\n}\n\nvec3 skinNormal(mat4 world, vec3 normal_1)\n{\n    mat3 linear = mat3(world);\n    vec3 a = cross(linear[1], linear[2]);\n    vec3 b = cross(linear[2], linear[0]);\n    vec3 c = cross(linear[0], linear[1]);\n    float direction = (dot(linear[0], a) < 0.0) ? (-1.0) : 1.0;\n    return (((a * normal_1.x) + (b * normal_1.y)) + (c * normal_1.z)) * direction;\n}\n\nvoid main()\n{\n    mat4 matrix_1 = instanceWorld(instanceRow0, instanceRow1, instanceRow2);\n    gl_Position = (mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * matrix_1) * vec4(position, 1.0);\n    worldNormal = skinNormal(matrix_1, normal);\n    surfaceUv = uv;\n    baseColor = color * instanceColor;\n    return;\n}\n";
	const TEXT_807b672036fd9d23c17a1e2b47dc9d922aa82849b417e0d8f7c01e362a10fec0 = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform highp vec4 unlitMaterialParams[2];\nuniform highp vec4 frameParams[3];\nuniform highp sampler2D baseTexture_baseSampler;\n\nin highp vec3 worldNormal;\nin highp vec2 surfaceUv;\nin highp vec4 baseColor;\nlayout(location = 0) out highp vec4 color;\nlayout(location = 1) out highp vec4 normal;\n\nhighp vec4 materialOf()\n{\n    return unlitMaterialParams[0];\n}\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 unlitShade(highp vec4 texel, highp vec4 baseColor_1, highp vec4 materialColor)\n{\n    highp vec3 surface = srgbToLinear(baseColor_1.xyz) * srgbToLinear(materialColor.xyz);\n    surface = surface * srgbToLinear(texel.xyz);\n    return vec4(linearToSrgb(surface), (baseColor_1.w * materialColor.w) * texel.w);\n}\n\nhighp vec4 materialColorOf()\n{\n    return unlitMaterialParams[1];\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n   