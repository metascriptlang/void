	const TEXT_896ebc018f95dfdc2f18c927701fedcc4a59a9a76cd48cc3900335228b328ce7 = "diagnostic(off, derivative_uniformity);\n\nstruct BillboardParams {\n  billboardColor : vec4f,\n  billboard : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  clusterGrid : vec4f,\n  clusterFactors : vec4f,\n  clusterView : vec4f,\n  clusterScreen : vec4f,\n  cookie : vec4f,\n  cookieMatrix : mat4x4f,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nconst DATA_ROW : u32 = 256u;\n\nconst RECORD_TEXELS : i32 = 6i;\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(2) @group(0) var<uniform> billboardParams : BillboardParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var billboardTexture : texture_2d<f32>;\n\n@binding(9) @group(1) var lightRecords : texture_2d<f32>;\n\n@binding(10) @group(1) var clusterRecords : texture_2d<u32>;\n\n@binding(11) @group(1) var clusterIndices : texture_2d<u32>;\n\n@binding(32) @group(1) var billboardSampler : sampler;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> towardCamera : vec3f;\n\nvar<private> uv : vec2f;\n\nvar<private> instanceColor : vec4f;\n\nvar<private> fragCoord : vec4f;\n\nvar<private> fragColor : vec4f;\n\nfn straightTexel(texel : vec4f) -> vec4f {\n  return select(vec4f(0f), vec4f((texel.xyz / texel.w), texel.w), (texel.w > 0f));\n}\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (srgb.x <= 0.04045f)), select(high.y, low.y, (srgb.y <= 0.04045f)), select(high.z, low.z, (srgb.z <= 0.04045f)));\n}\n\nfn cellOf(position : f32, cells : i32) -> i32 {\n  if ((!(position > 0f))) {\n    return 0i;\n  }\n  if ((position >= f32(cells))) {\n    return (cells - 1i);\n  }\n  return i32(position);\