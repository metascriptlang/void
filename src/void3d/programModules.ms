			fragmentCode: "#version 430\n\nuniform vec4 pbrMaterialParams[4];\nuniform vec4 frameParams[3];\nuniform vec4 lightParams[27];\nuniform vec4 shadowParams[10];\nlayout(binding = 0) uniform sampler2D baseTexture_baseSampler;\nlayout(binding = 1) uniform sampler2D metalRoughTexture_baseSampler;\nlayout(binding = 2) uniform sampler2D occlusionTexture_baseSampler;\nlayout(binding = 3) uniform sampler2D shadowMap_SPIRV_Cross_DummySampler;\nlayout(binding = 4) uniform sampler2D normalTexture_baseSampler;\nlayout(binding = 5) uniform sampler2D spotShadowMap_SPIRV_Cross_DummySampler;\nlayout(binding = 6) uniform samplerCube envDiffuse_envSampler;\nlayout(binding = 7) uniform samplerCube envSpecular_envSampler;\n\nlayout(location = 0) in vec4 worldTangent;\nlayout(location = 1) in vec3 worldPosition;\nlayout(location = 2) in vec3 worldNormal;\nlayout(location = 3) in vec2 surfaceUv;\nlayout(location = 4) in vec4 baseColor;\nlayout(location = 0) out vec4 color;\n\nvec4 materialOf()\n{\n    return pbrMaterialParams[0];\n}\n\nvec2 movedUv(vec2 uv, vec4 matrix, vec4 motion, float time)\n{\n    return ((mat2(matrix.xy, matrix.zw) * uv) + motion.xy) + (motion.zw * time);\n}\n\nvec4 uvMatrixOf()\n{\n    return pbrMaterialParams[2];\n}\n\nvec4 uvMotionOf()\n{\n    return pbrMaterialParams[3];\n}\n\nvec3 facingNormal(vec3 normal, float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-normal) : normal;\n}\n\nfloat faceOf(float doubleSided, bool frontFacing)\n{\n    return ((doubleSided > 0.5) && (!frontFacing)) ? (-1.0) : 1.0;\n}\n\nvec3 mappedNormal(vec3 normal, vec4 tangent, float face, vec3 texel)\n{\n    vec3 t = normalize(tangent.xyz);\n    float sign_1 = (tangent.w < 0.0) ? (-1.0) : 1.0;\n    vec3 bitangent = normalize(cross(normal, t)) * sign_1;\n    vec3 mapped = (texel * 2.0) - 1.0;\n    return normalize(((mapped.x * t) + (mapped.y * bitangent)) + (mapped.z * normal)) * face;\n}\n\nvec4 pbrOf()\n{\n    return pbrMaterialParams[1];\n}