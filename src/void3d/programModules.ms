			vertexCode: "#version 430\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec2 size;\nlayout(location = 2) in vec2 anchor;\nlayout(location = 3) in vec4 tile;\nlayout(location = 4) in vec4 color;\nlayout(location = 0) out vec3 worldPosition;\nlayout(location = 1) out vec3 towardCamera;\nlayout(location = 2) out vec2 uv;\nlayout(location = 3) out vec4 instanceColor;\n\nvec3 billboardPoint(vec3 position_1, vec2 size_1, vec2 anchor_1, vec2 corner, vec3 right, vec3 up)\n{\n    vec2 offset = corner - anchor_1;\n    return (position_1 + (right * (offset.x * size_1.x))) + (up * (offset.y * size_1.y));\n}\n\nvoid main()\n{\n    vec2 corner = PARTICLE_CORNERS[uint(gl_VertexID) % 6u];\n    vec3 right = vertexParams[4].xyz;\n    vec3 up = vertexParams[5].xyz;\n    vec3 world = billboardPoint(position, size, anchor, corner, right, up);\n    worldPosition = world;\n    towardCamera = cross(right, up);\n    uv = vec2((corner.x > 0.0) ? tile.z : tile.x, (corner.y > 0.0) ? tile.y : tile.w);\n    instanceColor = color;\n    gl_Position = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    return;\n}\n",
