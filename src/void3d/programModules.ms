 q : vec4f = (matrix * vec4f(position, 1f));\n  if ((q.w <= 0f)) {\n    return vec4f(0f, 0f, 0f, 0f);\n  }\n  var p : vec3f = (q.xyz / q.w);\n  if (((((p.x <= 0f) || (p.x >= 1f)) || (p.y <= 0f)) || (p.y >= 1f))) {\n    return vec4f(0f, 0f, 0f, 0f);\n  }\n  return vec4f(p, 1f);\n}\n\nfn mapLit(z : f32, depth : f32, bias : f32, opacity : f32) -> f32 {\n  var lit : f32 = select(1f, 0f, ((clamp(z, 0f, 1f) - bias) > depth));\n  return mix(1f, lit, opacity);\n}\n\nfn dirShadowAt(position : vec3f) -> f32 {\n  var p : vec4f = mapCoord(position, shadowParams.shadowMatrix);\n  if ((p.w < 0.5f)) {\n    return 1f;\n  }\n  var size : vec2i = vec2i(textureDimensions(shadowMap, 0i));\n  var texel : vec2i = clamp(vec2i((p.xy * vec2f(size))), vec2i(0i, 0i), (size - vec2i(1i, 1i)));\n  var depth : f32 = textureLoad(shadowMap, texel, 0i).x;\n  return mapLit(p.z, depth, shadowParams.shadow.x, shadowParams.shadow.y);\n}\n\nfn envTurned(d : vec3f, turn : vec4f) -> vec3f {\n  return vec3f(((d.x * turn.z) - (d.z * turn.w)), d.y, ((d.x * turn.w) + (d.z * turn.z)));\n}\n\nfn splitSum(roughness : f32, nv : f32) -> vec2f {\n  var rx : f32 = (1f - roughness);\n  var ry : f32 = (0.0425f - (0.0275f * roughness));\n  var a004 : f32 = ((min((rx * rx), exp2(((-9.28f) * nv))) * rx) + ry);\n  return max(vec2f(((((-1.04f) * a004) + 1.04f) - (0.572f * roughness)), (((1.04f * a004) - 0.04f) + (0.022f * roughness))), vec2f(0.00005f));\n}\n\nfn pbrEnvironmentLight(albedo : vec3f, metalness : f32, roughness : f32, normal : vec3f, view : vec3f, occlusion : f32) -> vec3f {\n  var n : vec3f = normalize(normal);\n  var v : vec3f = normalize(view);\n  var nv : f32 = max(dot(n, v), 0f);\n  var f0 : vec3f = mix(vec3f(0.04f), albedo, metalness);\n  var fresnel : vec3f = (f0 + ((max(vec3f((1f - roughness)), f0) - f0) * exp2(((((-5.55473f) * nv) - 6.98316f) * nv))));\n  var turn : vec4f = frameParams.envParams;\n  var irradiance : vec3f = textureSampleLevel(envDiffuse, envSampler, envTurned(n, turn), 0f).xyz;\n  var 