	const TEXT_1a09bb4555202f247dcc1a3cc0d25843c134e7ee29e61b73403e78ba6ce2a881 = "#version 300 es\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec4 root;\nlayout(location = 1) in vec4 shape;\nlayout(location = 2) in vec4 tile;\nlayout(location = 3) in vec4 color;\nlayout(location = 4) in vec3 velocity;\nlayout(location = 5) in vec4 look;\nlayout(location = 6) in vec4 scale;\nlayout(location = 7) in vec3 pull;\nlayout(location = 8) in vec3 emitterRight;\nlayout(location = 9) in vec3 emitterUp;\nout vec2 uv;\nout vec3 rootPosition;\nout vec4 instanceColor;\nout float depth01;\n\nvec3 particleVisualPoint(vec2 corner)\n{\n    vec4 root_1 = root;\n    vec4 shape_1 = shape;\n    vec3 velocity_1 = velocity;\n    vec3 pos = root_1.xyz;\n    vec3 eye = vertexParams[6].xyz;\n    vec3 camRight = vertexParams[4].xyz;\n    vec3 camUp = vertexParams[5].xyz;\n    vec3 camToward = cross(camRight, camUp);\n    vec4 kind = look;\n    vec4 scale_1 = scale;\n    vec3 emitterRight_1 = emitterRight;\n    vec3 emitterUp_1 = emitterUp;\n    float flags = kind.w;\n    bool rotateWith = flags >= 3.5;\n    if (rotateWith)\n    {\n        flags = flags - 4.0;\n    }\n    bool freeform = flags >= 1.5;\n    if (freeform)\n    {\n        flags = flags - 2.0;\n    }\n    bool noRoll = flags >= 0.5;\n    bool stretch = kind.x == 1.0;\n    float pivotX = -shape_1.y;\n    float pivotY = -shape_1.z;\n    float pivotZ = kind.z;\n    float theta = shape_1.w;\n    float c = cos(theta);\n    float s = sin(theta);\n    float root2 = 0.70710678;\n    float w = root_1.w;\n    float h = shape_1.x;\n    vec4 clipCentre = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(pos, 1.0);\n    vec4 clipRight = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(pos + camRight, 1.0);\n    float viewportWi