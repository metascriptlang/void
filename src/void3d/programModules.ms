	const TEXT_ba3e7f3f71f4ca44ecbe51f288569398a5763561740d4db43e7835c7993c55ea = "diagnostic(off, derivative_uniformity);\n\nstruct PbrMaterialParams {\n  material : vec4f,\n  pbr : vec4f,\n  uvMatrix : vec4f,\n  uvMotion : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  pointLight : array<vec4f, 4>,\n  pointColor : array<vec4f, 4>,\n  shapeA : array<vec4f, 4>,\n  shapeB : array<vec4f, 4>,\n  shapeC : array<vec4f, 4>,\n  shapeD : array<vec4f, 4>,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> pbrMaterialParams : PbrMaterialParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(1) @group(1) var metalRoughTexture : texture_2d<f32>;\n\n@binding(2) @group(1) var occlusionTexture : texture_2d<f32>;\n\n@binding(7) @group(1) var envDiffuse : texture_cube<f32>;\n\n@binding(8) @group(1) var envSpecular : texture_cube<f32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\n@binding(36) @group(1) var envSampler : sampler;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> color : vec4f;\n\nfn materialOf() -> vec4f {\n  return pbrMaterialParams.material;\n}\n\nfn movedUv(uv : vec2f, matrix : vec4f, motion : vec4f, time : f32) -> vec2f {\n  return (((mat2x2f(matrix.xy, matrix.zw) * uv) + motion.xy) + (motion.zw * time));\n}\n\nfn uvMatrixOf() -> vec4f {\n  return pbrMaterialParams.uvMatrix;\n}\n\nfn uvMotionOf() -> vec4f {\n  return pbrMaterialParams.uvMotion;\n}\n\nfn facingNormal(normal : vec3f, doubleSided : f32, frontFacing_1 : bool) -> vec3f {\n  return select(normal, (-normal), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn pbrOf