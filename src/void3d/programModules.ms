	const TEXT_e18dd99e4d098c0b12ab698b577cc1223c7388ce0a1149fe4ef6959aa4da1443 = "#version 300 es\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec3 normal;\nlayout(location = 2) in vec4 color;\nlayout(location = 3) in vec4 instanceRow0;\nlayout(location = 4) in vec4 instanceRow1;\nlayout(location = 5) in vec4 instanceRow2;\nlayout(location = 6) in vec4 instanceColor;\nout vec4 screenToLocal0;\nout vec4 screenToLocal1;\nout vec4 screenToLocal2;\nout vec4 screenToLocal3;\nout vec4 boxWorld0;\nout vec4 boxWorld1;\nout vec4 boxWorld2;\nout vec4 boxWorld3;\nout vec4 baseColor;\nout vec4 screen;\n\nmat4 instanceWorld(vec4 row0, vec4 row1, vec4 row2)\n{\n    return transpose(mat4(row0, row1, row2, vec4(0.0, 0.0, 0.0, 1.0)));\n}\n\nvoid main()\n{\n    mat4 world = instanceWorld(instanceRow0, instanceRow1, instanceRow2);\n    vec4 clip = (mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * world) * vec4(position, 1.0);\n    mat4 toLocal = inverse(world) * inverse(mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]));\n    screenToLocal0 = toLocal[0];\n    screenToLocal1 = toLocal[1];\n    screenToLocal2 = toLocal[2];\n    screenToLocal3 = toLocal[3];\n    boxWorld0 = world[0];\n    boxWorld1 = world[1];\n    boxWorld2 = world[2];\n    boxWorld3 = world[3];\n    baseColor = color * instanceColor;\n    screen = clip;\n    gl_Position = clip;\n    return;\n}\n";
