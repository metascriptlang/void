 vec3 position, highp vec3 ray, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    highp float along = dot(a.xyz, at.xyz - position) / dot(a.xyz, ray);\n    highp vec3 offset = (position + (ray * along)) - at.xyz;\n    return (at.xyz + (b.xyz * clamp(dot(offset, b.xyz), -b.w, b.w))) + (c.xyz * clamp(dot(offset, c.xyz), -c.w, c.w));\n}\n\nhighp float rectangleAxisCone(highp vec3 delta, highp vec3 forward, highp vec3 excluded, highp float outer, highp float inner)\n{\n    highp vec3 projectedDelta = delta - (excluded * dot(delta, excluded));\n    highp vec3 projectedLight = (-forward) - (excluded * dot(-forward, excluded));\n    highp float deltaLength = length(projectedDelta);\n    highp float lightLength = length(projectedLight);\n    if ((deltaLength < 0.0001) || (lightLength < 0.0001))\n    {\n        return 0.0;\n    }\n    highp float theta = dot(projectedDelta, projectedLight) / (deltaLength * lightLength);\n    return clamp((theta - outer) / ((inner - outer) + 0.00001), 0.0, 1.0);\n}\n\nhighp vec4 rectangleSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (abs(dot(a.xyz, normal)) < 0.000001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 delta = rectanglePoint(position, normal, at, a, b, c) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp float cone = rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w);\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 spotSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 delta = at.xyz - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 toLight = delta / distance_1;\n    highp float cone = clamp((dot(toLight, -a.xyz) - b.x) / (b.y - b.x), 0.0, 1.0);\n    return vec4(toLight, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 shapedSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSample(position, at, tint, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSample(position, normal, at, tint, a, b, c, d);\n    }\n    return spotSample(position, at, tint, a, b);\n}\n\nhighp vec3 lightAt(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    highp vec3 lit = vec3(0.0);\n    if (a.w < 0.5)\n    {\n        lit = pointLightAt(position, normal, at, tint);\n    }\n    else\n    {\n        {\n            highp vec4 sample_1 = shapedSample(position, normal, at, tint, a, b, c, d);\n            lit = srgbToLinear(tint.xyz) * ((sample_1.w * max(dot(normal, sample_1.xyz), 0.0)) * at.w);\n        }\n    }\n    return lit;\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n        highp float desaturation = 0.15;\n        highp float x = min(exposed.x, min(exposed.y, exposed.z));\n        highp float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        highp vec3 color = exposed - offset;\n        highp float peak = max(color.x, max(color.y, color.z));\n        if (peak >= startCompression)\n        {\n            highp float d = 1.0 - startCompression;\n            highp float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color = color * (newPeak / peak);\n            highp float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color = mix(color, vec3(newPeak), g);\n        }\n        return color;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 texel = texture(billboardTexture_billboardSampler, uv);\n    highp vec4 pixel = (billboardParams[0] * texel) * instanceColor;\n    if (billboardParams[1].y != 0.0)\n    {\n        highp vec3 n = normalize(towardCamera);\n        highp vec4 dir = lightParams[1];\n        highp float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n        highp vec3 light = srgbToLinear(lightParams[0].xyz) + (srgbToLinear(lightParams[2].xyz) * lambert);\n        for (highp int i = 0; i < int(lightParams[0].w + 0.5); i++)\n        {\n            light = light + lightAt(worldPosition, n, lightParams[3 + i], lightParams[7 + i], lightParams[11 + i], lightParams[15 + i], lightParams[19 + i], lightParams[23 + i]);\n        }\n        pixel = vec4(linearToSrgb(srgbToLinear(pixel.xyz) * light), pixel.w);\n    }\n    pixel = vec4(toneMapped(pixel.xyz, frameParams[0]), pixel.w);\n    fragColor = pixel;\n    return;\n}\n";
	const TEXT_5da0adb5a9bd5b88a78ce3e2a2c6ebfa4a01717026499721501801c7370fd6e5 = "#version 300 es\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec4 root;\nlayout(location = 1) in vec4 shape;\nlayout(location = 2) in vec4 tile;\nlayout(location = 3) in vec4 color;\nlayout(location = 4) in vec3 velocity;\nlayout(location = 5) in vec4 look;\nlayout(location = 6) in vec4 scale;\nlayout(location = 7) in vec3 pull;\nlayout(location = 8) in vec3 emitterRight;\nlayout(location = 9) in vec3 emitterUp;\nout vec3 worldPosition;\nout vec3 towardCamera;\nout vec2 uv;\nout vec4 instanceColor;\n\nvec3 particleVisualPoint(vec2 corner)\n{\n    vec4 root_1 = root;\n    vec4 shape_1 = shape;\n    vec3 velocity_1 = velocity;\n    vec3 pos = root_1.xyz;\n    vec3 eye = vertexParams[6].xyz;\n    vec3 camRight = vertexParams[4].xyz;\n    vec3 camUp = vertexParams[5].xyz;\n    vec3 camToward = cross(camRight, camUp);\n    vec4 kind = look;\n    vec4 scale_1 = scale;\n    vec3 emitterRight_1 = emitterRight;\n    vec3 emitterUp_1 = emitterUp;\n    float flags = kind.w;\n    bool rotateWith = flags >= 3.5;\n    if (rotateWith)\n    {\n        flags = flags - 4.0;\n    }\n    bool freeform = flags >= 1.5;\n    if (freeform)\n    {\n        flags = flags - 2.0;\n    }\n    bool noRoll = flags >= 0.5;\n    bool stretch = kind.x == 1.0;\n    float pivotX = -shape_1.y;\n    float pivotY = -shape_1.z;\n    float pivotZ = kind.z;\n    float theta = shape_1.w;\n    float c = cos(theta);\n    float s = sin(theta);\n    float root2 = 0.70710678;\n    float w = root_1.w;\n    float h = shape_1.x;\n    vec4 clipCentre = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(pos, 1.0);\n    vec4 clipRight = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(pos + camRight, 1.0);\n    float viewportWidth = (2.0 * clipCentre.w) / (clipRight.x - clipCentre.x);\n    float big = max(w, h);\n    float fit = 1.0;\n    if ((scale_1.w > 0.0) && (big > (scale_1.w * viewportWidth)))\n    {\n        fit = (scale_1.w * viewportWidth) / big;\n    }\n    if (((scale_1.z > 0.0) && (big > 0.0)) && (big < (scale_1.z * viewportWidth)))\n    {\n        fit = (scale_1.z * viewportWidth) / big;\n    }\n    float speed = length(velocity_1);\n    vec3 along = velocity_1 / max(speed, 0.000001);\n    vec3 toParticle = pos - eye;\n    if (stretch)\n    {\n        if (freeform)\n        {\n            vec3 f = normalize(toParticle);\n            vec3 right = normalize(cross(f, camUp));\n            vec3 up = cross(right, f);\n            float angle = theta;\n            if (rotateWith && (speed > 0.000001))\n            {\n                angle = angle + atan(dot(along, up), -dot(along, right));\n            }\n            float ca = cos(angle);\n            float sa = sin(angle);\n            float fw = w * fit;\n            float fh = h * fit;\n            vec3 o = ((((right * ca) - (up * sa)) * ((corner.x + pivotX) * fw)) + (((up * ca) + (right * sa)) * ((corner.y + pivotY) * fh))) + (f * (pivotZ * fw));\n            float grow = (scale_1.x + ((speed * scale_1.y) / max(fh, 0.000001))) - 1.0;\n            o = o + (along * (grow * dot(o, along)));\n            return pos + o;\n        }\n        if (speed < 0.000001)\n        {\n            return pos;\n        }\n        vec3 pull_1 = ((along * (h * scale_1.x)) + (velocity_1 * scale_1.y)) - pull;\n        float length3 = length(pull_1);\n        vec3 axis = pull_1 / max(length3, 0.000001);\n        vec3 forward = -camToward;\n        vec3 across = cross(toParticle, axis);\n        vec3 flat_1 = across - (forward * dot(across, forward));\n        vec3 width = flat_1 / max(length(flat_1), 0.000001);\n        float fw_1 = w * fit;\n        vec3 head = (pos + (width * (pivotX * fw_1))) + (axis * ((2.0 * pivotY) * h));\n        return (head + (width * (corner.y * fw_1))) - (axis * ((corner.x + 0.5) * length3));\n    }\n    w = w * fit;\n    h = h * fit;\n    if ((kind.x == 2.0) || (kind.x == 3.0))\n    {\n        vec3 right_1 = vec3(1.0, 0.0, 0.0);\n        vec3 up_1 = vec3(0.0, 0.0, -1.0);\n        vec3 normal = vec3(0.0, 1.0, 0.0);\n        if (kind.x == 3.0)\n        {\n            right_1 = normalize(vec3(camToward.z, 0.0, camRight.z));\n            up_1 = vec3(0.0, 1.0, 0.0);\n            normal = cross(right_1, up_1);\n        }\n        float x = 2.0 * corner.x;\n        float y = 2.0 * corner.y;\n        float ox = (((0.5 * w) * ((x * c) + (y * s))) * root2) + (((pivotX * w) * (c - s)) * root2);\n        float oy = (((0.5 * h) * ((y * c) - (x * s))) * root2) + (((pivotY * h) * (c + s)) * root2);\n        return ((pos + (right_1 * ox)) + (up_1 * oy)) + (normal * (pivotZ * w));\n    }\n    vec3 right_2 = camRight;\n    vec3 up_2 = camUp;\n    vec3 normal_1 = camToward;\n    if ((kind.y == 0.0) && noRoll)\n    {\n        right_2 = normalize(cross(-camToward, vec3(0.0, 1.0, 0.0)));\n        up_2 = cross(right_2, -camToward);\n    }\n    if (kind.y == 1.0)\n    {\n        right_2 = vec3(1.0, 0.0, 0.0);\n        up_2 = vec3(0.0, 1.0, 0.0);\n        normal_1 = vec3(0.0, 0.0, -1.0);\n    }\n    if (kind.y == 2.0)\n    {\n        right_2 = emitterRight_1;\n        up_2 = emitterUp_1;\n        normal_1 = -cross(right_2, up_2);\n    }\n    if (kind.y == 3.0)\n    {\n        normal_1 = normalize(toParticle);\n        right_2 = normalize(cross(normal_1, camUp));\n        up_2 = cross(right_2, normal_1);\n    }\n    if (kind.y == 4.0)\n    {\n        normal_1 = along;\n        right_2 = normalize(cross(vec3(0.0, 0.0, 1.0), normal_1));\n        up_2 = cross(right_2, normal_1);\n    }\n    float x_1 = (corner.x + pivotX) * w;\n    float y_1 = (corner.y + pivotY) * h;\n    return ((pos + (((right_2 * c) - (up_2 * s)) * x_1)) + (((up_2 * c) + (right_2 * s)) * y_1)) + (normal_1 * (pivotZ * w));\n}\n\nvoid m