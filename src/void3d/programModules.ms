distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w));\n}\n\nhighp float spotShadowAt(highp vec3 position, highp vec3 normal)\n{\n    highp vec4 receiver = shadowParams[25];\n    highp vec3 biased = position + (normal * (receiver.x * length(position - receiver.yzw)));\n    highp vec4 p = mapCoord(biased, mat4(shadowParams[20], shadowParams[21], shadowParams[22], shadowParams[23]));\n    if (p.w < 0.5)\n    {\n        return 1.0;\n    }\n    highp int size = int(shadowParams[24].z + 0.5);\n    highp float scale = shadowParams[24].w;\n    if (scale <= 0.0)\n    {\n        highp float depth = texelFetch(spotShadowMap_SPIRV_Cross_DummySampler, ivec3(pcfTexelOf(p, size, vec2(0.0)), 0), 0).x;\n        return mapLit(p.z, depth, shadowParams[24].x, shadowParams[24].y);\n    }\n    highp vec2 rotation = poissonRotation(biased);\n    highp float lit = 0.0;\n    for (highp int tap = 0; tap < PCF_SAMPLES; tap++)\n    {\n        highp ivec2 at = pcfTexelOf(p, size, poissonOffset(tap, rotation, scale));\n        highp float depth_1 = texelFetch(spotShadowMap_SPIRV_Cross_DummySampler, ivec3(at, 0), 0).x;\n        lit = lit + mapLit(p.z, depth_1, shadowParams[24].x, shadowParams[24].y);\n    }\n    return lit / float(PCF_SAMPLES);\n}\n\nhighp int cubeFaceOf(highp vec3 toPosition)\n{\n    highp vec3 axes = abs(toPosition);\n    if ((axes.x >= axes.y) && (axes.x >= axes.z))\n    {\n        return (toPosition.x > 0.0) ? 0 : 1;\n    }\n    if (axes.y >= axes.z)\n    {\n        return (toPosition.y > 0.0) ? 2 : 3;\n    }\n    return (toPosition.z > 0.0) ? 4 : 5;\n}\n\nhighp float cubeTapAt(highp vec3 position)\n{\n    highp vec3 toPosition = position - shadowParams[51].xyz;\n    highp int face = cubeFaceOf(toPosition);\n    highp vec4 p = mapCoord(position, mat4(shadowParams[26 + face * 4], shadowParams[27 + face * 4], shadowParams[28 + face * 4], shadowParams[29 + face * 4]));\n    if (p.w < 0.5)\n    {\n        return 1.0;\n    }\n    highp int size = int(shadowParams[50].z + 0.5);\n    highp float depth = texelFetch(cubeShadowMap_SPIRV_Cross_DummySampler, ivec3(pcfTexelOf(p, size, vec2(0.0)), face), 0).x;\n    highp float near = shadowParams[52].x;\n    highp float far = shadowParams[52].y;\n    highp vec3 axes = abs(toPosition);\n    highp float axis = max(axes.x, max(axes.y, axes.z));\n    highp float distance_1 = length(toPosition);\n    highp float stored = ((near * far) / (far - (depth * (far - near)))) * (distance_1 / axis);\n    return mapLit(distance_1 / far, stored / far, shadowParams[50].x / far, shadowParams[50].y);\n}\n\nhighp float cubeShadowAt(highp vec3 position, highp vec3 normal)\n{\n    highp float scale = shadowParams[50].w / shadowParams[50].z;\n    highp vec3 light = shadowParams[51].xyz;\n    highp vec3 at = position + (normal * (shadowParams[52].z * length(position - light)));\n    highp vec3 toPosition = at - light;\n    highp float distance_1 = length(toPosition);\n    highp float lit = 0.0;\n    if ((!(scale > 0.0)) || (!(distance_1 > 0.0)))\n    {\n        lit = cubeTapAt(at);\n    }\n    else\n    {\n        {\n            highp vec3 direction = toPosition / distance_1;\n            for (highp int tap = 0; tap < CUBE_PCF_SAMPLES; tap++)\n            {\n                highp vec3 turned = normalize(direction + (CUBE_PCF_OFFSETS[tap] * scale));\n                lit = lit + cubeTapAt(light + (turned * distance_1));\n            }\n            lit = lit / float(CUBE_PCF_SAMPLES);\n        }\n    }\n    return lit;\n}\n\nhighp float recordShadowAt(highp vec3 position, highp vec3 normal, highp int i)\n{\n    highp float lit = 1.0;\n    highp float named = float(i + 1);\n    if (lightParams[0].w == named)\n    {\n        lit = spotShadowAt(position, normal);\n    }\n    else\n    {\n        if (lightParams[2].w == named)\n        {\n            lit = cubeShadowAt(position, normal);\n        }\n    }\n    return lit;\n}\n\nhighp vec4 capsuleSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 start = at.xyz - (a.xyz * b.x);\n    highp vec3 segment = a.xyz * (2.0 * b.x);\n    highp float along = clamp(dot(position - start, segment) / dot(segment, segment), 0.0, 1.0);\n    highp vec3 delta = (start + (segment * along)) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w));\n}\n\nhighp vec3 rectanglePoint(highp vec3 position, highp vec3 ray, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    highp float along = dot(a.xyz, at.xyz - position) / dot(a.xyz, ray);\n    highp vec3 offset = (position + (ray * along)) - at.xyz;\n    return (at.xyz + (b.xyz * clamp(dot(offset, b.xyz), -b.w, b.w))) + (c.xyz * clamp(dot(offset, c.xyz), -c.w, c.w));\n}\n\nhighp float rectangleAxisCone(highp vec3 delta, highp vec3 forward, highp vec3 excluded, highp float outer, highp float inner)\n{\n    highp vec3 projectedDelta = delta - (excluded * dot(delta, excluded));\n    highp vec3 projectedLight = (-forward) - (excluded * dot(-forward, excluded));\n    highp float deltaLength = length(projectedDelta);\n    highp float lightLength = length(projectedLight);\n    if ((deltaLength < 0.0001) || (lightLength < 0.0001))\n    {\n        return 0.0;\n    }\n    highp float theta = dot(projectedDelta, projectedLight) / (deltaLength * lightLength);\n    return clamp((theta - outer) / ((inner - outer) + 0.00001), 0.0, 1.0);\n}\n\nhighp vec4 rectangleSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (abs(dot(a.xyz, normal)) < 0.000001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 delta = rectanglePoint(position, normal, at, a, b, c) - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp float cone = rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w);\n    return vec4(delta / distance_1, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 spotSample(highp vec3 position, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b)\n{\n    highp vec3 delta = at.xyz - position;\n    highp float distance_1 = length(delta);\n    if (distance_1 < 0.0001)\n    {\n        return vec4(0.0);\n    }\n    highp vec3 toLight = delta / distance_1;\n    highp float cone = clamp((dot(toLight, -a.xyz) - b.x) / (b.y - b.x), 0.0, 1.0);\n    return vec4(toLight, lightWindow(distance_1, tint.w) * cone);\n}\n\nhighp vec4 shapedSample(highp vec3 position, highp vec3 normal, highp vec4 at, highp vec4 tint, highp vec4 a, highp vec4 b, highp vec4 c, highp vec4 d)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSample(position, at, tint, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSample(position, normal, at, tint, a, b, c, d);\n    }\n    return spotSample(position, at, tint, a, b);\n}\n\nhighp vec3 capsuleSpecularDir(highp vec3 position, highp vec3 reflected, highp vec3 diffuse, highp vec4 at, highp vec4 a, highp vec4 b)\n{\n    highp vec3 l0 = (at.xyz - (a.xyz * b.x)) - position;\n    highp vec3 l01 = a.xyz * (2.0 * b.x);\n    highp float squared = dot(l01, l01);\n    highp float alongRay = dot(reflected, l01);\n    highp float denominator = squared - (alongRay * alongRay);\n    if (denominator <= 0.000001)\n    {\n        return diffuse;\n    }\n    highp vec3 closest = l0 + (l01 * clamp(dot(l0, (reflected * alongRay) - l01) / denominator, 0.0, 1.0));\n    highp vec3 centerToRay = (reflected * dot(closest, reflected)) - closest;\n    highp float offset = length(centerToRay);\n    if (offset < 0.000001)\n    {\n        return normalize(closest);\n    }\n    return normalize(closest + (centerToRay * clamp(b.y / offset, 0.0, 1.0)));\n}\n\nhighp vec3 rectangleSpecularDir(highp vec3 position, highp vec3 reflected, highp vec3 diffuse, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    if (abs(dot(a.xyz, reflected)) < 0.000001)\n    {\n        return diffuse;\n    }\n    return normalize(rectanglePoint(position, reflected, at, a, b, c) - position);\n}\n\nhighp vec3 shapedSpecularDir(highp vec3 position, highp vec3 reflected, highp vec3 diffuse, highp vec4 at, highp vec4 a, highp vec4 b, highp vec4 c)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSpecularDir(position, reflected, diffuse, at, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSpecularDir(position, reflected, diffuse, at, a, b, c);\n    }\n    return diffuse;\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 pbrShade(highp vec3 n, highp vec3 surfaceNormal, highp vec3 position, highp vec2 frag, highp vec4 surfaceColor, highp vec3 values)\n{\n    highp vec3 albedo = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n    highp vec3 view = frameParams[1].xyz - position;\n    highp vec4 dir = lightParams[1];\n    highp float shadow = 1.0;\n    shadow = dirShadowAt(position, surfaceNormal);\n    highp vec3 sun = srgbToLinear(lightParams[2].xyz) * dir.w;\n    highp vec3 light = vec3(0.0);\n    if (frameParams[2].x > 0.0)\n    {\n        light = pbrEnvironmentLight(albedo, values.x, values.y, n, view, values.z);\n    }\n    else\n    {\n        {\n            light = pbrAmbient(albedo, values.x, values.y, n, view, srgbToLinear(lightParams[0].xyz), values.z);\n        }\n    }\n    light = light + pbrDirect(albedo, values.x, values.y, n, view, dir.xyz, sun, shadow, 0.0, values.z);\n    highp vec3 eye = normalize(view);\n    highp vec3 reflected = (-eye) - (n * (2.0 * dot(-eye, n)));\n    highp ivec4 cluster = litClusterOf(frag, position);\n    for (highp int k = 0; k < (cluster.y + cluster.z); k++)\n    {\n        highp int i = litLightOf(cluster, k);\n        highp vec4 at = litTexelOf(i, 0);\n        highp vec4 tint = litTexelOf(i, 1);\n        highp vec4 a = litTexelOf(i, 2);\n        highp vec4 bb = litTexelOf(i, 3);\n        highp vec4 cookie = recordCookieAt(position, i);\n        if (cookie.w > 0.5)\n        {\n            highp vec4 sample_1 = cookieSpotSample(position, at, tint);\n            highp vec3 radiance = (srgbToLinear(tint.xyz) * cookie.xyz) * (sample_1.w * at.w);\n            light = light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample_1.xyz, sample_1.xyz, radiance, recordShadowAt(position, surfaceNormal, i), 0.0, values.z);\n        }\n        else\n        {\n            if (a.w < 0.5)\n            {\n                highp vec3 toLight = at.xyz - position;\n                highp float falloff = clamp(1.0 - (length(toLight) / tint.w), 0.0, 1.0);\n                highp vec3 radiance_1 = srgbToLinear(tint.xyz) * ((falloff * falloff) * at.w);\n                light = light + pbrDirect(albedo, values.x, values.y, n, view, toLight, radiance_1, recordShadowAt(position, surfaceNormal, i), 0.0, values.z);\n            }\n            else\n            {\n                {\n                    highp vec4 cc = litTexelOf(i, 4);\n                    highp vec4 sample_2 = shapedSample(position, n, at, tint, a, bb, cc, litTexelOf(i, 5));\n                    highp vec3 radiance_2 = srgbToLinear(tint.xyz) * (sample_2.w * at.w);\n                    highp vec3 specular = shapedSpecularDir(position, reflected, sample_2.xyz, at, a, bb, cc);\n                    light = light + pbrDirectSpecular(albedo, values.x, values.y, n, view, sample_2.xyz, specular, radiance_2, recordShadowAt(position, surfaceNormal, i), 0.0, values.z);\n                }\n            }\n        }\n    }\n    return 