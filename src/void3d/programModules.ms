.xyz - (a.xyz * b.x)) - position);\n  var l01 : vec3f = (a.xyz * (2f * b.x));\n  var squared : f32 = dot(l01, l01);\n  var alongRay : f32 = dot(reflected, l01);\n  var denominator : f32 = (squared - (alongRay * alongRay));\n  if ((denominator <= 0.000001f)) {\n    return diffuse;\n  }\n  var closest : vec3f = (l0 + (l01 * clamp((dot(l0, ((reflected * alongRay) - l01)) / denominator), 0f, 1f)));\n  var centerToRay : vec3f = ((reflected * dot(closest, reflected)) - closest);\n  var offset : f32 = length(centerToRay);\n  if ((offset < 0.000001f)) {\n    return normalize(closest);\n  }\n  return normalize((closest + (centerToRay * clamp((b.y / offset), 0f, 1f))));\n}\n\nfn rectangleSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  if ((abs(dot(a.xyz, reflected)) < 0.000001f)) {\n    return diffuse;\n  }\n  return normalize((rectanglePoint(position, reflected, at, a, b, c) - position));\n}\n\nfn shapedSpecularDir(position : vec3f, reflected : vec3f, diffuse : vec3f, at : vec4f, a : vec4f, b : vec4f, c : vec4f) -> vec3f {\n  if ((a.w > 2.5f)) {\n    return capsuleSpecularDir(position, reflected, diffuse, at, a, b);\n  }\n  if ((a.w > 1.5f)) {\n    return rectangleSpecularDir(position, reflected, diffuse, at, a, b, c);\n  }\n  return diffuse;\n}\n\nfn spotShadowAt(position : vec3f) -> f32 {\n  var p : vec4f = mapCoord(position, shadowParams.spotMatrix);\n  if ((p.w < 0.5f)) {\n    return 1f;\n  }\n  var size : vec2i = vec2i(textureDimensions(spotShadowMap, 0i));\n  var texel : vec2i = clamp(vec2i((p.xy * vec2f(size))), vec2i(0i, 0i), (size - vec2i(1i, 1i)));\n  var depth : f32 = textureLoad(spotShadowMap, texel, 0i).x;\n  return mapLit(p.z, depth, shadowParams.spotShadow.x, shadowParams.spotShadow.y);\n}\n\nfn slotShadowAt(position : vec3f, slot : i32) -> f32 {\n  var a : vec4f = lightParams.shapeA[slot];\n  if ((((a.w < 0.5f) || (a.w > 1.5f)) || (lightParams.shapeB[slot].z < 0.5f))) {\n    return 1