it;\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 litShade(highp vec3 n, highp vec3 surfaceNormal, highp vec3 position, highp vec2 frag, highp vec4 surfaceColor)\n{\n    highp vec4 dir = lightParams[1];\n    highp float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n    highp vec3 ambient = srgbToLinear(lightParams[0].xyz);\n    highp vec3 light = ambient + (srgbToLinear(lightParams[2].xyz) * lambert);\n    highp ivec4 cluster = litClusterOf(frag, position);\n    for (highp int k = 0; k < (cluster.y + cluster.z); k++)\n    {\n        highp int i = litLightOf(cluster, k);\n        highp vec4 at = litTexelOf(i, 0);\n        highp vec4 tint = litTexelOf(i, 1);\n        highp vec4 cookie = recordCookieAt(position, i);\n        highp vec3 lit = vec3(0.0);\n        if (cookie.w > 0.5)\n        {\n            highp vec4 sample_1 = cookieSpotSample(position, at, tint);\n            lit = (srgbToLinear(tint.xyz) * cookie.xyz) * ((sample_1.w * max(dot(n, sample_1.xyz), 0.0)) * at.w);\n        }\n        else\n        {\n            {\n                lit = lightAt(position, n, at, tint, litTexelOf(i, 2), litTexelOf(i, 3), litTexelOf(i, 4), litTexelOf(i, 5));\n            }\n        }\n        light = light + (lit * recordShadowAt(position, surfaceNormal, i));\n    }\n    highp vec3 surface = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n    return vec4(linearToSrgb(surface * light), surfaceColor.w);\n}\n