\n  }\n  if ((channel == 2u)) {\n    return words.z;\n  }\n  return words.w;\n}\n\nfn indexTexelOf(j : i32) -> vec2i {\n  return dataTexelOf(vec2i(vec2u((vec2u(vec2i(j, 0i)).x / 4u), 0u)).x);\n}\n\nfn litLightOf(cluster : vec4i, k : i32) -> i32 {\n  var j : i32 = (cluster.x + k);\n  return indexOfWord(textureLoad(clusterIndices, indexTexelOf(j), 0i), j);\n}\n\nfn toonPointLightAt(position : vec3f, normal_1 : vec3f, at : vec4f, tint : vec4f, normalWeight : f32, levels : f32) -> vec3f {\n  var toLight : vec3f = (at.xyz - position);\n  var distance_1 : f32 = length(toLight);\n  var falloff : f32 = clamp((1f - (distance_1 / tint.w)), 0f, 1f);\n  var facing : f32 = mix(1f, max(dot(normal_1, (toLight / max(distance_1, 0.0001f))), 0f), normalWeight);\n  var energy : f32 = (((falloff * falloff) * facing) * at.w);\n  var level : f32 = (floor(((energy * levels) + 0.35f)) / levels);\n  return (srgbToLinear(tint.xyz) * level);\n}\n\nfn recordTexelOf(light : i32, texel : i32) -> vec2i {\n  return dataTexelOf(((light * RECORD_TEXELS) + texel));\n}\n\nfn litTexelOf(light : i32, texel : i32) -> vec4f {\n  return textureLoad(lightRecords, recordTexelOf(light, texel), 0i);\n}\n\nfn saturated(rgb : vec3f, amount : f32) -> vec3f {\n  if ((amount == 0f)) {\n    return rgb;\n  }\n  var luma : f32 = dot(rgb, vec3f(0.212671f, 0.71516f, 0.072169f));\n  var keep : f32 = (amount + 1f);\n  return ((rgb * keep) + vec3f((luma * (1f - keep))));\n}\n\nfn linearToSrgb(rgb : vec3f) -> vec3f {\n  var low : vec3f = (rgb * 12.92f);\n  var high : vec3f = ((vec3f(1.055f) * pow(max(rgb, vec3f(0f)), vec3f(0.41666f))) - vec3f(0.055f));\n  return vec3f(select(high.x, low.x, (rgb.x <= 0.0031308f)), select(high.y, low.y, (rgb.y <= 0.0031308f)), select(high.z, low.z, (rgb.z <= 0.0031308f)));\n}\n\nfn toonShade(n : vec3f, surfaceNormal : vec3f, position : vec3f, frag : vec2f, surfaceColor : vec4f) -> vec4f {\n  var params : vec4f = materialOf();\n  var dir : vec4f = lightParams.dirLight;\n  var lambert : f32 = (