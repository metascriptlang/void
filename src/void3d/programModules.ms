f, c : vec4f) -> vec3f {\n  var along : f32 = (dot(a.xyz, (at.xyz - position)) / dot(a.xyz, ray));\n  var offset : vec3f = ((position + (ray * along)) - at.xyz);\n  return ((at.xyz + (b.xyz * clamp(dot(offset, b.xyz), (-b.w), b.w))) + (c.xyz * clamp(dot(offset, c.xyz), (-c.w), c.w)));\n}\n\nfn rectangleAxisCone(delta : vec3f, forward : vec3f, excluded : vec3f, outer : f32, inner : f32) -> f32 {\n  var projectedDelta : vec3f = (delta - (excluded * dot(delta, excluded)));\n  var projectedLight : vec3f = ((-forward) - (excluded * dot((-forward), excluded)));\n  var deltaLength : f32 = length(projectedDelta);\n  var lightLength : f32 = length(projectedLight);\n  if (((deltaLength < 0.0001f) || (lightLength < 0.0001f))) {\n    return 0f;\n  }\n  var theta : f32 = (dot(projectedDelta, projectedLight) / (deltaLength * lightLength));\n  return clamp(((theta - outer) / ((inner - outer) + 0.00001f)), 0f, 1f);\n}\n\nfn rectangleSample(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec4f {\n  if ((abs(dot(a.xyz, normal)) < 0.000001f)) {\n    return vec4f(0f);\n  }\n  var delta : vec3f = (rectanglePoint(position, normal, at, a, b, c) - position);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  var cone : f32 = (rectangleAxisCone(delta, a.xyz, c.xyz, d.x, d.y) * rectangleAxisCone(delta, a.xyz, b.xyz, d.z, d.w));\n  return vec4f((delta / distance_1), (lightWindow(distance_1, tint.w) * cone));\n}\n\nfn spotSample(position : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f) -> vec4f {\n  var delta : vec3f = (at.xyz - position);\n  var distance_1 : f32 = length(delta);\n  if ((distance_1 < 0.0001f)) {\n    return vec4f(0f);\n  }\n  var toLight : vec3f = (delta / distance_1);\n  var cone : f32 = clamp(((dot(toLight, (-a.xyz)) - b.x) / (b.y - b.x)), 0f, 1f);\n  return vec4f(toLight, (lightWindow(distance_1, tint.w) * cone));\n}\n\nfn shapedSample(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec4f {\n  if ((a.w > 2.5f)) {\n    return capsuleSample(position, at, tint, a, b);\n  }\n  if ((a.w > 1.5f)) {\n    return rectangleSample(position, normal, at, tint, a, b, c, d);\n  }\n  return spotSample(position, at, tint, a, b);\n}\n\nfn linearToSrgb(rgb : vec3f) -> vec3f {\n  var low : vec3f = (rgb * 12.92f);\n  var high : vec3f = ((vec3f(1.055f) * pow(max(rgb, vec3f(0f)), vec3f(0.41666f))) - vec3f(0.055f));\n  return vec3f(select(high.x, low.x, (rgb.x <= 0.0031308f)), select(high.y, low.y, (rgb.y <= 0.0031308f)), select(high.z, low.z, (rgb.z <= 0.0031308f)));\n}\n\nfn pointLightAt(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f) -> vec3f {\n  var toLight : vec3f = (at.xyz - position);\n  var distance_1 : f32 = length(toLight);\n  var falloff : f32 = clamp((1f - (distance_1 / tint.w)), 0f, 1f);\n  var facing : f32 = max(dot(normal, (toLight / max(distance_1, 0.0001f))), 0f);\n  return (srgbToLinear(tint.xyz) * (((falloff * falloff) * facing) * at.w));\n}\n\nfn lightAt(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec3f {\n  var lit : vec3f = vec3f(0f);\n  if ((a.w < 0.5f)) {\n    lit = pointLightAt(position, normal, at, tint);\n  } else {\n    {\n      var sample : vec4f = shapedSample(position, normal, at, tint, a, b, c, d);\n      lit = (srgbToLinear(tint.xyz) * ((sample.w * max(dot(normal, sample.xyz), 0f)) * at.w));\n    }\n  }\n  return lit;\n}\n\nfn litShade(n : vec3f, surfaceNormal : vec3f, position : vec3f, frag : vec2f, surfaceColor : vec4f) -> vec4f {\n  var dir : vec4f = lightParams.dirLight;\n  var lambert : f32 = (max(dot(n, dir.xyz), 0f) * dir.w);\n  var ambient : vec3f = srgbToLinear(lightParams.ambient.xyz);\n  var light : vec3f = (ambient + (srgbToLinear(lightParams.dirColor.xyz) * lambert));\n  var cluster : vec4i = litClusterOf(frag, position);\n  for (var k : i32 = 0i; (k < (cluster.