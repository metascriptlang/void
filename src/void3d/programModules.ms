	const TEXT_e0677528c95dfc3753c9d850831a6f4a46aa9f71cd8bb54953c95c1958cb19a7 = "#version 430\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec3 normal;\nlayout(location = 2) in vec4 color;\nlayout(location = 3) in vec4 instanceRow0;\nlayout(location = 4) in vec4 instanceRow1;\nlayout(location = 5) in vec4 instanceRow2;\nlayout(location = 6) in vec4 instanceColor;\nlayout(location = 0) out vec4 screenToLocal0;\nlayout(location = 1) out vec4 screenToLocal1;\nlayout(location = 2) out vec4 screenToLocal2;\nlayout(location = 3) out vec4 screenToLocal3;\nlayout(location = 4) out vec4 boxWorld0;\nlayout(location = 5) out vec4 boxWorld1;\nlayout(location = 6) out vec4 boxWorld2;\nlayout(location = 7) out vec4 boxWorld3;\nlayout(location = 8) out vec4 baseColor;\nlayout(location = 9) out vec4 screen;\n\nmat4 instanceWorld(vec4 row0, vec4 row1, vec4 row2)\n{\n    return transpose(mat4(row0, row1, row2, vec4(0.0, 0.0, 0.0, 1.0)));\n}\n\nvoid main()\n{\n    mat4 world = instanceWorld(instanceRow0, instanceRow1, instanceRow2);\n    vec4 clip = (mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * world) * vec4(position, 1.0);\n    mat4 toLocal = inverse(world) * inverse(mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]));\n    screenToLocal0 = toLocal[0];\n    screenToLocal1 = toLocal[1];\n    screenToLocal2 = toLocal[2];\n    screenToLocal3 = toLocal[3];\n    boxWorld0 = world[0];\n    boxWorld1 = world[1];\n    boxWorld2 = world[2];\n    boxWorld3 = world[3];\n    baseColor = color * instanceColor;\n    screen = clip;\n    gl_Position = clip;\n    return;\n}\n";
	const TEXT_f0312ffb987d9dd9b578e73d1f9bbca0f769a778f7fd64fa9733154053f60e9a = "#version 430\n\nuniform vec4 frameParams[3];\nuniform vec4 decalParams[4];\nlayout(binding = 0) uniform sampler2D decalTexture_decalSampler;\nlayout(binding = 1) uniform sampler2D sceneDepth_SPIRV_Cross_DummySampler;\n\nlayout(location = 0) in vec4 screenToLocal0;\nlayout(location = 1) in vec4 screenToLocal1;\nlayout(location = 2) in vec4 screenToLocal2;\nlayout(location = 3) in vec4 screenToLocal3;\nlayout(location = 4) in vec4 boxWorld0;\nlayout(location = 5) in vec4 boxWorld1;\nlayout(location = 6) in vec4 boxWorld2;\nlayout(location = 7) in vec4 boxWorld3;\nlayout(location = 8) in vec4 baseColor;\nlayout(location = 9) in vec4 screen;\nlayout(location = 0) out vec4 fragColor;\n\nbool demoted = false;\n\nvec3 decalLocalAt(vec2 screen_1, float depth, mat4 screenToLocal)\n{\n    vec4 local = screenToLocal * vec4(screen_1.x, screen_1.y, depth, 1.0);\n    return local.xyz / local.w;\n}\n\nfloat ndcDepthOf(float stored, float zeroToOne)\n{\n    return (zeroToOne == 1.0) ? stored : ((stored * 2.0) - 1.0);\n}\n\nvec3 decalLocalAtPixel(ivec2 pixel, vec2 ndc, mat4 toLocal)\n{\n    float stored = texelFetch(sceneDepth_SPIRV_Cross_DummySampler, pixel, 0).x;\n    return decalLocalAt(ndc, ndcDepthOf(stored, frameParams[1].w), toLocal);\n}\n\nbool outsideDecal(vec3 local)\n{\n    return ((abs(local.x) > 0.5) || (abs(local.y) > 0.5)) || (abs(local.z) > 0.5);\n}\n\nfloat decalFade(float z, float start, float end, float power)\n{\n    return 1.0 - clamp(pow(max(0.0, abs(z * 2.0) - start) / (end - start), power), 0.0, 1.0);\n}\n\nvec3 decalSurfaceNormal(vec3 at, vec3 alongX, vec3 alongY, vec3 eye)\n{\n    vec3 n = normalize(cross(alongY - at, alongX - at));\n    return (dot(n, eye - at) < 0.0) ? (n * (-1.0)) : n;\n}\n\nfloat decalNormalFade(vec3 boxZ, vec3 normal, float start, float end)\n{\n    float angle = 1.0 - (abs(acos(clamp(dot(boxZ, normal), -1.0, 1.0))) / 3.14159265358979);\n    return clamp((angle - start) / (end - start), 0.0, 1.0);\n}\n\nvec4 decalOverlayColor(vec4 tint, vec4 texel, float emissive, bool gammaCorrect, bool autoAlpha, float fade)\n{\n    vec3 rgb = tint.xyz * texel.xyz;\n    if (gammaCorrect)\n    {\n        rgb = rgb * rgb;\n    }\n    rgb = rgb + (rgb * emissive);\n    float alpha = autoAlpha ? clamp(max(max(rgb.x, rgb.y), rgb.z), 0.0, 1.0) : texel.w;\n    return vec4(rgb, alpha * fade);\n}\n\nvec3 srgbToLinear(vec3 srgb)\n{\n    vec3 low = srgb * 0.0773993808;\n    vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nvec3 linearToSrgb(vec3 rgb)\n{\n    vec3 low = rgb * 12.92;\n    vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nvec3 toneCurved(vec3 exposed, float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        float startCompression = 0.76;\n        float desaturation = 0.15;\n        float x = min(exposed.x, min(exposed.y, exposed.z));\n        float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        vec3 color = exposed - offset;\n        float peak = max(color.x, max(color.y, color.z));\n        if (peak >= startCompression)\n        {\n            float d = 1.0 - startCompression;\n            float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color = color * (newPeak / peak);\n            float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color = mix(color, vec3(newPeak), g);\n        }\n        return color;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nvec3 toneMapped(vec3 rgb, vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    vec2 ndc = screen.xy / screen.w;\n    vec2 ndcDx = dFdx(ndc);\n    vec2 ndcDy = dFdy(ndc);\n    ivec2 pixel = ivec2(gl_FragCoord.xy);\n    mat4 toLocal = mat4(screenToLocal0, screenToLocal1, screenToLocal2, screenToLocal3);\n    vec3 local = decalLocalAtPixel(pixel, ndc, toLocal);\n    if (outsideDecal(local))\n    {\n        demoted = true;\n    }\n    vec4 fade = decalParams[1];\n    vec4 mode = decalParams[2];\n    float faded = decalFade(local.z, fade.x, fade.y, fade.z);\n    vec4 normalFade = decalParams[3];\n    if (normalFade.z == 1.0)\n    {\n        mat4 world = mat4(boxWorld0, boxWorld1, boxWorld2, boxWorld3);\n        ivec2 last = textureSize(sceneDepth_SPIRV_Cross_DummySampler, 0) - ivec2(1, 1);\n        ivec2 right = clamp(pixel + ivec2(1, 0), ivec2(0, 0), last);\n        ivec2 below = clamp(pixel + ivec2(0, 1), ivec2(0, 0), last);\n        vec3 alongX = decalLocalAtPixel(right, ndc + ndcDx, toLocal);\n        vec3 alongY = decalLocalAtPixel(below, ndc + ndcDy, toLocal);\n        vec3 normal = decalSurfaceNormal((world * vec4(local, 1.0)).xyz, (world * vec4(alongX, 1.0)).xyz, (world * vec4(alongY, 1.0)).xyz, frameParams[1].xyz);\n        faded = faded * decalNormalFade(normalize(world[2].xyz), normal, normalFade.x, normalFade.y);\n    }\n    vec2 uv = (mode.x == 1.0) ? (local.xy + vec2(0.5, 0.5)) : local.xy;\n    vec4 texel = texture(decalTexture_decalSampler, uv);\n    vec4 tint = decalParams[0] * baseColor;\n    vec4 shaded = decalOverlayColor(tint, texel, fade.w, mode.y == 1.0, mode.z == 1.0, faded);\n    vec3 rgb = (mode.w == 1.0) ? toneMapped(shaded.xyz, frameParams[0]) : shaded.xyz;\n    fragColor = vec4(rgb, shaded.w);\n    if (demoted)\n    {\n        discard;\n    }\n    return;\n}\n";
	const TEXT_3279877a28ee1f4f2eaaa0d45c585070a7900078f77eea038bd263b3ae74c811 = "#version 430\n\nlayout(location = 0) in vec2 position;\nlayout(location = 0) out vec4 ndc;\n\nvoid main()\n{\n    ndc = vec4(position, 0.0, 0.0);\n    gl_Position = vec4(position, 0.5, 1.0);\n    return;\n}\n";
	const TEXT_ddaae4f768de999fa16f26f3817226db935d2d902a583d044e6f19ca06674f0d = "#version 430\n\nuniform vec4 saoParams[10];\nlayout(binding = 0) uniform sampler2D saoDepth_SPIRV_Cross_DummySampler;\nlayout(binding = 1) uniform sampler2D saoNormal_SPIRV_Cross_DummySampler;\nlayout(binding = 2) uniform sampler2D saoNoiseTexture_saoNoiseSampler;\n\nlayout(location = 0) in vec4 ndc;\nlayout(location = 0) out vec4 fragColor;\n\nfloat ndcDepthOf(float stored, float zeroToOne)\n{\n    return (zeroToOne == 1.0) ? stored : ((stored * 2.0) - 1.0);\n}\n\nvec3 saoPositionAt(ivec2 pixel, vec2 ndc_1)\n{\n    float stored = texelFetch(saoDepth_SPIRV_Cross_DummySampler, pixel, 0).x;\n    float depth = ndcDepthOf(stored, saoParams[7].z);\n    vec4 world = mat4(saoParams[0], saoParams[1], saoParams[2], saoParams[3]) * vec4(ndc_1.x, ndc_1.y, depth, 1.0);\n    return world.xyz / world.w;\n}\n\nfloat saoScreenRadius(float sampleRadius, float fovTan, float viewDepth)\n{\n    return (sampleRadius * fovTan) / viewDepth;\n}\n\nfloat saoViewDepthOf(vec3 at)\n{\n    return dot(saoParams[4], vec4(at, 1.0));\n}\n\nvec2 saoTapOffset(int tap, int samples, int spiralTurns, float rotation)\n{\n    float alpha = (float(tap) + 0.5) / float(samples);\n    float angle = (alpha * (float(spiralTurns) * 6.28)) + rotation;\n    return vec2(cos(angle), sin(angle)) * alpha;\n}\n\nfloat saoScalableRadius(float sampleRadius, float viewDepth)\n{\n    return sampleRadius * (max(0.0, log(1.0 + viewDepth)) + 1.0);\n}\n\nfloat saoTap(vec3 offset, vec3 normal, float radius, float bias)\n{\n    float vv = dot(offset, offset);\n    float vn = dot(offset, normal) - (bias * radius);\n    float radius2 = radius * radius;\n    float f = max(radius2 - vv, 0.0) / radius2;\n    return ((f * f) * f) * max(vn / (0.01 + vv), 0.0);\n}\n\nfloat saoFaded(float occlusion, float distance_1, float startFadeStart, float startFadeEnd, float fadeStart, float fadeEnd)\n{\n    float started = mix(1.0, occlusion, clamp((distance_1 - startFadeStart) / (startFadeEnd - startFadeStart), 0.0, 1.0));\n    return mix(started, 1.0, clamp((distance_1 - fadeStart) / (fadeEnd - fadeStart), 0.0, 1.0));\n}\n\nfloat saoOcclusion(float sum, int samples, float intensity)\n{\n    return pow(clamp(1.0 - (sum / float(samples)), 0.0, 1.0), 1.0 + intensity);\n}\n\nvoid main()\n{\n    ivec2 size = textureSize(saoDepth_SPIRV_Cross_DummySampler, 0);\n    ivec2 pixel = ivec2(gl_FragCoord.xy);\n    vec2 ndc_1 = ndc.xy;\n    vec2 ndcDx = dFdx(ndc_1);\n    vec2 ndcDy = dFdy(ndc_1);\n    vec3 origin = saoPositionAt(pixel, ndc_1);\n    vec3 normal = (texelFetch(saoNormal_SPIRV_Cross_DummySampler, pixel, 0).xyz * 2.0) - vec3(1.0);\n    float height = float(size.y);\n    vec2 noiseUv = (gl_FragCoord.xy / height) * saoParams[7].xy;\n    float noise = texture(saoNoiseTexture_saoNoiseSampler, noiseUv).x;\n    float rotation = 6.28318530717958 * noise;\n    vec4 radius = saoParams[5];\n    vec4 taps = saoParams[6];\n    float radiusSS = (taps.z == 1.0) ? (radius.x * radius.w) : saoScreenRadius(radius.x, radius.w, saoViewDepthOf(origin));\n    int samples = int(taps.x);\n    int turns = int(taps.y);\n    float sum = 0.0;\n    for (int tap = 0; tap < samples; tap++)\n    {\n        vec2 offset = roundEven(saoTapOffset(tap, samples, turns, rotation) * (radiusSS * height));\n        ivec2 at = clamp(pixel + ivec2(offset), ivec2(0, 0), size - ivec2(1, 1));\n        vec3 q = saoPositionAt(at, (ndc_1 + (ndcDx * offset.x)) + (ndcDy * offset.y));\n        float tapRadius = (taps.w == 1.0) ? saoScalableRadius(radius.x, saoViewDepthOf(q)) : radius.x;\n        sum = sum + saoTap(q - origin, normal, tapRadius, radius.z);\n    }\n    vec4 fade = saoParams[9];\n    float occlusion = saoFaded(saoOcclusion(sum, samples, radius.y), distance(origin, saoParams[8].xyz), fade.x, fade.y, fade.z, fade.w);\n    fragColor = vec4(occlusion, occlusion, occlusion, 1.0);\n    return;\n}\n";
	const TEXT_3d82dcebcf849b2395e9a26c1ad614a305f84e99eef292f70d06f14938544d64 = "#version 430\n\nuniform vec4 blurParams[17];\nlayout(binding = 0) uniform sampler2D blurSource_blurSampler;\n\nlayout(location = 0) out vec4 fragColor;\n\nvoid main()\n{\n    ivec2 size = textureSize(blurSource_blurSampler, 0);\n    vec2 uv = gl_FragCoord.xy / vec2(float(size.x), float(size.y));\n    int count = int(blurParams[0].z);\n    vec4 color = vec4(0.0, 0.0, 0.0, 0.0);\n    for (int i = 1 - count; i < count; i++)\n    {\n        vec4 tap = blurParams[1 + ((i < 0) ? (-i) : i)];\n        vec2 at = uv + (blurParams[0].xy * (tap.y * float(i)));\n        color = color + (texture(blurSource_blurSampler, at) * tap.x);\n    }\n    fragColor = color;\n    return;\n}\n";
	const TEXT_614b8fff89690a066dbfc1f813c85ab7951c313b3594ff96383c2737563524cf = "#version 430\n\nuniform vec4 lineParams[3];\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec3 normal;\nlayout(location = 2) in vec2 uv;\nlayout(location = 3) in vec4 color;\nlayout(location = 4) in vec4 instanceRow0;\nlayout(location = 5) in vec4 instanceRow1;\nlayout(location = 6) in vec4 instanceRow2;\nlayout(location = 7) in vec4 instanceColor;\nlayout(location = 0) out vec4 baseColor;\n\nmat4 instanceWorld(vec4 row0, vec4 row1, vec4 row2)\n{\n    return transpose(mat4(row0, row1, row2, vec4(0.0, 0.0, 0.0, 1.0)));\n}\n\nvec2 lineScreenDirection(vec3 direction, vec4 right, vec4 up)\n{\n    vec2 projected = vec2(dot(direction, right.xyz) * right.w, dot(direction, up.xyz) * up.w);\n    return projected * (1.0 / length(projected));\n}\n\nfloat lineViewDepth(float depth, float zNear, float zFar)\n{\n    return ((2.0 * zNear) * zFar) / ((zFar + zNear) - (((2.0 * depth) - 1.0) * (zFar - zNear)));\n}\n\nvec2 lineClipOffset(vec2 screenDirection, float side, float viewDepth, vec2 pixelSize, float width)\n{\n    return (vec2(screenDirection.y, -screenDirection.x) * pixelSize) * (((side - 0.5) * viewDepth) * width);\n}\n\nvec3 srgbToLinear(vec3 srgb)\n{\n    vec3 low = srgb * 0.0773993808;\n    vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nvec3 linearToSrgb(vec3 rgb)\n{\n    vec3 low = rgb * 12.92;\n    vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nvec4 unlitShade(vec4 texel, vec4 baseColor_1, vec4 materialColor)\n{\n    vec3 surface = srgbToLinear(baseColor_1.xyz) * srgbToLinear(materialColor.xyz);\n    surface = surface * srgbToLinear(texel.xyz);\n    return vec4(linearToSrgb(surface), (baseColor_1.w * materialColor.w) * texel.w);\n}\n\nvoid main()\n{\n    mat4 matrix = instanceWorld(instanceRow0, instanceRow1, instanceRow2);\n    vec4 shape = lineParams[0];\n    vec4 depthRange = lineParams[1];\n    vec3 direction = mat3(matrix) * normal;\n    vec4 root = matrix * vec4(position, 1.0);\n    vec3 world = root.xyz + (direction * (uv.x * shape.y));\n    vec4 clip = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    vec2 across = lineScreenDirection(direction, vertexParams[4], vertexParams[5]);\n    float depth = lineViewDepth(clip.z / clip.w, depthRange.x, depthRange.y);\n    vec2 offset = lineClipOffset(across, uv.y, depth, shape.zw, shape.x);\n    vec4 color_1 = color * instanceColor;\n    baseColor = unlitShade(vec4(1.0, 1.0, 1.0, 1.0), color_1, lineParams[2]);\n    gl_Position = vec4(clip.xy + offset, clip.z, clip.w);\n    return;\n}\n";
	const TEXT_af02f78fadb32e8db0362cc03f2ad2d8b11954f1b2ae8170bbadc3060c4fbcae = "#version 430\n\nuniform vec4 frameParams[3];\n\nlayout(location = 0) in vec4 baseColor;\nlayout(location = 0) out vec4 fragColor;\n\nvec3 srgbToLinear(vec3 srgb)\n{\n    vec3 low = srgb * 0.0773993808;\n    vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nvec3 linearToSrgb(vec3 rgb)\n{\n    vec3 low = rgb * 12.92;\n    vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nvec3 toneCurved(vec3 exposed, float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        float startCompression = 0.76;\n        float desaturation = 0.15;\n        float x = min(exposed.x, min(exposed.y, exposed.z));\n        float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        vec3 color = exposed - offset;\n        float peak = max(color.x, max(color.y, color.z));\n        if (peak >= startCompression)\n        {\n            float d = 1.0 - startCompression;\n            float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color = color * (newPeak / peak);\n            float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color = mix(color, vec3(newPeak), g);\n        }\n        return color;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nvec3 toneMapped(vec3 rgb, vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n   