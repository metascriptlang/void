ghp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 params = materialOf();\n    highp vec3 n = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    highp vec4 shaded = vec4(0.0);\n    shaded = litShade(n, worldPosition, baseColor);\n    color = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    normal = vec4((n * 0.5) + 0.5, 1.0);\n    return;\n}\n";
