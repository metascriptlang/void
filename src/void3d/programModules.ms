ition, vec3 normal_1, vec4 at, vec4 tint, vec4 a, vec4 b, vec4 c, vec4 d)\n{\n    if (a.w > 2.5)\n    {\n        return capsuleSample(position, at, tint, a, b);\n    }\n    if (a.w > 1.5)\n    {\n        return rectangleSample(position, normal_1, at, tint, a, b, c, d);\n    }\n    return spotSample(position, at, tint, a, b);\n}\n\nvec3 lightAt(vec3 position, vec3 normal_1, vec4 at, vec4 tint, vec4 a, vec4 b, vec4 c, vec4 d)\n{\n    vec3 lit = vec3(0.0);\n    if (a.w < 0.5)\n    {\n        lit = pointLightAt(position, normal_1, at, tint);\n    }\n    else\n    {\n        {\n            vec4 sample_1 = shapedSample(position, normal_1, at, tint, a, b, c, d);\n            lit = srgbToLinear(tint.xyz) * ((sample_1.w * max(dot(normal_1, sample_1.xyz), 0.0)) * at.w);\n        }\n    }\n    return lit;\n}\n\nfloat slotShadowAt(vec3 position, int slot)\n{\n    return 1.0;\n}\n\nvec3 saturated(vec3 rgb, float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nvec3 linearToSrgb(vec3 rgb)\n{\n    vec3 low = rgb * 12.92;\n    vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nvec4 litShade(vec3 n, vec3 position, vec4 surfaceColor)\n{\n    vec4 dir = lightParams[1];\n    float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n    vec3 ambient = srgbToLinear(lightParams[0].xyz);\n    vec3 light = ambient + (srgbToLinear(lightParams[2].xyz) * lambert);\n    for (int i = 0; i < int(lightParams[0].w + 0.5); i++)\n    {\n        light = light + (lightAt(position, n, lightParams[3 + i], lightParams[7 + i], lightParams[11 + i], lightParams[15 + i], lightParams[19 + i], lightParams[23 + i]) * slotShadowAt(position, i));\n    }\n    vec3 surface = srgb