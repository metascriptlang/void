\nhighp int clusterAtCell(highp vec2 cell, highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    highp int columns = int(grid.x + 0.5);\n    highp int x = cellOf(cell.x, columns);\n    highp int y = cellOf(cell.y, int(grid.y + 0.5));\n    return (((y * columns) + x) * int(grid.z + 0.5)) + clusterSliceOf(depth, grid, factors);\n}\n\nhighp int clusterIndexOf(highp vec2 frag, highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    return clusterAtCell(frag * factors.xy, depth, grid, factors);\n}\n\nhighp float clusterDepthOf(highp vec3 position, highp vec4 view)\n{\n    return dot(position, view.xyz) + view.w;\n}\n\nhighp int fragmentClusterOf(highp vec2 frag, highp vec3 position, highp vec4 grid, highp vec4 factors, highp vec4 view, highp vec4 screen)\n{\n    highp float row = (screen.x > 0.5) ? (screen.y - frag.y) : frag.y;\n    return clusterIndexOf(vec2(frag.x, row), clusterDepthOf(position, view), grid, factors);\n}\n\nhighp ivec2 dataTexelOf(highp int i)\n{\n    highp uint at = uvec2(ivec2(i, 0)).x;\n    return ivec2(uvec2(at % DATA_ROW, at / DATA_ROW));\n}\n\nhighp ivec4 litClusterOf(highp vec2 frag, highp vec3 position)\n{\n    highp int cluster = fragmentClusterOf(frag, position, lightParams[3], lightParams[4], lightParams[5], lightParams[6]);\n    return ivec4(texelFetch(clusterRecords_SPIRV_Cross_DummySampler, dataTexelOf(cluster), 0));\n}\n\nhighp int indexOfWord(highp uvec4 texel, highp int j)\n{\n    highp ivec4 words = ivec4(texel);\n    highp uint channel = uvec2(ivec2(j, 0)).x % 4u;\n    if (channel == 0u)\n    {\n        return words.x;\n    }\n    if (channel == 1u)\n    {\n        return words.y;\n    }\n    if (channel == 2u)\n    {\n        return words.z;\n    }\n    return words.w;\n}\n\nhighp ivec2 indexTexelOf(highp int j)\n{\n    return dataTexelOf(ivec2(uvec2(uvec2(ivec2(j, 0)).x / 4u, 0u)).x);\n}\n\nhighp int litLightOf(highp ivec4 cluster, highp int k)\n{\n    highp int j = cluster.x + k;\n    return indexOfWord(texelFetch(clusterIndices_SPIRV_Cross_DummySampler, indexTexelOf(j), 0), j);\n}\n\nhighp vec3 toonPointLightAt(highp vec3 position, highp vec3 normal_1, highp vec4 at, highp vec4 tint, highp float normalWeight, highp float levels)\n{\n    highp vec3 toLight = at.xyz - position;\n    highp float distance_1 = length(toLight);\n    highp float falloff = clamp(1.0 - (distance_1 / tint.w), 0.0, 1.0);\n    highp float facing = mix(1.0, max(dot(normal_1, toLight / max(distance_1, 0.0001)), 0.0), normalWeight);\n    highp float energy = ((falloff * falloff) * facing) * at.w;\n    highp float level = floor((energy * levels) + 0.35) / levels;\n    return srgbToLinear(tint.xyz) * level;\n}\n\nhighp ivec2 recordTexelOf(highp int light, highp int texel)\n{\n    return dataTexelOf((light * RECORD_TEXELS) + texel);\n}\n\nhighp vec4 litTexelOf(highp int light, highp int texel)\n{\n    return texelFetch(lightRecords_SPIRV_Cross_DummySampler, recordTexelOf(light, texel), 0);\n}\n\nhighp vec3 saturated(highp vec3 rgb, highp float amount)\n{\n    if (amount == 0.0)\n    {\n        return rgb;\n    }\n    highp float luma = dot(rgb, vec3(0.212671, 0.71516, 0.072169));\n    highp float keep = amount + 1.0;\n    return (rgb * keep) + vec3(luma * (1.0 - keep));\n}\n\nhighp vec3 linearToSrgb(highp vec3 rgb)\n{\n    highp vec3 low = rgb * 12.92;\n    highp vec3 high = (vec3(1.055) * pow(max(rgb, vec3(0.0)), vec3(0.41666))) - vec3(0.055);\n    return vec3((rgb.x <= 0.0031308) ? low.x : high.x, (rgb.y <= 0.0031308) ? low.y : high.y, (rgb.z <= 0.0031308) ? low.z : high.z);\n}\n\nhighp vec4 toonShade(highp vec3 n, highp vec3 surfaceNormal, highp vec3 position, highp vec2 frag, highp vec4 surfaceColor)\n{\n    highp vec4 params = materialOf();\n    highp vec4 dir = lightParams[1];\n    highp float lambert = max(dot(n, dir.xyz), 0.0) * dir.w;\n    highp vec3 light = srgbToLinear(lightParams[0].xyz) + (srgbToLinear(lightParams[2].xyz) * lambert);\n    highp ivec4 cluster = litClusterOf(frag, position);\n    for (highp int k = 0; k < (cluster.y + cluster.z); k++)\n    {\n        highp int i = litLightOf(cluster, k);\n        light = light + toonPointLightAt(position, n, litTexelOf(i, 0), litTexelOf(i, 1), 1.0, params.x);\n    }\n    highp vec3 surface = srgbToLinear(saturated(surfaceColor.xyz, params.y));\n    return vec4(linearToSrgb(surface * light), surfaceColor.w);\n}\n\nhighp vec3 toneCurved(highp vec3 exposed, highp float mode)\n{\n    if (mode == 1.0)\n    {\n        return exposed / (exposed + vec3(1.0));\n    }\n    if (mode == 2.0)\n    {\n        highp vec3 a = exposed * ((2.51 * exposed) + 0.03);\n        highp vec3 b = (exposed * ((2.43 * exposed) + 0.59)) + 0.14;\n        return clamp(a / b, vec3(0.0), vec3(1.0));\n    }\n    if (mode == 3.0)\n    {\n        highp float startCompression = 0.76;\n        highp float desaturation = 0.15;\n        highp float x = min(exposed.x, min(exposed.y, exposed.z));\n        highp float offset = (x < 0.08) ? (x - ((6.25 * x) * x)) : 0.04;\n        highp vec3 color_1 = exposed - offset;\n        highp float peak = max(color_1.x, max(color_1.y, color_1.z));\n        if (peak >= startCompression)\n        {\n            highp float d = 1.0 - startCompression;\n            highp float newPeak = 1.0 - ((d * d) / ((peak + d) - startCompression));\n            color_1 = color_1 * (newPeak / peak);\n            highp float g = 1.0 - (1.0 / ((desaturation * (peak - newPeak)) + 1.0));\n            color_1 = mix(color_1, vec3(newPeak), g);\n        }\n        return color_1;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 params = materialOf();\n    highp vec3 n = facingNormal(normalize(worldNormal), params.z, gl_FrontFacing);\n    highp vec4 surfaceColor = tintedSurface(baseColor);\n    highp vec4 shaded = toonShade(n, n, worldPosition, gl_FragCoord.xy, surfaceColor);\n    color = vec4(toneMapped(shaded.xyz, frameParams[0]), shaded.w);\n    normal = vec4((n * 0.5) + 0.5, depth01);\n    return;\n}\n";
	const TEXT_8fec2d1a17eedf02693c14a004e3f47bc60145457a906048efa6d92f900374f2 = "#version 300 es\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec4 root;\nlayout(location = 1) in vec4 color;\nout vec4 particleColor;\nout float depth01;\n\nvoid main()\n{\n    vec2 corner = PARTICLE_CORNERS[uint(gl_VertexID) % 6u];\n    vec3 right = vertexParams[4].xyz;\n    vec3 up = vertexParams[5].xyz;\n    vec3 world = (root.xyz + (right * (corner.x * root.w))) + (up * (corner.y * root.w));\n    vec4 clip = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    particleColor = color;\n    depth01 = clip.z;\n    gl_Position = clip;\n    return;\n}\n";
