	const TEXT_73edd35fd74d0f4305868e6e4f0e93cd90a64a4ac3cb9cffca5f7482b73d9866 = "diagnostic(off, derivative_uniformity);\n\nstruct MovingEmissiveMaterialParams {\n  material : vec4f,\n  materialColor : vec4f,\n  uvMatrix : vec4f,\n  uvMotion : vec4f,\n  backUvMatrix : vec4f,\n  backUvOffset : vec4f,\n  dissolve : vec4f,\n  dissolveEdge : vec4f,\n  flipbookGrid : vec4f,\n  flipbookPlay : vec4f,\n  distanceFade : vec4f,\n  colorKey : vec4f,\n  sinusDeform : vec4f,\n  emissive : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  clusterGrid : vec4f,\n  clusterFactors : vec4f,\n  clusterView : vec4f,\n  clusterScreen : vec4f,\n  cookie : vec4f,\n  cookieMatrix : mat4x4f,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nstruct SurfaceUv {\n  uv : vec2f,\n}\n\nstruct SampleUv {\n  baseUv : vec2f,\n  nextUv : vec2f,\n  blend : f32,\n}\n\nstruct SurfaceTexel {\n  texel : vec4f,\n  surfaceUv : vec2f,\n  noise : f32,\n}\n\nstruct LitShaded {\n  color : vec4f,\n  uv : vec2f,\n  noise : f32,\n}\n\nstruct LitFaded {\n  color : vec4f,\n  worldPosition : vec3f,\n}\n\nconst DATA_ROW : u32 = 256u;\n\nconst RECORD_TEXELS : i32 = 6i;\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> movingEmissiveMaterialParams : MovingEmissiveMaterialParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(2) @group(1) var dissolveTexture : texture_2d<f32>;\n\n@binding(3) @group(1) var emissiveTexture : texture_2d<f32>;\n\n@binding(9) @group(1) var lightRecords : texture_2d<f32>;\n\n@binding(10) @group(1) var clusterRecords : texture_2d<u32>;\n\n@binding(11) @group(1) var clusterIndices : texture_2d<u32>;\n\n@binding(13) @group(1) var cookieTexture : texture_2d<f32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\n@binding(33) @group(1) var dissolveSampler :