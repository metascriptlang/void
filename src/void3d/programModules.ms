	const TEXT_d64a834fcb07881c7dc1890a62cc4e153048516dc54d1ac2c14a525c7aab3570 = "diagnostic(off, derivative_uniformity);\n\nstruct MovingMaterialParams {\n  material : vec4f,\n  materialColor : vec4f,\n  uvMatrix : vec4f,\n  uvMotion : vec4f,\n  backUvMatrix : vec4f,\n  backUvOffset : vec4f,\n  dissolve : vec4f,\n  dissolveEdge : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  clusterGrid : vec4f,\n  clusterFactors : vec4f,\n  clusterView : vec4f,\n  clusterScreen : vec4f,\n  cookie : vec4f,\n  cookieMatrix : mat4x4f,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\nconst DATA_ROW : u32 = 256u;\n\nconst RECORD_TEXELS : i32 = 6i;\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> movingMaterialParams : MovingMaterialParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\n@binding(0) @group(1) var baseTexture : texture_2d<f32>;\n\n@binding(2) @group(1) var dissolveTexture : texture_2d<f32>;\n\n@binding(9) @group(1) var lightRecords : texture_2d<f32>;\n\n@binding(10) @group(1) var clusterRecords : texture_2d<u32>;\n\n@binding(11) @group(1) var clusterIndices : texture_2d<u32>;\n\n@binding(13) @group(1) var cookieTexture : texture_2d<f32>;\n\n@binding(32) @group(1) var baseSampler : sampler;\n\n@binding(33) @group(1) var dissolveSampler : sampler;\n\n@binding(38) @group(1) var cookieSampler : sampler;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> surfaceUv : vec2f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> fragCoord : vec4f;\n\nvar<private> color : vec4f;\n\nfn materialOf() -> vec4f {\n  return movingMaterialParams.material;\n}\n\nfn dissolveOf() -> vec4f {\n  return movingMaterialParams.dissolve;\n}\n\nfn straightTexel(texel : vec4f) -> vec4f {\n  return select(vec4f(0f), vec4f((texel.xyz / texel.w), texel.w),