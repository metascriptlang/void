or = mix(color, vec3(newPeak), g);\n        }\n        return color;\n    }\n    return clamp(exposed, vec3(0.0), vec3(1.0));\n}\n\nhighp vec3 toneMapped(highp vec3 rgb, highp vec4 tone)\n{\n    if (tone.z == 1.0)\n    {\n        return srgbToLinear(rgb);\n    }\n    if ((tone.y == 1.0) && (tone.w == 0.0))\n    {\n        return rgb;\n    }\n    return linearToSrgb(toneCurved(srgbToLinear(rgb) * tone.y, tone.w));\n}\n\nvoid main()\n{\n    highp vec4 color = particleColor;\n    if (color.w < 0.5)\n    {\n        demoted = true;\n    }\n    fragColor = vec4(toneMapped(color.xyz, frameParams[0]), color.w);\n    if (demoted)\n    {\n        discard;\n    }\n    return;\n}\n";
	const TEXT_5fd08a391c7a30416d5e0b76d14a5624178150e9e7d0fd4285c63b203e97439f = "#version 300 es\n\nconst vec2 PARTICLE_CORNERS[6] = vec2[6](vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));\n\nuniform vec4 vertexParams[7];\n\nlayout(location = 0) in vec3 position;\nlayout(location = 1) in vec2 size;\nlayout(location = 2) in vec2 anchor;\nlayout(location = 3) in vec4 tile;\nlayout(location = 4) in vec4 color;\nout vec3 worldPosition;\nout vec3 towardCamera;\nout vec2 uv;\nout vec4 instanceColor;\n\nvec3 billboardPoint(vec3 position_1, vec2 size_1, vec2 anchor_1, vec2 corner, vec3 right, vec3 up)\n{\n    vec2 offset = corner - anchor_1;\n    return (position_1 + (right * (offset.x * size_1.x))) + (up * (offset.y * size_1.y));\n}\n\nvoid main()\n{\n    vec2 corner = PARTICLE_CORNERS[uint(gl_VertexID) % 6u];\n    vec3 right = vertexParams[4].xyz;\n    vec3 up = vertexParams[5].xyz;\n    vec3 world = billboardPoint(position, size, anchor, corner, right, up);\n    worldPosition = world;\n    towardCamera = cross(right, up);\n    uv = vec2((corner.x > 0.0) ? tile.z : tile.x, (corner.y > 0.0) ? tile.y : tile.w);\n    instanceColor = color;\n    gl_Position = mat4(vertexParams[0], vertexParams[1], vertexParams[2], vertexParams[3]) * vec4(world, 1.0);\n    return;\n}\n";
	const TEXT_396c72a7f40d659af4c9e443cd6316792650e822a6dcea71ca1baeafac54a5ff = "#version 300 es\nprecision highp float;\nprecision highp int;\n\nconst highp uint DATA_ROW = 256u;\nconst highp int RECORD_TEXELS = 6;\n\nuniform highp vec4 billboardParams[2];\nuniform highp vec4 lightParams[7];\nuniform highp vec4 frameParams[3];\nuniform highp sampler2D billboardTexture_billboardSampler;\nuniform highp sampler2D lightRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterRecords_SPIRV_Cross_DummySampler;\nuniform highp usampler2D clusterIndices_SPIRV_Cross_DummySampler;\n\nin highp vec3 worldPosition;\nin highp vec3 towardCamera;\nin highp vec2 uv;\nin highp vec4 instanceColor;\nlayout(location = 0) out highp vec4 fragColor;\n\nhighp vec3 srgbToLinear(highp vec3 srgb)\n{\n    highp vec3 low = srgb * 0.0773993808;\n    highp vec3 high = pow(max((srgb * 0.9478672986) + vec3(0.0521327014), vec3(0.0)), vec3(2.4));\n    return vec3((srgb.x <= 0.04045) ? low.x : high.x, (srgb.y <= 0.04045) ? low.y : high.y, (srgb.z <= 0.04045) ? low.z : high.z);\n}\n\nhighp int cellOf(highp float position, highp int cells)\n{\n    if (!(position > 0.0))\n    {\n        return 0;\n    }\n    if (position >= float(cells))\n    {\n        return cells - 1;\n    }\n    return int(position);\n}\n\nhighp int clusterSliceOf(highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    highp int slices = int(grid.z + 0.5);\n    if (grid.w > 0.5)\n    {\n        return cellOf(floor((depth - factors.z) * factors.w), slices);\n    }\n    return cellOf(((log(depth) * factors.z) - factors.w) + 1.0, slices);\n}\n\nhighp int clusterAtCell(highp vec2 cell, highp float depth, highp vec4 grid, highp vec4 factors)\n{\n    highp int columns = int(grid.x + 0.5);\n    highp int x = cellOf(cell.x, columns);\n    highp int y = cellOf(cell.y, int(grid.y + 0.5));\n    return (((y * columns) + x) * int(grid.z + 0.5)) + clusterSliceOf(depth, grid, factors);\n}\n\nhighp int clusterIndexOf(highp vec2 frag,