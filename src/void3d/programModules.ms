	const TEXT_9b074f84118750224aab0472c5b23962aae9ec00379abcdad3d335fa029dd7a8 = "struct MaterialParams {\n  material : vec4f,\n}\n\nstruct LightParams {\n  ambient : vec4f,\n  dirLight : vec4f,\n  dirColor : vec4f,\n  pointLight : array<vec4f, 4>,\n  pointColor : array<vec4f, 4>,\n  shapeA : array<vec4f, 4>,\n  shapeB : array<vec4f, 4>,\n  shapeC : array<vec4f, 4>,\n  shapeD : array<vec4f, 4>,\n}\n\nstruct FrameParams {\n  frame : vec4f,\n  cameraPosition : vec4f,\n  envParams : vec4f,\n}\n\n@binding(1) @group(0) var<uniform> lightParams : LightParams;\n\n@binding(3) @group(0) var<uniform> materialParams : MaterialParams;\n\n@binding(6) @group(0) var<uniform> frameParams : FrameParams;\n\nvar<private> worldPosition : vec3f;\n\nvar<private> worldNormal : vec3f;\n\nvar<private> baseColor : vec4f;\n\nvar<private> frontFacing : bool;\n\nvar<private> color : vec4f;\n\nvar<private> normal : vec4f;\n\nfn materialOf() -> vec4f {\n  return materialParams.material;\n}\n\nfn facingNormal(normal_1 : vec3f, doubleSided : f32, frontFacing_1 : bool) -> vec3f {\n  return select(normal_1, (-normal_1), ((doubleSided > 0.5f) && (!frontFacing_1)));\n}\n\nfn srgbToLinear(srgb : vec3f) -> vec3f {\n  var low : vec3f = (srgb * 0.0773993808f);\n  var high : vec3f = pow(max(((srgb * 0.9478672986f) + vec3f(0.0521327014f)), vec3f(0f)), vec3f(2.4f));\n  return vec3f(select(high.x, low.x, (srgb.x <= 0.04045f)), select(high.y, low.y, (srgb.y <= 0.04045f)), select(high.z, low.z, (srgb.z <= 0.04045f)));\n}\n\nfn saturated(rgb : vec3f, amount : f32) -> vec3f {\n  if ((amount == 0f)) {\n    return rgb;\n  }\n  var luma : f32 = dot(rgb, vec3f(0.212671f, 0.71516f, 0.072169f));\n  var keep : f32 = (amount + 1f);\n  return ((rgb * keep) + vec3f((luma * (1f - keep))));\n}\n\nfn lightWindow(distance_1 : f32, range : f32) -> f32 {\n  var window : f32 = clamp((1f - (distance_1 / range)), 0f, 1f);\n  return (window * window);\n}\n\nfn capsuleSample(position : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec