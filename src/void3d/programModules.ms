	const TEXT_e680f5b36cdb9247373c0592fe7a5d3863636a75cc616cacaa50b681782137f2 = "struct VertexParams {\n  viewProj : mat4x4f,\n  cameraRight : vec4f,\n  cameraUp : vec4f,\n  cameraPosition : vec4f,\n}\n\nconst PARTICLE_CORNERS : array<vec2f, 6> = array<vec2f, 6>(vec2f((-0.5f), (-0.5f)), vec2f(0.5f, (-0.5f)), vec2f(0.5f, 0.5f), vec2f((-0.5f), (-0.5f)), vec2f(0.5f, 0.5f), vec2f((-0.5f), 0.5f));\n\n@binding(0) @group(0) var<uniform> vertexParams : VertexParams;\n\nvar<private> position : vec3f;\n\nvar<private> size : vec2f;\n\nvar<private> anchor : vec2f;\n\nvar<private> tile : vec4f;\n\nvar<private> color : vec4f;\n\nvar<private> index : u32;\n\nvar<private> uv : vec2f;\n\nvar<private> rootPosition : vec3f;\n\nvar<private> instanceColor : vec4f;\n\nvar<private> depth01 : f32;\n\nvar<private> clip : vec4f;\n\nfn billboardPoint(position_1 : vec3f, size_1 : vec2f, anchor_1 : vec2f, corner : vec2f, right : vec3f, up : vec3f) -> vec3f {\n  var offset : vec2f = (corner - anchor_1);\n  return ((position_1 + (right * (offset.x * size_1.x))) + (up * (offset.y * size_1.y)));\n}\n\nfn pixelArtBillboardVs() {\n  var corner : vec2f = PARTICLE_CORNERS[(index % 6u)];\n  var world : vec3f = billboardPoint(position, size, anchor, corner, vertexParams.cameraRight.xyz, vertexParams.cameraUp.xyz);\n  var clip_1 : vec4f = (vertexParams.viewProj * vec4f(world, 1f));\n  uv = vec2f(select(tile.x, tile.z, (corner.x > 0f)), select(tile.w, tile.y, (corner.y > 0f)));\n  rootPosition = position;\n  instanceColor = color;\n  depth01 = clip_1.z;\n  clip = clip_1;\n  return;\n}\n\nstruct main_out {\n  @location(0) uv : vec2f,\n  @location(1) rootPosition : vec3f,\n  @location(2) instanceColor : vec4f,\n  @location(3) depth01 : f32,\n  @builtin(position) clip : vec4f,\n}\n\n@vertex\nfn main(@location(0) position_param : vec3f, @location(1) size_param : vec2f, @location(2) anchor_param : vec2f, @location(3) tile_param : vec4f, @location(4) color_param : vec4f, @builtin(vertex_index) index_param : u32) 