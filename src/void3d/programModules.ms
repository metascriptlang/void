(toLight);\n  var falloff : f32 = clamp((1f - (distance_1 / tint.w)), 0f, 1f);\n  var facing : f32 = max(dot(normal, (toLight / max(distance_1, 0.0001f))), 0f);\n  return (srgbToLinear(tint.xyz) * (((falloff * falloff) * facing) * at.w));\n}\n\nfn lightAt(position : vec3f, normal : vec3f, at : vec4f, tint : vec4f, a : vec4f, b : vec4f, c : vec4f, d : vec4f) -> vec3f {\n  var lit : vec3f = vec3f(0f);\n  if ((a.w < 0.5f)) {\n    lit = pointLightAt(position, normal, at, tint);\n  } else {\n    {\n      var sample : vec4f = shapedSample(position, normal, at, tint, a, b, c, d);\n      lit = (srgbToLinear(tint.xyz) * ((sample.w * max(dot(normal, sample.xyz), 0f)) * at.w));\n    }\n  }\n  return lit;\n}\n\nfn litShade(n : vec3f, position : vec3f, surfaceColor : vec4f) -> vec4f {\n  var dir : vec4f = lightParams.dirLight;\n  var lambert : f32 = (max(dot(n, dir.xyz), 0f) * dir.w);\n  lambert = (lambert * dirShadowAt(position));\n  var ambient : vec3f = srgbToLinear(lightParams.ambient.xyz);\n  var light : vec3f = (ambient + (srgbToLinear(lightParams.dirColor.xyz) * lambert));\n  for (var i : i32 = 0i; (i < i32((lightParams.ambient.w + 0.5f))); i++) {\n    light = (light + (lightAt(position, n, lightParams.pointLight[i], lightParams.pointColor[i], lightParams.shapeA[i], lightParams.shapeB[i], lightParams.shapeC[i], lightParams.shapeD[i]) * slotShadowAt(position, i)));\n  }\n  var surface : vec3f = srgbToLinear(saturated(surfaceColor.xyz, materialOf().y));\n  return vec4f(linearToSrgb((surface * light)), surfaceColor.w);\n}\n\nfn emittedOver(color_1 : vec4f, texel : vec3f, emissive : vec4f) -> vec4f {\n  var emitted : vec3f = ((srgbToLinear(emissive.xyz) * srgbToLinear(texel)) * emissive.w);\n  return vec4f(linearToSrgb((srgbToLinear(color_1.xyz) + emitted)), color_1.w);\n}\n\nfn emissiveOf() -> vec4f {\n  return movingEmissiveMaterialParams.emissive;\n}\n\nfn dissolveEdgeOver(color_1 : vec4f, noise : f32, dissolve : vec4f, edge : vec4f) -> vec4f {\n  var onEdge : bool = ((dis