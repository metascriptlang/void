export const GLYPH_WIDTH: int32 = 5;
export const GLYPH_HEIGHT: int32 = 7;

export function glyphIndex(character: string): int32 {
	const index: int32 = FONT_CHARACTERS.indexOf(character);
	if (index < 0) {
		console.log(`void2d profiler overlay: the 5x7 font has no glyph for '${character}'`);
		unreachable;
	}
	return index;
}

export function glyphRow(index: int32, row: int32): int32 {
	return FONT_ROWS[index * GLYPH_HEIGHT + row];
}
