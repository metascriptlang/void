import { fontBytesFind, fontBytesRead, fontBytesSize } from "./fontBytes";

// A browser has no font files: a face arrives as bytes (holdFaceBytes, addFontBytes, peekFaceBytes),
// and a path that is not held is unreadable, as a missing file is.
export function sfntSourceSize(path: string): int64 {
	const held = fontBytesFind(path);
	if (held >= 0) { return fontBytesSize(held); }
	console.error(`sfntSource: js cannot open the font file ${path}; hold its bytes with holdFaceBytes or addFontBytes, or pass them to peekFaceBytes`);
	return -1;
}

export function sfntSourceRead(path: string, at: int64, into: Span<uint8>): boolean {
	const held = fontBytesFind(path);
	if (held >= 0) { return fontBytesRead(held, at, into); }
	return false;
}
