@include("stdio.h");
@include("stddef.h");

extern struct FILE;
extern function cFopen(path: cstring, mode: cstring): Ptr<FILE> from "fopen";
extern function cFseek(file: Ptr<FILE>, offset: int64, whence: int32): int32 from "fseek";
extern function cFtell(file: Ptr<FILE>): int64 from "ftell";
extern function cFread(into: Ptr<uint8>, size: uint64, count: uint64, file: Ptr<FILE>): uint64 from "fread";
extern function cFclose(file: Ptr<FILE>): int32 from "fclose";
extern const SEEK_SET: int32;
extern const SEEK_END: int32;

import { fontBytesFind, fontBytesRead, fontBytesSize } from "./fontBytes";

// The size of the font behind `path`: a face held under that name by holdFaceBytes wins over a
// file of it; -1 when the file cannot be opened.
export function sfntSourceSize(path: string): int64 {
	const held = fontBytesFind(path);
	if (held >= 0) { return fontBytesSize(held); }
	const file = cFopen(path as cstring, "rb" as cstring);
	if (file == null) { return -1; }
	cFseek(file, 0, SEEK_END);
	const measured: int64 = cFtell(file);
	cFclose(file);
	return measured < 0 ? 0 : measured;
}

// Fills `into` with the bytes at `at`; false when the range is not all there.
export function sfntSourceRead(path: string, at: int64, into: Span<uint8>): boolean {
	const held = fontBytesFind(path);
	if (held >= 0) { return fontBytesRead(held, at, into); }
	const file = cFopen(path as cstring, "rb" as cstring);
	if (file == null) { return false; }
	const wanted = into.length as uint64;
	const target = into as Ptr<uint8>;
	let ok: boolean = false;
	if (cFseek(file, at, SEEK_SET) == 0) {
		const got: uint64 = cFread(target, 1, wanted, file);
		ok = got == wanted;
	}
	cFclose(file);
	return ok;
}
