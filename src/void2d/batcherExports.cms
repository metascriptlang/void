// The bridge's commit hook on the C targets: void2dFrameEnd runs right after the door's submit.

@include("batcherHook.h");
extern function void2dRegisterFrameEnd(): void;

import { void2dFrameEnd } from "./batcher";

@exportName("void2dFrameEndHook")
export function exportFrameEnd(): void { void2dFrameEnd(); }

export function registerCommitHook(): void {
	void2dRegisterFrameEnd();
}
