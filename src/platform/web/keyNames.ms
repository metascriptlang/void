// The DOM key name (KeyboardEvent.code, or .key when a browser gives no code) to Void's key
// code, as the keyTable of src/platform/web/window.c holds it for the wasm window. The js window
// imports this module; window.c reaches it through keyNamesExports.cms and keyNames.h.

import { KeyCode } from "../appEvent";

export function translateKey(name: string): int32 {
	return match (name) {
		"Backspace" => KeyCode.Backspace as int32,
		"Tab" => KeyCode.Tab as int32,
		"Enter" => KeyCode.Enter as int32,
		"ShiftLeft" => KeyCode.LeftShift as int32,
		"ShiftRight" => KeyCode.RightShift as int32,
		"ControlLeft" => KeyCode.LeftControl as int32,
		"ControlRight" => KeyCode.RightControl as int32,
		"AltLeft" => KeyCode.LeftAlt as int32,
		"AltRight" => KeyCode.RightAlt as int32,
		"Pause" => KeyCode.Pause as int32,
		"CapsLock" => KeyCode.CapsLock as int32,
		"Escape" => KeyCode.Escape as int32,
		"Space" => KeyCode.Space as int32,
		"PageUp" => KeyCode.PageUp as int32,
		"PageDown" => KeyCode.PageDown as int32,
		"End" => KeyCode.End as int32,
		"Home" => KeyCode.Home as int32,
		"ArrowLeft" => KeyCode.Left as int32,
		"ArrowUp" => KeyCode.Up as int32,
		"ArrowRight" => KeyCode.Right as int32,
		"ArrowDown" => KeyCode.Down as int32,
		"PrintScreen" => KeyCode.PrintScreen as int32,
		"Insert" => KeyCode.Insert as int32,
		"Delete" => KeyCode.Delete as int32,
		"Digit0" => KeyCode.Digit0 as int32,
		"Digit1" => KeyCode.Digit1 as int32,
		"Digit2" => KeyCode.Digit2 as int32,
		"Digit3" => KeyCode.Digit3 as int32,
		"Digit4" => KeyCode.Digit4 as int32,
		"Digit5" => KeyCode.Digit5 as int32,
		"Digit6" => KeyCode.Digit6 as int32,
		"Digit7" => KeyCode.Digit7 as int32,
		"Digit8" => KeyCode.Digit8 as int32,
		"Digit9" => KeyCode.Digit9 as int32,
		"KeyA" => KeyCode.A as int32,
		"KeyB" => KeyCode.B as int32,
		"KeyC" => KeyCode.C as int32,
		"KeyD" => KeyCode.D as int32,
		"KeyE" => KeyCode.E as int32,
		"KeyF" => KeyCode.F as int32,
		"KeyG" => KeyCode.G as int32,
		"KeyH" => KeyCode.H as int32,
		"KeyI" => KeyCode.I as int32,
		"KeyJ" => KeyCode.J as int32,
		"KeyK" => KeyCode.K as int32,
		"KeyL" => KeyCode.L as int32,
		"KeyM" => KeyCode.M as int32,
		"KeyN" => KeyCode.N as int32,
		"KeyO" => KeyCode.O as int32,
		"KeyP" => KeyCode.P as int32,
		"KeyQ" => KeyCode.Q as int32,
		"KeyR" => KeyCode.R as int32,
		"KeyS" => KeyCode.S as int32,
		"KeyT" => KeyCode.T as int32,
		"KeyU" => KeyCode.U as int32,
		"KeyV" => KeyCode.V as int32,
		"KeyW" => KeyCode.W as int32,
		"KeyX" => KeyCode.X as int32,
		"KeyY" => KeyCode.Y as int32,
		"KeyZ" => KeyCode.Z as int32,
		"MetaLeft" => KeyCode.LeftSuper as int32,
		"MetaRight" => KeyCode.RightSuper as int32,
		"Numpad0" => KeyCode.Keypad0 as int32,
		"Numpad1" => KeyCode.Keypad1 as int32,
		"Numpad2" => KeyCode.Keypad2 as int32,
		"Numpad3" => KeyCode.Keypad3 as int32,
		"Numpad4" => KeyCode.Keypad4 as int32,
		"Numpad5" => KeyCode.Keypad5 as int32,
		"Numpad6" => KeyCode.Keypad6 as int32,
		"Numpad7" => KeyCode.Keypad7 as int32,
		"Numpad8" => KeyCode.Keypad8 as int32,
		"Numpad9" => KeyCode.Keypad9 as int32,
		"NumpadMultiply" => KeyCode.KeypadMultiply as int32,
		"NumpadAdd" => KeyCode.KeypadAdd as int32,
		"NumpadSubtract" => KeyCode.KeypadSubtract as int32,
		"NumpadDecimal" => KeyCode.KeypadDecimal as int32,
		"NumpadDivide" => KeyCode.KeypadDivide as int32,
		"F1" => KeyCode.F1 as int32,
		"F2" => KeyCode.F2 as int32,
		"F3" => KeyCode.F3 as int32,
		"F4" => KeyCode.F4 as int32,
		"F5" => KeyCode.F5 as int32,
		"F6" => KeyCode.F6 as int32,
		"F7" => KeyCode.F7 as int32,
		"F8" => KeyCode.F8 as int32,
		"F9" => KeyCode.F9 as int32,
		"F10" => KeyCode.F10 as int32,
		"F11" => KeyCode.F11 as int32,
		"F12" => KeyCode.F12 as int32,
		"NumLock" => KeyCode.NumLock as int32,
		"ScrollLock" => KeyCode.ScrollLock as int32,
		"Semicolon" => KeyCode.Semicolon as int32,
		"Equal" => KeyCode.Equal as int32,
		"Comma" => KeyCode.Comma as int32,
		"Minus" => KeyCode.Minus as int32,
		"Period" => KeyCode.Period as int32,
		"Slash" => KeyCode.Slash as int32,
		"Backquote" => KeyCode.GraveAccent as int32,
		"BracketLeft" => KeyCode.LeftBracket as int32,
		"Backslash" => KeyCode.Backslash as int32,
		"BracketRight" => KeyCode.RightBracket as int32,
		"Quote" => KeyCode.Apostrophe as int32,
		_ => KeyCode.Invalid as int32,
	};
}
