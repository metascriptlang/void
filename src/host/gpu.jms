// Void GPU on the browser's JS target: gpu.wms's surface over the backend this bundle selects
// (-d:webgl2, else WebGPU), and the device and door its two drivers share, as bridgeWeb.c drives
// them. The window driver is gpuWindow.jms (one canvas, the AppWindow events, the frame timing),
// the views driver gpuViews.jms (a root per canvas, no AppWindow); an entry imports the one it
// runs, so its bundle carries no other. A document uses one of the two.

import { CanvasView, publishRun } from "../platform/web/window";
import { PixelFormat, doorSetup, doorShutdown } from "../gpu/doorGpu";

when (webgl2) {
	import { acquireContext } from "../webgpu/gl/glCalls";

	export class GpuSurface {}
	export function surfaceOpen(selector: string): GpuSurface { return new GpuSurface(); }
	export function surfaceReconfigure(surface: GpuSurface): void {}
	export function surfaceClose(surface: GpuSurface): void {}
	export function surfaceBind(surface: GpuSurface): void {}
	export function doorDrop(): void { doorShutdown(); }
	export function framesStopWhenLost(): boolean { return false; }
} else {
	import { acquireDevice } from "../webgpu/js/backend";
	export {
		Surface as GpuSurface,
		surfaceCreate as surfaceOpen,
		surfaceDestroy as surfaceClose,
		surfaceResize as surfaceReconfigure,
		surfaceUse as surfaceBind,
	} from "../webgpu/js/backend";

	export function doorDrop(): void {}
	export function framesStopWhenLost(): boolean { return true; }
}

when (webgl2) {
	function canvasColor(): PixelFormat { return PixelFormat.Rgba8; }
} else {
	extern function prefersBgra(): boolean from "(navigator.gpu.getPreferredCanvasFormat()=='bgra8unorm')";
	function canvasColor(): PixelFormat { return prefersBgra() ? PixelFormat.Bgra8 : PixelFormat.Rgba8; }
}

export enum Driver { None, Window, Views }

export class Start {
	canvas: CanvasView;
	onError: (message: string) => void;
	stopped: boolean = false;

	constructor(canvas: CanvasView, onError: (message: string) => void) {
		this.canvas = canvas;
		this.onError = onError;
	}

	suspend(): void {}
	resume(): void {}
	release(): void {}

	stop(): void {
		if (this.stopped) { return; }
		this.stopped = true;
		starts.splice(starts.indexOf(this), 1);
		this.release();
	}
}

export class HostDriver {
	name: string;

	constructor(name: string) { this.name = name; }

	absent(operation: string): never {
		return fail(`${operation}: this bundle has no ${this.name}`);
	}

	live(): boolean { return this.absent("live"); }
	sampleCount(): int32 { return this.absent("sampleCount"); }
	fbWidth(): int32 { return this.absent("fbWidth"); }
	fbHeight(): int32 { return this.absent("fbHeight"); }
	dpiScale(): float32 { return this.absent("dpiScale"); }
	keyDown(code: int32): boolean { return this.absent("keyDown"); }
	present(): void { this.absent("present"); }
}

class GpuState {
	lost: boolean = false;
	doorStale: boolean = false;
	doorUp: boolean = false;
	runEpoch: int32 = 0;
}

export const gpuState = new GpuState();
export const starts: Start[] = [];
let driver = Driver.None;
let windowDriver = new HostDriver("window driver; its entry imports src/host/gpuWindow");
let viewsDriver = new HostDriver("views driver; its entry imports src/host/gpuViews");

export function useWindowDriver(hooks: HostDriver): void { windowDriver = hooks; }
export function useViewsDriver(hooks: HostDriver): void { viewsDriver = hooks; }

export function fail(message: string): never { throw new Error(`void: ${message}`); }

function refuseBesideOther(kind: Driver): void {
	if (kind == Driver.Views && driver == Driver.Window) {
		fail("voidViewCreate: this document already runs a Void canvas window");
	}
	if (kind == Driver.Window && driver == Driver.Views) {
		fail("voidRun: this document already drives Void through host views");
	}
}

export function claimDriver(kind: Driver): void {
	refuseBesideOther(kind);
	driver = kind;
}

function sampleCount(): int32 {
	return driver == Driver.Window ? windowDriver.sampleCount() : viewsDriver.sampleCount();
}

function doorOpen(): void {
	const depth = driver == Driver.Window ? PixelFormat.Depth : PixelFormat.None;
	doorSetup(null, null, canvasColor() as int32, depth as int32, sampleCount());
}

function doorRestore(): void {
	doorShutdown();
	doorOpen();
	gpuState.doorStale = false;
	gpuState.doorUp = true;
}

export function doorEnsure(): void {
	when (webgl2) {
		doorRestore();
	} else {
		if (!gpuState.doorUp || gpuState.doorStale) { doorRestore(); }
	}
}

export function restoreStale(): void {
	if (gpuState.doorStale) { doorRestore(); }
}

function driverFor(operation: string): HostDriver {
	if (driver == Driver.None || (driver == Driver.Views && !viewsDriver.live())) {
		fail(`${operation} before voidRun or voidViewCreate chose a driver`);
	}
	if (driver == Driver.Window && !windowDriver.live()) {
		fail(`${operation}: the window does not exist; call it from the event handler or after init`);
	}
	return driver == Driver.Window ? windowDriver : viewsDriver;
}

function onLost(): void {
	gpuState.doorUp = false;
	if (starts.length == 0 || gpuState.lost) { return; }
	gpuState.lost = true;
	for (const start of starts.slice(0)) { start.suspend(); }
	recoverDevice(gpuState.runEpoch);
}

function onRestored(): void {
	if (starts.length == 0) { return; }
	gpuState.lost = false;
	gpuState.doorStale = true;
	for (const start of starts.slice(0)) { start.resume(); }
}

when (webgl2) {
	function recoverDevice(epoch: int32): void {}
} else {
	async function recoverDevice(epoch: int32): Promise<void> {
		try {
			await acquireDevice(onLost);
		} catch (error) {
			if (epoch == gpuState.runEpoch) {
				for (const start of starts.slice(0)) { start.onError(`void: the WebGPU device was lost and a new one could not be made: ${error.message}`); }
			}
			return;
		}
		if (epoch == gpuState.runEpoch) { onRestored(); }
	}
}

export async function acquire(canvas: CanvasView, start: Start): Promise<boolean> {
	try {
		when (webgl2) {
			acquireContext(canvas.selector, sampleCount(), onLost, onRestored);
		} else {
			await acquireDevice(onLost);
		}
	} catch (error) {
		if (!start.stopped) { start.onError(`void: this browser gave no GPU backend: ${error.message}`); }
		return false;
	}
	return !start.stopped;
}

function noWindowRun(width: int32, height: int32, init: () => void, frame: () => void): void {
	refuseBesideOther(Driver.Window);
	windowDriver.absent("voidRun");
}

function noWindowRunConfigured(width: int32, height: int32, samples: int32, highDpi: int32, init: () => void, frame: () => void): void {
	refuseBesideOther(Driver.Window);
	windowDriver.absent("voidRunConfigured");
}

publishRun(noWindowRun, noWindowRunConfigured);

export function viewSampleCount(): int32 { return sampleCount(); }
export function viewsPresent(): void {
	if (driver == Driver.Views) { viewsDriver.present(); }
}

export function gfxSetup(): void {
	driverFor("gfxSetup");
	if (driver == Driver.Window) { doorOpen(); }
}
export function fbWidth(): int32 { return driverFor("fbWidth").fbWidth(); }
export function fbHeight(): int32 { return driverFor("fbHeight").fbHeight(); }
export function dpiScale(): float32 { return driverFor("dpiScale").dpiScale(); }
export function keyDown(code: int32): boolean { return driver == Driver.Window && windowDriver.keyDown(code); }

export function makeImage(rgba: Ptr<void>, w: int32, h: int32): uint32 {
	return fail("makeImage waits for the door on js; its pointer argument is ~/metascript/.inbox/compiler/2026-10-27-js-element-address-as-pointer-argument.md");
}
export function makeView(image: uint32): uint32 {
	return fail("makeView waits for the door on js");
}
