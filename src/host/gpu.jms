// Void GPU on the browser's JS target: gpu.wms's surface over the backend this bundle selects
// (-d:webgl2, else WebGPU), driven as bridgeWeb.c drives it. voidRun is the window driver: one
// canvas, the AppWindow events, the frame timing. voidStart is the views driver: a root per
// canvas, no AppWindow. A document uses one of the two.

import { CanvasSize, CanvasView, detach, enter, installStart, leave, pageCanvas, publishRun } from "../platform/web/window";
import { PixelFormat, doorSetup, doorShutdown } from "../gpu/doorGpu";
import { AppEventType } from "../platform/appEvent";
import { appWindow, browserWindow } from "./appWindowBrowser";
import { Views, ViewsPlatform } from "./views";

when (webgl2) {
	import { acquireContext } from "../webgpu/gl/glCalls";

	class GpuSurface {}
	function surfaceOpen(selector: string): GpuSurface { return new GpuSurface(); }
	function surfaceReconfigure(surface: GpuSurface): void {}
	function surfaceClose(surface: GpuSurface): void {}
	function surfaceBind(surface: GpuSurface): void {}
	function doorDrop(): void { doorShutdown(); }
	function framesStopWhenLost(): boolean { return false; }
} else {
	import {
		Surface as GpuSurface,
		acquireDevice,
		surfaceCreate as surfaceOpen,
		surfaceDestroy as surfaceClose,
		surfaceResize as surfaceReconfigure,
		surfaceUse as surfaceBind,
	} from "../webgpu/js/backend";

	function doorDrop(): void {}
	function framesStopWhenLost(): boolean { return true; }
}

when (webgl2) {
	function canvasColor(): PixelFormat { return PixelFormat.Rgba8; }
} else {
	extern function prefersBgra(): boolean from "(navigator.gpu.getPreferredCanvasFormat()=='bgra8unorm')";
	function canvasColor(): PixelFormat { return prefersBgra() ? PixelFormat.Bgra8 : PixelFormat.Rgba8; }
}

export type ViewId = int32;
export const ViewInvalid: ViewId = 0 as int32;

enum Driver { None, Window, Views }

class Start {
	canvas: CanvasView;
	onError: (message: string) => void;
	stopped: boolean = false;

	constructor(canvas: CanvasView, onError: (message: string) => void) {
		this.canvas = canvas;
		this.onError = onError;
	}

	suspend(): void {}
	resume(): void {}
	release(): void {}

	stop(): void {
		if (this.stopped) { return; }
		this.stopped = true;
		starts.splice(starts.indexOf(this), 1);
		this.release();
	}
}

class ViewStart extends Start {
	view: ViewId = ViewInvalid;

	release(): void {
		if (this.view != ViewInvalid) {
			leave(this.canvas);
			views.destroy(this.view);
		}
	}
}

class WindowRun extends Start {
	init: () => void;
	frame: () => void;
	inited: boolean = false;
	surface: GpuSurface | null = null;

	constructor(canvas: CanvasView, onError: (message: string) => void, init: () => void, frame: () => void) {
		super(canvas, onError);
		this.init = init;
		this.frame = frame;
	}

	suspend(): void { emitApp(AppEventType.Suspended); }
	resume(): void { emitApp(AppEventType.Resumed); }

	release(): void {
		if (!browserWindow.valid()) { return; }
		leave(this.canvas);
		browserWindow.end();
		const surface = this.surface;
		if (surface !== null) { surfaceClose(surface); }
		doorShutdown();
		detach(this.canvas);
	}

	tick(time: float64): void {
		browserWindow.beginFrame(time);
		let ran = false;
		if (!(platform.lost && framesStopWhenLost())) {
			if (!this.inited) {
				this.init();
				browserWindow.initDone();
				this.inited = true;
			}
			platform.restoreStale();
			const surface = this.surface;
			if (surface !== null) { surfaceBind(surface); }
			this.frame();
			ran = true;
		}
		if (browserWindow.endFrame(ran)) { this.stop(); }
	}
}

class BrowserPlatform extends ViewsPlatform {
	lost: boolean = false;
	doorStale: boolean = false;
	doorUp: boolean = false;
	surfaces: (GpuSurface | null)[] = [];

	fail(message: string): never { throw new Error(`void: ${message}`); }
	deviceEnsure(): void { doorEnsure(); }
	runInit(init: () => void): void { init(); }

	surfaceCreate(slot: int32, native: int64, width: int32, height: int32): boolean {
		while (this.surfaces.length <= slot) { this.surfaces.push(null); }
		this.surfaces[slot] = surfaceOpen(startFor(native).canvas.selector);
		return true;
	}

	surfaceResize(slot: int32, width: int32, height: int32): void { surfaceReconfigure(this.surfaceAt(slot)); }
	surfaceReady(slot: int32): boolean { return this.ready(); }

	surfaceAcquire(slot: int32): boolean {
		surfaceBind(this.surfaceAt(slot));
		return true;
	}

	surfacePresent(slot: int32): void {}

	surfaceDestroy(slot: int32): void {
		surfaceClose(this.surfaceAt(slot));
		this.surfaces[slot] = null;
		doorDrop();
	}

	surfaceNative(slot: int32): int64 { return 0; }

	surfaceAt(slot: int32): GpuSurface {
		const surface = slot < this.surfaces.length ? this.surfaces[slot] : null;
		if (surface === null) { return this.fail(`view slot ${slot} has no surface`); }
		return surface;
	}

	restoreStale(): void {
		if (this.doorStale) { doorRestore(); }
	}

	ready(): boolean {
		if (this.lost) { return false; }
		this.restoreStale();
		return true;
	}
}

const platform = new BrowserPlatform();
const views = new Views(platform);
const WINDOW_CANVAS = "#canvas";
let driver = Driver.None;
let windowSamples: int32 = 1;
let runEpoch = 0;
const starts: Start[] = [];

function startFor(native: int64): Start {
	const id = native as int32;
	for (const start of starts) {
		if (start.canvas.id == id) { return start; }
	}
	return platform.fail(`voidViewCreate: no live start for canvas ${id}`);
}

function sampleCount(): int32 { return driver == Driver.Window ? windowSamples : views.sampleCount(); }

function doorOpen(): void {
	const depth = driver == Driver.Window ? PixelFormat.Depth : PixelFormat.None;
	doorSetup(null, null, canvasColor() as int32, depth as int32, sampleCount());
}

function doorRestore(): void {
	doorShutdown();
	doorOpen();
	platform.doorStale = false;
	platform.doorUp = true;
}

function doorEnsure(): void {
	when (webgl2) {
		doorRestore();
	} else {
		if (!platform.doorUp || platform.doorStale) { doorRestore(); }
	}
}

function driverFor(operation: string): Driver {
	if (driver == Driver.None || (driver == Driver.Views && !views.deviceMade)) {
		platform.fail(`${operation} before voidRun or voidViewCreate chose a driver`);
	}
	if (driver == Driver.Window && !browserWindow.valid()) {
		platform.fail(`${operation}: the window does not exist; call it from the event handler or after init`);
	}
	return driver;
}

function emitApp(type: AppEventType): void {
	const live = browserWindow.live;
	if (live !== null) { live.emit(type); }
}

function onLost(): void {
	platform.doorUp = false;
	if (starts.length == 0 || platform.lost) { return; }
	platform.lost = true;
	for (const start of starts.slice(0)) { start.suspend(); }
	recoverDevice(runEpoch);
}

function onRestored(): void {
	if (starts.length == 0) { return; }
	platform.lost = false;
	platform.doorStale = true;
	for (const start of starts.slice(0)) { start.resume(); }
}

when (webgl2) {
	function recoverDevice(epoch: int32): void {}
} else {
	async function recoverDevice(epoch: int32): Promise<void> {
		try {
			await acquireDevice(onLost);
		} catch (error) {
			if (epoch == runEpoch) {
				for (const start of starts.slice(0)) { start.onError(`void: the WebGPU device was lost and a new one could not be made: ${error.message}`); }
			}
			return;
		}
		if (epoch == runEpoch) { onRestored(); }
	}
}

async function acquire(canvas: CanvasView, start: Start): Promise<boolean> {
	try {
		when (webgl2) {
			acquireContext(canvas.selector, sampleCount(), onLost, onRestored);
		} else {
			await acquireDevice(onLost);
		}
	} catch (error) {
		if (!start.stopped) { start.onError(`void: this browser gave no GPU backend: ${error.message}`); }
		return false;
	}
	return !start.stopped;
}

async function beginViews(canvas: CanvasView, start: ViewStart): Promise<void> {
	if (!(await acquire(canvas, start))) { return; }
	const size = canvas.size;
	const view = views.create(canvas.id as int64, size.width, size.height, size.scale);
	start.view = view;
	enter(
		canvas,
		(resized: CanvasSize): void => { views.resize(view, resized.width, resized.height, resized.scale); },
		(time: float64): void => { views.frame(view); },
	);
}

async function beginWindow(canvas: CanvasView, run: WindowRun): Promise<void> {
	if (!(await acquire(canvas, run))) { return; }
	run.surface = surfaceOpen(canvas.selector);
	browserWindow.begin(canvas);
	enter(
		canvas,
		(resized: CanvasSize): void => {
			browserWindow.resized(resized);
			const surface = run.surface;
			if (surface !== null) { surfaceReconfigure(surface); }
		},
		(time: float64): void => { run.tick(time); },
	);
}

function open(canvas: CanvasView, onError: (message: string) => void): () => void {
	if (driver == Driver.Window) { platform.fail("voidViewCreate: this document already runs a Void canvas window"); }
	if (starts.length > 0) {
		when (webgl2) {
			platform.fail(`voidViewCreate: WebGL2 runs one view at a time; stop view ${starts[0].canvas.id} first`);
		}
	}
	driver = Driver.Views;
	if (starts.length == 0) {
		runEpoch++;
		platform.lost = false;
	}
	const start = new ViewStart(canvas, onError);
	starts.push(start);
	beginViews(canvas, start);
	return (): void => { start.stop(); };
}

function fatal(message: string): void { throw new Error(message); }

function voidRunConfigured(width: int32, height: int32, samples: int32, highDpi: int32, init: () => void, frame: () => void): void {
	if (driver == Driver.Views) { platform.fail("voidRun: this document already drives Void through host views"); }
	driver = Driver.Window;
	if (starts.length > 0) { platform.fail("voidWebRun: the browser window already runs"); }
	const canvas = pageCanvas(WINDOW_CANVAS, highDpi != 0);
	if (canvas === null) { return platform.fail(`no canvas ${WINDOW_CANVAS}: the page has no ${WINDOW_CANVAS}`); }
	windowSamples = samples <= 0 ? 1 : samples;
	const run = new WindowRun(canvas, fatal, init, frame);
	starts.push(run);
	runEpoch++;
	platform.lost = false;
	platform.doorStale = false;
	beginWindow(canvas, run);
}

function voidRun(width: int32, height: int32, init: () => void, frame: () => void): void {
	voidRunConfigured(width, height, 4, 1, init, frame);
}

publishRun(voidRun, voidRunConfigured);

export function embedRegister(init: () => void, frame: () => void): void {
	views.register(init, frame);
	installStart(open);
}

export function setViewSampleCount(count: int32): void { views.setSampleCount(count); }
export function viewSampleCount(): int32 { return sampleCount(); }
export function currentView(): ViewId { return views.currentView; }
export function viewsPresent(): void {
	if (driver == Driver.Views) { views.present(); }
}

export function gfxSetup(): void {
	if (driverFor("gfxSetup") == Driver.Window) { doorOpen(); }
}
export function fbWidth(): int32 { return driverFor("fbWidth") == Driver.Window ? browserWindow.framebufferWidth() : views.fbWidth(); }
export function fbHeight(): int32 { return driverFor("fbHeight") == Driver.Window ? browserWindow.framebufferHeight() : views.fbHeight(); }
export function dpiScale(): float32 { return driverFor("dpiScale") == Driver.Window ? browserWindow.running("dpiScale").state.dpiScale : views.dpiScale(); }
export function keyDown(code: int32): boolean { return driver == Driver.Window && appWindow.keysHeld.isDown(code); }

export function makeImage(rgba: Ptr<void>, w: int32, h: int32): uint32 {
	return platform.fail("makeImage waits for the door on js; its pointer argument is ~/metascript/.inbox/compiler/2026-10-27-js-element-address-as-pointer-argument.md");
}
export function makeView(image: uint32): uint32 {
	return platform.fail("makeView waits for the door on js");
}
