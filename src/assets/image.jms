// Void Asset — images on JS: the formats and pixels are shared; decoding needs the C decoder.

import { ImageError, Pixels, DecodedAnimation } from "./imageTypes";
export {
	ImageFormat, ImageError, Pixels, DecodedAnimation, imageFormatOf, gifDelayMs,
} from "./imageTypes";

export function decodeImage(bytes: Readonly<Span<uint8>>): Result<Pixels, ImageError> {
	return Result.err(ImageError.NoDecoderOnJs);
}

export function decodeAnimation(bytes: Readonly<Span<uint8>>): Result<DecodedAnimation, ImageError> {
	return Result.err(ImageError.NoDecoderOnJs);
}
