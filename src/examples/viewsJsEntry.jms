import { doorBeginScreenPass, doorCommit } from "../gpu/doorGpu";
import { fbHeight, fbWidth } from "../host/gpu";
import { embedRegister } from "../host/gpuViews";

function init(): void {
	console.log("void js view init");
}

function frame(): void {
	console.log(`void js view frame ${fbWidth()}x${fbHeight()}`);
	doorBeginScreenPass(0.1, 0.2, 0.3, 1.0);
	doorCommit();
}

embedRegister(init, frame);
