// Void GPU on the browser's JS target: gpu.wms's surface, driven by voidStart as bridgeWeb.c
// drives it, over the backend this bundle selects (-d:webgl2, else WebGPU).

import { CanvasSize, CanvasView, enter, installStart, leave } from "../platform/web/window";
import { PixelFormat, doorSetup } from "../gpu/doorGpu";
import { browserWindow } from "./appWindowBrowser";
import { Views, ViewsPlatform } from "./views";

when (webgl2) {
	import { acquireContext } from "../webgpu/gl/glCalls";
} else {
	import { acquireDevice } from "../webgpu/js/backend";
}

when (webgl2) {
	function canvasColor(): PixelFormat { return PixelFormat.Rgba8; }
} else {
	extern function prefersBgra(): boolean from "(navigator.gpu.getPreferredCanvasFormat()=='bgra8unorm')";
	function canvasColor(): PixelFormat { return prefersBgra() ? PixelFormat.Bgra8 : PixelFormat.Rgba8; }
}

export type ViewId = int32;
export const ViewInvalid: ViewId = 0 as int32;

class Start {
	canvas: CanvasView;
	stopped: boolean = false;
	view: ViewId = ViewInvalid;

	constructor(canvas: CanvasView) {
		this.canvas = canvas;
	}

	stop(): void {
		if (this.stopped) { return; }
		this.stopped = true;
		liveStarts--;
		if (browserWindow.valid()) { browserWindow.end(); }
		if (this.view != ViewInvalid) {
			leave(this.canvas);
			views.destroy(this.view);
		}
	}
}

class BrowserPlatform extends ViewsPlatform {
	lost: boolean = false;

	fail(message: string): never { throw new Error(`void: ${message}`); }
	deviceEnsure(): void {}
	runInit(init: () => void): void {
		doorSetup(null, null, canvasColor() as int32, PixelFormat.None as int32, views.sampleCount());
		init();
	}
	surfaceCreate(slot: int32, native: int64, width: int32, height: int32): boolean { return true; }
	surfaceResize(slot: int32, width: int32, height: int32): void {}
	surfaceReady(slot: int32): boolean {
		if (this.lost) { this.fail("the GPU was lost; recovering it needs the door's setup, which the js target does not port yet"); }
		return true;
	}
	surfaceAcquire(slot: int32): boolean { return true; }
	surfacePresent(slot: int32): void {}
	surfaceDestroy(slot: int32): void {}
	surfaceNative(slot: int32): int64 { return 0; }
}

const platform = new BrowserPlatform();
const views = new Views(platform);
let liveStarts = 0;

function onLost(): void { platform.lost = true; }

async function acquire(canvas: CanvasView): Promise<void> {
	when (webgl2) {
		acquireContext(canvas.selector, views.sampleCount(), onLost);
	} else {
		await acquireDevice(canvas.selector, onLost);
	}
}

async function begin(canvas: CanvasView, onError: (message: string) => void, start: Start): Promise<void> {
	try {
		await acquire(canvas);
	} catch (error) {
		if (!start.stopped) { onError(`void: this browser gave no GPU backend: ${error}`); }
		return;
	}
	if (start.stopped) { return; }
	const size = canvas.size;
	browserWindow.begin(canvas);
	const view = views.create(0, size.width, size.height, size.scale);
	start.view = view;
	browserWindow.initDone();
	enter(
		canvas,
		(resized: CanvasSize): void => {
			views.resize(view, resized.width, resized.height, resized.scale);
			browserWindow.resized(resized);
		},
		(time: float64): void => {
			browserWindow.beginFrame(time);
			views.frame(view);
			if (browserWindow.endFrame()) { start.stop(); }
		},
	);
}

function open(canvas: CanvasView, onError: (message: string) => void): () => void {
	if (liveStarts > 0) { platform.fail("voidStart: the js target runs one view at a time; stop the live view first"); }
	liveStarts++;
	const start = new Start(canvas);
	begin(canvas, onError, start);
	return (): void => { start.stop(); };
}

export function embedRegister(init: () => void, frame: () => void): void {
	views.register(init, frame);
	installStart(open);
}

export function setViewSampleCount(count: int32): void { views.setSampleCount(count); }
export function viewSampleCount(): int32 { return views.sampleCount(); }
export function currentView(): ViewId { return views.currentView; }
export function viewsPresent(): void { views.present(); }

export function gfxSetup(): void {
	if (!views.deviceMade) { platform.fail("gfxSetup before voidViewCreate chose a driver"); }
}
export function fbWidth(): int32 { return views.fbWidth(); }
export function fbHeight(): int32 { return views.fbHeight(); }
export function dpiScale(): float32 { return views.dpiScale(); }
export function keyDown(code: int32): boolean { return false; }

export function makeImage(rgba: Ptr<void>, w: int32, h: int32): uint32 {
	return platform.fail("makeImage waits for the door on js; its pointer argument is ~/metascript/.inbox/compiler/2026-10-27-js-element-address-as-pointer-argument.md");
}
export function makeView(image: uint32): uint32 {
	return platform.fail("makeView waits for the door on js");
}
