// Void GPU — browser (--os=emcc). Same API as gpu.ms, on Void's browser window
// (src/platform/web). The build names the browser API with -d:webgpu or -d:webgl2.

@include("bridge.h");
@compile("./bridge.c");
@compile("./bridgeWeb.c");
@compile("./views.c");
@compile("./appWindow.c");
@compile("../platform/web/window.c");

when (webgpu) {
	@passC("--use-port=emdawnwebgpu");
	@passC("-DVOID_WGPU");
	@passL("--use-port=emdawnwebgpu");
} else when (webgl2) {
	@passC("-DVOID_GLES3");
	@passL("-sFULL_ES3=1");
	@passL("-sMAX_WEBGL_VERSION=2");
}

extern function voidEmbedRegister(init: () => void, frame: () => void): void;
extern function voidWebInstall(): void;
extern function voidViewsSetSampleCount(count: int32): void;
extern function voidCurrentView(): int32;

export type ViewId = int32;
export const ViewInvalid: ViewId = 0 as int32;

// The page starts and stops views itself: Module.voidStart(canvas) returns a stop.
export function embedRegister(init: () => void, frame: () => void): void {
	voidEmbedRegister(init, frame);
	voidWebInstall();
}
export function setViewSampleCount(count: int32): void { voidViewsSetSampleCount(count); }
export function currentView(): ViewId { return voidCurrentView(); }

export * from "./gpuCommon";
