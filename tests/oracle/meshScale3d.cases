case scale-positive tol=0
haxe> emit("scale-positive",H.sample(2));
ms> const positive = scaledTriangle(2.0); if (!positive.ok) { return 1; }
ms> sampleScale("scale-positive",positive.value);

case scale-negative tol=0
haxe> emit("scale-negative",H.sample(-2));
ms> const negative = scaledTriangle(-2.0); if (!negative.ok) { return 1; }
ms> sampleScale("scale-negative",negative.value);

case scale-zero tol=0
haxe> emit("scale-zero",H.sample(0));
ms> const zero = scaledTriangle(0.0); if (!zero.ok) { return 1; }
ms> sampleScale("scale-zero",zero.value);
