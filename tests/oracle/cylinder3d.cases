case cylinder-dimension tol=1e-6
haxe> emit("cylinder-dimension",[H.col([0,0,0],[0,0,2],1).dimension()]);
ms> emit1("cylinder-dimension",size(col(vec3(0,0,0),vec3(0,0,2),1.0)));

case cylinder-dimension-oblique tol=1e-6
haxe> emit("cylinder-dimension-oblique",[H.col([1,2,3],[4,6,3],0.5).dimension()]);
ms> emit1("cylinder-dimension-oblique",size(col(vec3(1,2,3),vec3(4,6,3),0.5)));

case cylinder-frustum-inside tol=0
haxe> emit("cylinder-frustum-inside",[H.frustum(H.col([0,0,0.2],[0,0,0.4],0.1))]);
ms> emit1("cylinder-frustum-inside",frustum(col(vec3(0,0,0.2),vec3(0,0,0.4),0.1)));

case cylinder-frustum-outside tol=0
haxe> emit("cylinder-frustum-outside",[H.frustum(H.col([5,0,0.5],[7,0,0.5],0.5))]);
ms> emit1("cylinder-frustum-outside",frustum(col(vec3(5,0,0.5),vec3(7,0,0.5),0.5)));

case cylinder-frustum-trailing-end-outside tol=0 diverges=cylinder-bounding-sphere-centre-at-b
haxe> emit("cylinder-frustum-trailing-end-outside",[H.frustum(H.col([-3.2,0,0.5],[-1.2,0,0.5],0.1))]);
ms> emit1("cylinder-frustum-trailing-end-outside",frustum(col(vec3(-3.2,0,0.5),vec3(-1.2,0,0.5),0.1)));

case cylinder-sphere-apart tol=0
haxe> emit("cylinder-sphere-apart",[H.sphere(H.col([0,0,0],[0,0,2],1),[0,0,-3.5,0.5])]);
ms> emit1("cylinder-sphere-apart",sphere(col(vec3(0,0,0),vec3(0,0,2),1.0),{center:vec3(0,0,-3.5),radius:0.5}));

case cylinder-sphere-near-b tol=0 diverges=cylinder-bounding-sphere-centre-at-b
haxe> emit("cylinder-sphere-near-b",[H.sphere(H.col([0,0,0],[0,0,2],1),[0,0,3,0.5])]);
ms> emit1("cylinder-sphere-near-b",sphere(col(vec3(0,0,0),vec3(0,0,2),1.0),{center:vec3(0,0,3),radius:0.5}));

case cylinder-sphere-near-a tol=0 diverges=cylinder-bounding-sphere-centre-at-b
haxe> emit("cylinder-sphere-near-a",[H.sphere(H.col([0,0,0],[0,0,2],1),[0,0,-0.8,0.5])]);
ms> emit1("cylinder-sphere-near-a",sphere(col(vec3(0,0,0),vec3(0,0,2),1.0),{center:vec3(0,0,-0.8),radius:0.5}));
