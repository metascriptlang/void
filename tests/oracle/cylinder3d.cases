haxe> emit("cylinder-ray-inside",[H.ray(H.col([0,0,0],[0,0,2],1),[0,0,1],[1,0,0])]);
ms> emit1("cylinder-ray-inside",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0,0,1),vec3(1,0,0)));

case cylinder-ray-perpendicular-above tol=1e-5
haxe> emit("cylinder-ray-perpendicular-above",[H.ray(H.col([0,0,0],[0,0,2],1),[0,-5,3],[0,1,0])]);
ms> emit1("cylinder-ray-perpendicular-above",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0,-5,3),vec3(0,1,0)));

case cylinder-ray-slanted-through-cap-and-side tol=1e-5
haxe> emit("cylinder-ray-slanted-through-cap-and-side",[H.ray(H.col([0,0,0],[0,0,2],1),[-3,0,-1],[0.6,0,0.8])]);
ms> emit1("cylinder-ray-slanted-through-cap-and-side",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(-3,0,-1),vec3(0.6,0,0.8)));

case cylinder-ray-oblique-axis tol=1e-5 diverges=cylinder-ray-parallel-to-axis
haxe> emit("cylinder-ray-oblique-axis",[H.ray(H.col([0,0,0],[1,1,1],1),[-3,-3,-3],[1,1,1])]);
ms> emit1("cylinder-ray-oblique-axis",ray(col(vec3(0,0,0),vec3(1,1,1),1.0),vec3(-3,-3,-3),vec3(1,1,1)));

case cylinder-ray-along-axis-from-a tol=1e-5 diverges=cylinder-ray-parallel-to-axis
haxe> emit("cylinder-ray-along-axis-from-a",[H.ray(H.col([0,0,0],[0,0,2],1),[0.5,0,-5],[0,0,1])]);
ms> emit1("cylinder-ray-along-axis-from-a",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0.5,0,-5),vec3(0,0,1)));

case cylinder-ray-along-axis-from-b tol=1e-5 diverges=cylinder-ray-parallel-to-axis
haxe> emit("cylinder-ray-along-axis-from-b",[H.ray(H.col([0,0,0],[0,0,2],1),[0.5,0,5],[0,0,-1])]);
ms> emit1("cylinder-ray-along-axis-from-b",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0.5,0,5),vec3(0,0,-1)));

case cylinder-contains-body tol=0
haxe> emit("cylinder-contains-body",[H.col([0,0,0],[0,0,2],1).contains(new Point(0.9,0,1.9))?1.:0.]);
ms> emit1("cylinder-contains-body",contained(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0.9,0,1.9)));

case cylinder-contains-past-cap tol=0
haxe> emit("cylinder-contains-past-cap",[H.col([0,0,0],[0,0,2],1).contains(new Point(0.9,0,2.1))?1.:0.]);
ms> emit1("cylinder-contains-past-cap",contained(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0.9,0,2.1)));

