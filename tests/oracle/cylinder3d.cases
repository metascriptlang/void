haxe> emit("cylinder-ray-behind",[H.ray(H.col([0,0,0],[0,0,2],1),[5,0,1],[1,0,0])]);
ms> emit1("cylinder-ray-behind",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(5,0,1),vec3(1,0,0)));

