# Rows of the full shaping oracle (docs/TESTING.md T3, "Shaping"). Data only: the expected
# answer is not here. `python tests/oracle/fonts.py regen` shapes each row with HarfBuzz
# (uharfbuzz) into tests/oracle/shapeFull.json, and src/test/shapeOracleCheck.ms shapes the same
# row through the kb_text_shape bridge and compares.
#
# One row per line, fields separated by a tab: id, font, direction (auto, ltr or rtl),
# features, text. Features are `-` for the font's defaults, else space-separated tokens:
# `-tag` turns a feature off, `+tag` on, `tag=N` sets a value. In the text, `\uXXXX` is a
# codepoint, so a combining mark stays visible in review.
#
# A row whose answer kb_text_shape does not give as HarfBuzz does is listed in tests/PENDING.md
# as `shape:<id>`; nothing is dropped from here to make the count prettier.
fixture-liga	tests/fonts/shapeFixture.ttf	auto	-	fi
fixture-liga-in-word	tests/fonts/shapeFixture.ttf	auto	-	fib
fixture-liga-second-f	tests/fonts/shapeFixture.ttf	auto	-	ffi
fixture-liga-off	tests/fonts/shapeFixture.ttf	auto	-liga	fib
fixture-calt	tests/fonts/shapeFixture.ttf	auto	-	ab
fixture-calt-off	tests/fonts/shapeFixture.ttf	auto	-calt	ab
fixture-calt-run	tests/fonts/shapeFixture.ttf	auto	-	aab
fixture-kern	tests/fonts/shapeFixture.ttf	auto	-	AV
fixture-kern-off	tests/fonts/shapeFixture.ttf	auto	-kern	AV
fixture-ccmp-decompose	tests/fonts/shapeFixture.ttf	auto	-	\u00e9
fixture-ccmp-off	tests/fonts/shapeFixture.ttf	auto	-ccmp	\u00e9
fixture-mark-offset	tests/fonts/shapeFixture.ttf	auto	-	e\u0301
fixture-mark-off	tests/fonts/shapeFixture.ttf	auto	-mark	e\u0301
fixture-sentence	tests/fonts/shapeFixture.ttf	auto	-	fib ab AV \u00e9 e\u0301 fi
