# h3d.pass.Blur's kernel (calcValues, getKernelSize) against src/void3d/blur.ms blurKernel.
#
# Same shape as color3d.cases: `sh scripts/oracle.sh regen tests/oracle/blur3d.cases` replays the
# Haxe side through real Heaps. Each case is one tap of one settings row: its weight, its offset,
# the number of weights and the kernel size, with 0 for a tap past the last weight. Heaps keeps
# the offsets of the weights calcValues drops; the program reads only as many as there are weights.
#
# lib: heaps format
# haxe-prelude: class H {
# haxe-prelude: public static function tap(r: Float, g: Float, l: Float, q: Float, i: Int): Array<Float> {
# haxe-prelude: var b = new h3d.pass.Blur(r, g, l, q);
# haxe-prelude: var size = b.getKernelSize();
# haxe-prelude: var v: Array<Float> = @:privateAccess b.values;
# haxe-prelude: var o: Array<Float> = @:privateAccess b.offsets;
# haxe-prelude: return [i < v.length ? v[i] : 0.0, i < v.length ? o[i] : 0.0, v.length, size];
# haxe-prelude: }
# haxe-prelude: }
# ms-prelude: import { BlurSettings, BlurKernel, blurKernel, blurKernelSize } from "../../../src/void3d/blur";
# ms-prelude: function tap(r: float32, g: float32, l: float32, q: float32, i: int32): Vec<float32> {
# ms-prelude: const settings: BlurSettings = { radius: r, gain: g, linear: l, quality: q };
# ms-prelude: const k: BlurKernel = blurKernel(settings);
# ms-prelude: const n: int32 = k.values.length as int32;
# ms-prelude: return [i < n ? k.values[i] : 0.0, i < n ? k.offsets[i] : 0.0, n as float32,
# ms-prelude: blurKernelSize(settings) as float32];
# ms-prelude: }

case default-tap0 tol=1e-6
haxe> emit("default-tap0", H.tap(1.0, 1.0, 0.0, 1.0, 0));
ms> { const t: Vec<float32> = tap(1.0, 1.0, 0.0, 1.0, 0); emit4("default-tap0", t[0], t[1], t[2], t[3]); }

case default-tap1 tol=1e-6
haxe> emit("default-tap1", H.tap(1.0, 1.0, 0.0, 1.0, 1));
ms> { const t: Vec<float32> = tap(1.0, 1.0, 0.0, 1.0, 1); emit4("default-tap1", t[0], t[1], t[2], t[3]); }

