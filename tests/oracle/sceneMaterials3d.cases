# lib: heaps format
# haxe-prelude: import h3d.scene.Object;
# haxe-prelude: import h3d.scene.Mesh;
# haxe-prelude: import h3d.mat.Material;
# haxe-prelude: class H {
# haxe-prelude: public static function order(o: Object,expected: Array<Material>,recursive=true): Float {
# haxe-prelude: var found=o.getMaterials(null,recursive);
# haxe-prelude: if (found.length!=expected.length) return 0;
# haxe-prelude: for (i in 0...expected.length) if (found[i]!=expected[i]) return 0;
# haxe-prelude: return 1;
# haxe-prelude: }
# haxe-prelude: }
# ms-prelude: import { Scene3D,NodeId3D,Transform3D,NO_NODE_ID,
# ms-prelude: addGroup,addMeshNode,setVisible } from "../../../src/void3d/scene";
# ms-prelude: import { MaterialId } from "../../../src/void3d/draw";
# ms-prelude: import { contextOf } from "../../../src/test/drawHelpers";
# ms-prelude: function mesh(scene: Scene3D,parent: NodeId3D,material: int32): NodeId3D {
# ms-prelude: const result=addMeshNode(scene,parent,Transform3D.identity(),
# ms-prelude: scene.context.meshAt(0),scene.context.materialAt(material));
# ms-prelude: return result.ok ? result.value : NO_NODE_ID;
# ms-prelude: }
# ms-prelude: function count(scene: Scene3D,from: NodeId3D,recursive: boolean=true): float32 {
# ms-prelude: const result=scene.getMaterials(from,recursive);
# ms-prelude: return result.ok ? (result.value.length as float32) : -1.0;
# ms-prelude: }
# ms-prelude: function order(scene: Scene3D,from: NodeId3D,
# ms-prelude: expected: Vec<MaterialId>,recursive: boolean=true): float32 {
# ms-prelude: const result=scene.getMaterials(from,recursive); if (!result.ok) { return -1.0; }
# ms-prelude: if (result.value.length!=expected.length) { return 0.0; }
# ms-prelude: for (let i=0;i<(expected.length as int32);i++) {
# ms-prelude: const a=result.value[i]; const b=expected[i];
# ms-prelude: if (a.store!=b.store || a.index!=b.index || a.generation!=b.generation) { return 0.0; }
# ms-prelude: }
# ms-prelude: return 1.0;
# ms-prelude: }

case material-subtree-unique-order tol=0
haxe> var r=new Object(); var ga=new Object(r); var ma=new Mesh(null,null,ga);
haxe> var child=new Mesh(null,null,ma); var mb=new Mesh(null,null,ga);
haxe> var shared=new Mesh(null,ma.material,r);
haxe> emit("material-subtree-unique-order",[r.getMaterials().length,
haxe> H.order(r,[ma.material,child.material,mb.material]),ga.getMaterials().length]);
ms> const context=contextOf(1,3); const scene=Scene3D.create(context); const r=scene.rootId();
ms> const ga=addGroup(scene,r,Transform3D.identity()); const ma=mesh(scene,ga,0);
ms> const child=mesh(scene,ma,2); const mb=mesh(scene,ga,1); const shared=mesh(scene,r,0);
ms> const a=context.materialAt(0); const b=context.materialAt(2); const c=context.materialAt(1);
ms> emit3("material-subtree-unique-order",count(scene,r),order(scene,r,[a,b,c]),count(scene,ga));

case material-subtree-nonrecursive tol=0
haxe> emit("material-subtree-nonrecursive",[r.getMaterials(null,false).length,
haxe> ma.getMaterials(null,false).length,H.order(ma,[ma.material],false)]);
ms> emit3("material-subtree-nonrecursive",count(scene,r,false),count(scene,ma,false),
ms> order(scene,ma,[a],false));

case material-subtree-hidden tol=0
haxe> ga.visible=false; shared.visible=false;
haxe> emit("material-subtree-hidden",[r.getMaterials().length,
haxe> H.order(r,[ma.material,child.material,mb.material]),H.order(ma,[ma.material,child.material])]);
ms> setVisible(scene,ga,false); setVisible(scene,shared,false);
ms> emit3("material-subtree-hidden",count(scene,r),order(scene,r,[a,b,c]),order(scene,ma,[a,b]));

case material-subtree-shared-distinct tol=0
haxe> emit("material-subtree-shared-distinct",[ma.material==shared.material?1:0,
haxe> ma.material!=mb.material?1:0,r.getMaterials().length]);
ms> const sharedMaterial=scene.meshes[scene.nodes[shared.index].payload].material;
ms> emit3("material-subtree-shared-distinct",a.index==sharedMaterial.index?1.0:0.0,
ms> a.index!=c.index?1.0:0.0,count(scene,r));

case material-subtree-detached tol=0
haxe> var detached=new Object(); var dm=new Mesh(null,mb.material,detached);
haxe> emit("material-subtree-detached",[detached.getMaterials().length,
haxe> H.order(detached,[mb.material]),r.getMaterials().length]);
ms> const detached=addGroup(scene,null,Transform3D.identity()); const dm=mesh(scene,detached,1);
ms> emit3("material-subtree-detached",count(scene,detached),order(scene,detached,[c]),count(scene,r));

case material-subtree-empty tol=0
haxe> var empty=new Object();
haxe> emit("material-subtree-empty",[empty.getMaterials().length,H.order(empty,[]),
haxe> empty.getMaterials(null,false).length]);
ms> const empty=addGroup(scene,r,Transform3D.identity());
ms> emit3("material-subtree-empty",count(scene,empty),order(scene,empty,[]),count(scene,empty,false));
