# lib: heaps format
# haxe-prelude: import h3d.col.Frustum;
# haxe-prelude: import h3d.col.Plane;
# haxe-prelude: import h3d.col.OrientedBounds;
# haxe-prelude: class H {
# haxe-prelude: public static function hit(c:Array<Float>,x:Array<Float>,y:Array<Float>,z:Array<Float>,h:Array<Float>,planes:Array<Float>):Float {
# haxe-prelude: var b=new OrientedBounds(); b.centerX=c[0];b.centerY=c[1];b.centerZ=c[2];
# haxe-prelude: b.xx=x[0];b.xy=x[1];b.xz=x[2];b.yx=y[0];b.yy=y[1];b.yz=y[2];b.zx=z[0];b.zy=z[1];b.zz=z[2];b.hx=h[0];b.hy=h[1];b.hz=h[2];
# haxe-prelude: var f=new Frustum();f.pleft=new Plane(1,0,0,planes[0]);f.pright=new Plane(-1,0,0,planes[1]);
# haxe-prelude: f.pbottom=new Plane(0,1,0,planes[2]);f.ptop=new Plane(0,-1,0,planes[3]);
# haxe-prelude: f.pnear=new Plane(0,0,1,planes[4]);f.pfar=new Plane(0,0,-1,planes[5]);return f.hasOrientedBounds(b)?1.:0.;
# haxe-prelude: }
# haxe-prelude: }
# ms-prelude: import { Vec3,Vec4,vec3,vec4 } from "../../../src/math/math3d";
# haxe-prelude: import { Frustum3D,intersectsOrientedBounds } from "../../../src/void3d/frustum";
# ms-prelude: import { OrientedBounds3D } from "../../../src/void3d/orientedBounds";
# ms-prelude: function hit(n:string,c:Vec3,x:Vec3,y:Vec3,z:Vec3,h:Vec3,p:Vec4[]):void {
# ms-prelude: const f:Frustum3D={left:p[0],right:p[1],bottom:p[2],top:p[3],nearPlane:p[4],farPlane:p[5]};
# ms-prelude: const b:OrientedBounds3D={center:c,axisX:x,axisY:y,axisZ:z,halfSize:h};
# ms-prelude: const r=f.intersectsOrientedBounds(b);if(!r.ok){unreachable;}emitB(n,r.value);
# ms-prelude: }

case inside tol=0
haxe> emit("inside",[H.hit([0,0,0],[1,0,0],[0,1,0],[0,0,1],[.25,.25,.25], [1,1,1,1,1,1])]);
ms> hit("inside",vec3(0,0,0),vec3(1,0,0),vec3(0,1,0),vec3(0,0,1),vec3(.25,.25,.25),[vec4(1,0,0,1),vec4(-1,0,0,1),vec4(0,1,0,1),vec4(0,-1,0,1),vec4(0,0,1,1),vec4(0,0,-1,1)]);

case left-out tol=0
haxe> emit("left-out",[H.hit([-2,0,0],[1,0,0],[0,1,0],[0,0,1],[.5,.5,.5], [1,1,1,1,1,1])]);
ms> hit("left-out",vec3(-2,0,0),vec3(1,0,0),vec3(0,1,0),vec3(0,0,1),vec3(.5,.5,.5),[vec4(1,0,0,1),vec4(-1,0,0,1),vec4(0,1,0,1),vec4(0,-1,0,1),vec4(0,0,1,1),vec4(0,0,-1,1)]);

case plane-touch tol=0
haxe> emit("plane-touch",[H.hit([-1.5,0,0],[1,0,0],[0,1,0],[0,0,1],[.5,.5,.5], [1,1,1,1,1,1])]);
ms> hit("plane-touch",vec3(-1.5,0,0),vec3(1,0,0),vec3(0,1,0),vec3(0,0,1),vec3(.5,.5,.5),[vec4(1,0,0,1),vec4(-1,0,0,1),vec4(0,1,0,1),vec4(0,-1,0,1),vec4(0,0,1,1),vec4(0,0,-1,1)]);

case rotated-plane-test tol=0
haxe> emit("rotated-plane-test",[H.hit([1.2,0,0],[.7071067811865476,.7071067811865476,0],[-.7071067811865476,.7071067811865476,0],[0,0,1],[.5,.5,.5], [1,1,1,1,1,1])]);
ms> hit("rotated-plane-test",vec3(1.2,0,0),vec3(.7071067811865476,.7071067811865476,0),vec3(-.7071067811865476,.7071067811865476,0),vec3(0,0,1),vec3(.5,.5,.5),[vec4(1,0,0,1),vec4(-1,0,0,1),vec4(0,1,0,1),vec4(0,-1,0,1),vec4(0,0,1,1),vec4(0,0,-1,1)]);

case distant-parallel-contact tol=0
haxe> emit("distant-parallel-contact",[H.hit([0,0,0],[1,0,0],[0,1,0],[0,0,1],[.5,.5,.5], [100,100,100,100,100,100])]);
ms> hit("distant-parallel-contact",vec3(0,0,0),vec3(1,0,0),vec3(0,1,0),vec3(0,0,1),vec3(.5,.5,.5),[vec4(1,0,0,100),vec4(-1,0,0,100),vec4(0,1,0,100),vec4(0,-1,0,100),vec4(0,0,1,100),vec4(0,0,-1,100)]);

case skew-plane-normal tol=0
haxe> emit("skew-plane-normal",[H.hit([0,0,0],[1,0,0],[0,1,0],[0,0,1],[.5,.5,.5], [1,1,1,1,1,1])]);
ms> hit("skew-plane-normal",vec3(0,0,0),vec3(1,0,0),vec3(0,1,0),vec3(0,0,1),vec3(.5,.5,.5),[vec4(1,1,0,1),vec4(-1,1,0,1),vec4(0,1,1,1),vec4(0,-1,1,1),vec4(0,0,1,1),vec4(0,0,-1,1)]);
