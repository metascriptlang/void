# h3d.col.Polygon and TriPlane (Polygon.hx) and PolygonBuffer.contains / closestPoint
# (PolygonBuffer.hx) against src/void3d/polygonCollider.ms. PolygonBuffer.rayIntersection is
# covered by ray3d.cases against meshData.ms. `regen` replays the Haxe side through real Heaps;
# `check` diffs the port against the snapshot without Haxe.
# lib: heaps format
# haxe-prelude: import h3d.col.Point;
# haxe-prelude: import h3d.col.Ray;
# haxe-prelude: import h3d.col.Polygon;
# haxe-prelude: import h3d.col.Polygon.TriPlane;
# haxe-prelude: import h3d.col.PolygonBuffer;
# haxe-prelude: class H {
# haxe-prelude: static function fv(a:Array<Float>):haxe.ds.Vector<hxd.impl.Float32> {
# haxe-prelude: var v=new haxe.ds.Vector<hxd.impl.Float32>(a.length); for(i in 0...a.length) v[i]=a[i]; return v;
# haxe-prelude: }
# haxe-prelude: public static function poly(o:Bool,p:Array<Float>,i:Array<Int>):Polygon {
# haxe-prelude: var q=new Polygon(o); q.addBuffers(fv(p),haxe.ds.Vector.fromArrayCopy(i)); return q;
# haxe-prelude: }
# haxe-prelude: public static function buf(p:Array<Float>,i:Array<Int>):PolygonBuffer {
# haxe-prelude: var q=new PolygonBuffer(); q.setData(fv(p),haxe.ds.Vector.fromArrayCopy(i)); return q;
# haxe-prelude: }
# haxe-prelude: public static function tri(o:Bool,p:Array<Float>):TriPlane {
# haxe-prelude: var t=new TriPlane(o); t.init(new Point(p[0],p[1],p[2]),new Point(p[3],p[4],p[5]),new Point(p[6],p[7],p[8])); return t;
# haxe-prelude: }
# haxe-prelude: public static function ray(o:Array<Float>,d:Array<Float>):Ray {
# haxe-prelude: return Ray.fromValues(o[0],o[1],o[2],d[0],d[1],d[2]);
# haxe-prelude: }
# haxe-prelude: public static function pt(p:Array<Float>):Point { return new Point(p[0],p[1],p[2]); }
# haxe-prelude: }
# ms-prelude: import { Vec3, vec3 } from "../../../src/math/math3d";
# ms-prelude: import { Ray } from "../../../src/void3d/ray";
# ms-prelude: import {
# ms-prelude: Triangle3D, polygonRayIntersection, polygonContainsConvex, polygonClosestPoint,
# ms-prelude: } from "../../../src/void3d/polygonCollider";
# ms-prelude: function ray(o:Vec3,d:Vec3):Ray { return Ray.fromPoints(o,vec3(o.x+d.x,o.y+d.y,o.z+d.z)); }
# ms-prelude: function tri(p:Vec<float32>):Triangle3D {
# ms-prelude: return {p0:vec3(p[0],p[1],p[2]),p1:vec3(p[3],p[4],p[5]),p2:vec3(p[6],p[7],p[8])};
# ms-prelude: }
# ms-prelude: function triRay(t:Triangle3D,r:Ray,oriented:boolean):float32 {
# ms-prelude: const h=t.rayIntersection(r,oriented); if(!h.ok){unreachable;} return h.value;
# ms-prelude: }
# ms-prelude: function triContains(t:Triangle3D,p:Vec3):float32 {
# ms-prelude: const h=t.containsProjected(p); if(!h.ok){unreachable;} return h.value ? 1.0 : 0.0;
# ms-prelude: }
# ms-prelude: function triClosest(t:Triangle3D,p:Vec3):Vec3 {
# ms-prelude: const h=t.closestPoint(p); if(!h.ok){unreachable;} return h.value;
# ms-prelude: }
# ms-prelude: function soupRay(p:Vec<float32>,i:Vec<uint32>,r:Ray,best:boolean,oriented:boolean):float32 {
# ms-prelude: const h=polygonRayIntersection(p,i,r,best,oriented); if(!h.ok){unreachable;} return h.value;
# ms-prelude: }
# ms-prelude: function soupContains(p:Vec<float32>,i:Vec<uint32>,q:Vec3):float32 {
# ms-prelude: const h=polygonContainsConvex(p,i,q); if(!h.ok){unreachable;} return h.value ? 1.0 : 0.0;
# ms-prelude: }
# ms-prelude: function soupClosest(p:Vec<float32>,i:Vec<uint32>,q:Vec3):Vec3 {
# ms-prelude: const h=polygonClosestPoint(p,i,q); if(!h.ok){unreachable;} return h.value;
# ms-prelude: }
# ms-prelude: function emitTwo(id:string,a:float32,b:float32):void { console.log(`CASE ${id} ${a} ${b}`); }
# ms-prelude: function emitSix(id:string,a:float32,b:float32,c:float32,d:float32,e:float32,f:float32):void {
# ms-prelude: console.log(`CASE ${id} ${a} ${b} ${c} ${d} ${e} ${f}`);
# ms-prelude: }

