haxe> emit("capsule-frustum-trailing-end-outside",[H.frustum(H.col([-3.2,0,0.5],[-1.2,0,0.5],0.1))]);
ms> emit1("capsule-frustum-trailing-end-outside",frustum(col(vec3(-3.2,0,0.5),vec3(-1.2,0,0.5),0.1)));

