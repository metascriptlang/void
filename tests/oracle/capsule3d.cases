haxe> emit("capsule-ray-along-axis-offset-from-a",[H.ray(H.col([0,0,0],[0,0,2],1),[0.5,0,-5],[0,0,1])]);
ms> emit1("capsule-ray-along-axis-offset-from-a",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0.5,0,-5),vec3(0,0,1)));

case capsule-contains-body tol=0
haxe> emit("capsule-contains-body",[H.col([0,0,0],[0,0,2],1).contains(new Point(0.9,0,1))?1.:0.]);
ms> emit1("capsule-contains-body",contained(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0.9,0,1)));

