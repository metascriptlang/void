case capsule-ray-diagonal-axis tol=1e-5 diverges=capsule-ray-parallel-to-axis
haxe> emit("capsule-ray-diagonal-axis",[H.ray(H.col([0,0,0],[1,1,1],1),[-3,-3,-3],[1,1,1])]);
ms> emit1("capsule-ray-diagonal-axis",ray(col(vec3(0,0,0),vec3(1,1,1),1.0),vec3(-3,-3,-3),vec3(1,1,1)));

