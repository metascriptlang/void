haxe> emit("capsule-ray-along-axis-from-b",[H.ray(H.col([0,0,0],[0,0,2],1),[0,0,5],[0,0,-1])]);
ms> emit1("capsule-ray-along-axis-from-b",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0,0,5),vec3(0,0,-1)));

case capsule-ray-along-axis-from-a tol=1e-5 diverges=capsule-ray-parallel-to-axis
haxe> emit("capsule-ray-along-axis-from-a",[H.ray(H.col([0,0,0],[0,0,2],1),[0,0,-5],[0,0,1])]);
ms> emit1("capsule-ray-along-axis-from-a",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(0,0,-5),vec3(0,0,1)));

