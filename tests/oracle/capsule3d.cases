haxe> emit("capsule-ray-cap-b",[H.ray(H.col([0,0,0],[0,0,2],1),[-5,0,2.5],[1,0,0])]);
ms> emit1("capsule-ray-cap-b",ray(col(vec3(0,0,0),vec3(0,0,2),1.0),vec3(-5,0,2.5),vec3(1,0,0)));

