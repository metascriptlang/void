case uv-shared-positive tol=0
haxe> emit("uv-shared-positive",H.sample(2,3));
ms> const positive = scaledUvs(2.0,3.0); if (!positive.ok) { return 1; }
ms> sampleUvs("uv-shared-positive",positive.value);

case uv-shared-signed tol=0
haxe> emit("uv-shared-signed",H.sample(-2,0.5));
ms> const signed = scaledUvs(-2.0,0.5); if (!signed.ok) { return 1; }
ms> sampleUvs("uv-shared-signed",signed.value);

case uv-shared-zero tol=0
haxe> emit("uv-shared-zero",H.sample(0,0));
ms> const zero = scaledUvs(0.0,0.0); if (!zero.ok) { return 1; }
ms> sampleUvs("uv-shared-zero",zero.value);
