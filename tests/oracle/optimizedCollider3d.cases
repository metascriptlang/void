case group-first tol=1e-5
haxe> emit("group-first",[H.gc([[6,0,0,1],[2,0,0,1]]).rayIntersection(H.ray([0,0,0],[1,0,0]),false)]);
ms> emit1("group-first",group(sph(6,0,0,1),sph(2,0,0,1),false,ray(vec3(0,0,0),vec3(1,0,0))));

case group-best tol=1e-5
haxe> emit("group-best",[H.gc([[6,0,0,1],[2,0,0,1]]).rayIntersection(H.ray([0,0,0],[1,0,0]),true)]);
