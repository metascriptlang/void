case opt-dimension tol=1e-6
haxe> emit("opt-dimension",[H.oc(false,[0,0,0,0.5]).dimension()]);
ms> emit1("opt-dimension",bigger(Bounds3D.fromValues(-1,-1,-1,2,2,2).dimension(),sph(0,0,0,0.5).radius));
